#!/usr/bin/env ruby
# Example of an inline subcommand (formerly bin/h-demo): ruby -Ilib examples/h-demo josh a b

require 'hiiro'

Hiiro.run(*ARGV) do
  add_subcommand(:josh) do |*args|
    puts "INSIDE josh subcommand"
    puts "Args"
    args.each do |arg|
      puts "  #{arg}"
    end
  end
end

