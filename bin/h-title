#!/usr/bin/env ruby

require 'hiiro'

Hiiro.run(*ARGV) do
  add_subcmd(:update) do
    pane_id = ENV['HERDR_PANE_ID']
    workspace_id = ENV['HERDR_WORKSPACE_ID']
    next unless pane_id && workspace_id

    herdr = herdr_client
    workspace = herdr.get_workspace(workspace_id)
    next unless workspace

    env = Hiiro::Environment.current
    task = env.all_tasks.find { |candidate| candidate.session_name == workspace.name }
    title = task ? task.name : workspace.name
    system('herdr', 'pane', 'rename', pane_id, title)
  end

  add_subcmd(:setup) do
    puts 'No hook setup is required; Herdr tracks pane and agent titles natively.'
  end
end
