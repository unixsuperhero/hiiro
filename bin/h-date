#!/usr/bin/env ruby

require 'hiiro'
require 'time'

Hiiro.run(*ARGV) do
  add_flag(:ms, short: :m, desc: 'Use milliseconds instead of seconds')
  add_flag(:utc, short: :u, desc: 'Output in UTC')

  # h date to_unix [date-string]  -> unix seconds (or ms with --ms)
  add_cmd(:to_unix, :unix, :ts, opts: %i[ms]) do
    t = Hiiro::TimeInput.parse(@opts.args.join(' '))
    puts @opts.ms ? t.unix_milliseconds : t.unix_seconds
  end

  # h date from_unix <timestamp>  -> human date (auto-detects ms by digit count)
  add_cmd(:from_unix, :parse, opts: %i[ms utc]) do
    raw = @opts.args.first or abort 'usage: h date from_unix <timestamp> [--ms] [--utc]'
    t = Hiiro::TimeInput.parse(raw, ms: @opts.ms ? true : nil)
    t = t.utc if @opts.utc
    puts t.iso8601(3)
  end

  # h date fmt Y-m-d H:M:S  -> strftime with % auto-inserted before each char
  add_cmd(:fmt, :format, :strftime, opts: %i[utc]) do
    fmt = @opts.args.join(' ')
    abort 'usage: h date fmt <strftime-chars-without-percent>' if fmt.empty?
    with_percent = fmt.gsub(/[A-Za-z%]/) { |c| c == '%' ? '%%' : "%#{c}" }
    t = @opts.utc ? Time.now.utc : Time.now
    puts t.strftime(with_percent)
  end

  add_cmd(:now, opts: %i[utc]) do
    t = @opts.utc ? Time.now.utc : Time.now
    puts t.iso8601
  end

  # h date dur <seconds>  -> 1d23h12m10s  (--ms to interpret input as milliseconds)
  add_cmd(:dur, :duration, :human, opts: %i[ms]) do
    raw = @opts.args.first or abort 'usage: h date dur <seconds> [--ms]'
    n = Rational(raw.to_s)
    puts (@opts.ms ? Hiiro::Duration.milliseconds(n) : Hiiro::Duration.seconds(n)).compact
  end

  # h date diff <a> <b>  -> how far apart two dates are (dates or unix timestamps)
  add_cmd(:diff, opts: %i[ms]) do
    a, b = @opts.args
    abort 'usage: h date diff <date-a> <date-b>  (each: date string or unix timestamp)' unless a && b
    ta = Hiiro::TimeInput.parse(a, ms: @opts.ms ? true : nil)
    tb = Hiiro::TimeInput.parse(b, ms: @opts.ms ? true : nil)
    puts ta.difference(tb).compact
  end
end
