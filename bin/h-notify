#!/usr/bin/env ruby

require 'fileutils'
require 'hiiro'
require 'yaml'

TYPE_PRESETS = {
  'success' => { prefix: '[OK]', title: 'Success', sound: 'done' },
  'error' => { prefix: '[ERR]', title: 'Error', sound: 'request' },
  'info' => { prefix: '[INFO]', title: 'Info', sound: 'none' },
  'warning' => { prefix: '[WARN]', title: 'Warning', sound: 'request' },
}.freeze

LOG_FILE = Hiiro::Config.data_path('notify_log.yml')
CLAUDE_SETTINGS = File.join(Dir.home, '.claude', 'settings.json')
CLAUDE_NOTIFICATION_CMD = %q(MSG=$(cat | jq -r '.message // "Needs input"'); h notify push -t info "$MSG")
CLAUDE_STOP_CMD = %q(h notify push -t success 'Work completed')

def read_log
  return [] unless File.exist?(LOG_FILE)

  data = YAML.safe_load(File.read(LOG_FILE))
  return data if data.is_a?(Array)
  return [] unless data.is_a?(Hash)

  data.values.flatten.compact.sort_by { |entry| -(entry['timestamp'] || 0) }
rescue
  []
end

def write_log(data)
  FileUtils.mkdir_p(File.dirname(LOG_FILE))
  File.write(LOG_FILE, data.to_yaml)
end

Hiiro.run(*ARGV, tasks: true) do
  @opts = Hiiro::Options.parse(args) do
    option(:type, short: 't', desc: 'Notification type (success, error, info, warning)', default: 'info')
  end
  @preset = TYPE_PRESETS[@opts.type] || TYPE_PRESETS['info']

  live_panes = -> { herdr_client.panes(all: true) }

  add_subcmd(:push) do
    message = @opts.args.join(' ')
    if message.empty?
      puts 'Usage: h notify push [-t TYPE] "message"'
      next
    end

    pane = herdr_client.current_pane
    entry = {
      'workspace_id' => pane&.workspace_id || ENV['HERDR_WORKSPACE_ID'],
      'tab_id' => pane&.tab_id || ENV['HERDR_TAB_ID'],
      'pane_id' => pane&.id || ENV['HERDR_PANE_ID'],
      'agent' => pane&.agent,
      'timestamp' => Time.now.to_i,
      'message' => message,
      'type' => @opts.type,
    }.compact

    data = read_log
    data.reject! { |existing| entry['pane_id'] && existing['pane_id'] == entry['pane_id'] }
    data.unshift(entry)
    write_log(data)
    herdr_client.notify(@preset[:title], body: message, sound: @preset[:sound])
  end

  add_subcmd(:ls) do
    data = read_log
    live_ids = live_panes.call.ids
    current = data.select { |entry| !entry['pane_id'] || live_ids.include?(entry['pane_id']) }
    removed = data.size - current.size
    write_log(current) if removed.positive?

    if current.empty?
      puts(removed.positive? ? "No notifications (#{removed} stale entries removed)." : 'No notifications.')
      next
    end

    current.each_with_index do |entry, index|
      time = Time.at(entry['timestamp']).strftime('%H:%M:%S')
      prefix = TYPE_PRESETS[entry['type']]&.dig(:prefix) || '[INFO]'
      location = [entry['workspace_id'], entry['tab_id'], entry['pane_id']].compact.join('/')
      actor = entry['agent'] || 'pane'
      puts "%3d) %s [%s] %s: %s (%s)" % [index, prefix, location, actor, entry['message'], time]
    end
  end

  add_subcmd(:prune) do
    data = read_log
    live_ids = live_panes.call.ids
    current = data.select { |entry| !entry['pane_id'] || live_ids.include?(entry['pane_id']) }
    write_log(current)
    puts "Removed #{data.size - current.size} stale notification(s). #{current.size} remaining."
  end

  add_subcmd(:menu) do
    entries = read_log
    if entries.empty?
      puts 'No notifications.'
      next
    end

    mapping = entries.each_with_index.each_with_object({}) do |(entry, index), choices|
      prefix = TYPE_PRESETS[entry['type']]&.dig(:prefix) || '[INFO]'
      choices["#{prefix} #{entry['message']} [#{entry['pane_id'] || 'no pane'}]"] = index
    end
    index = fuzzyfind_from_map(mapping)
    run_subcmd(:jump, index.to_s) if index
  end

  add_subcmd(:jump) do |index_string = nil|
    unless index_string
      puts 'Usage: h notify jump INDEX'
      next
    end

    data = read_log
    index = index_string.to_i
    entry = data[index]
    next unless entry

    herdr_client.focus_workspace(entry['workspace_id']) if entry['workspace_id']
    herdr_client.focus_tab(entry['tab_id']) if entry['tab_id']
    data.delete_at(index)
    write_log(data)
  end

  add_subcmd(:clear) { write_log([]) }

  add_subcmd(:remove_pane) do |pane_id = nil|
    next unless pane_id
    write_log(read_log.reject { |entry| entry['pane_id'] == pane_id })
  end

  add_subcmd(:remove_window, :remove_tab) do |tab_id = nil|
    next unless tab_id
    write_log(read_log.reject { |entry| entry['tab_id'] == tab_id })
  end

  add_subcmd(:remove_session, :remove_workspace) do |workspace_id = nil|
    next unless workspace_id
    write_log(read_log.reject { |entry| entry['workspace_id'] == workspace_id })
  end

  add_subcmd(:herdr) do
    run_child(:herdr) do |child|
      child.add_subcmd(:setup) do
        puts 'No hooks are required. Hiiro uses Herdr notifications and live pane IDs directly.'
      end
    end
  end

  add_subcmd(:claude) do
    require 'json'

    read_settings = lambda do
      File.exist?(CLAUDE_SETTINGS) ? JSON.parse(File.read(CLAUDE_SETTINGS)) : {}
    rescue JSON::ParserError
      {}
    end
    write_settings = ->(settings) { File.write(CLAUDE_SETTINGS, JSON.pretty_generate(settings)) }

    run_child(:claude) do |child|
      child.add_subcmd(:setup, :add_hooks) do
        settings = read_settings.call
        settings['hooks'] ||= {}
        settings['hooks']['Notification'] = [{ 'hooks' => [{ 'type' => 'command', 'command' => CLAUDE_NOTIFICATION_CMD }] }]
        settings['hooks']['Stop'] = [{ 'hooks' => [{ 'type' => 'command', 'command' => CLAUDE_STOP_CMD }] }]
        write_settings.call(settings)
        puts "Updated #{CLAUDE_SETTINGS} with Herdr-backed Hiiro notifications"
      end

      child.add_subcmd(:reset_hooks) do
        unless File.exist?(CLAUDE_SETTINGS)
          puts "#{CLAUDE_SETTINGS} not found"
          next
        end

        settings = read_settings.call
        %w[Notification Stop].each do |event|
          hooks = settings.dig('hooks', event, 0, 'hooks') || []
          hooks.reject! { |hook| hook['command']&.include?('h notify push') }
        end
        write_settings.call(settings)
      end

      child.add_subcmd(:load_hooks) do
        puts 'Claude Code loads hook settings on startup; restart it to pick up changes.'
      end
    end
  end
end
