#!/usr/bin/env ruby

require "hiiro"

Hiiro.run(*ARGV) do
  add_subcmd(:edit) { edit_files(__FILE__) }

  # Extra args go to git log after its defaults.
  add_subcmd(:select, :sk) { |*select_args|
    commits = Hiiro::CommitLog.read('-n', '50',*select_args)

    if commits.empty?
      puts "No commits found"
      next
    end

    chosen = Hiiro::CommitLog.choose(commits, decorate: true, hiiro: self)
    puts chosen.short if chosen
  }

  add_default {
    puts "Usage: h commit <subcommand> [args]"
    puts
    puts "Subcommands:"
    puts "  select, sk  Select a commit using the picker and print its SHA"
    puts "              Additional args are passed to git log"
  }
end
