#!/usr/bin/env ruby

require 'hiiro'

# sed -n '/scripts.*[{]/,/[}]/p' package.json

Hiiro.run do
  add_cmd :pkg do
    file, *_other = Dir.glob('package.json')

    if file
      print file
    end
  end

  add_cmd :scripts do
    file, *_other = Dir.glob('package.json')

    if file
      system('jq', '.scripts', file)
    end
  end

  add_cmd :all do
    require 'fileutils'

    tool_cmds = [
      %w[yarn fmt],
      %w[yarn typecheck],
      %w[yarn test],
      %w[yarn build],
    ]

    tool_results = tool_cmds.map do |cmd|
      puts "\n==> #{cmd.join(' ')}"
      [cmd, Hiiro::Shell.stream_combined(*cmd)]
    end

    all_passed = tool_results.all? { |_, r| r.success? }

    failed = tool_results.reject { |_, r| r.success? }
    unless failed.empty?
      log_dir = File.expand_path('~/notes/files')
      FileUtils.mkdir_p(log_dir)
      ts = Time.now.strftime('%Y%m%d%H%M%S')

      puts "\n--- failed ---"
      failed.each do |cmd, result|
        slug = cmd.join('-').gsub(/[^a-zA-Z0-9]/, '-')
        log_path = File.join(log_dir, "h-js-all-#{ts}-#{slug}.log")
        File.write(log_path, result.stdout)
        puts log_path
      end
    end
  end
end
