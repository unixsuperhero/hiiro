#!/usr/bin/env ruby

require 'hiiro'
require 'fileutils'

# Herdr plugin glue for the t task CLI. The plugin manifest lives in the gem's
# herdr-plugin/ directory; `h herdr install` copies it to ~/.config/hiiro/herdr-plugin
# and links it with `herdr plugin link`. Actions run headless behind keybindings and
# open the plugin popup; `h herdr popup` runs inside that popup with a real TTY.

PLUGIN_ID = 'hiiro'
ACTIONS = %w[switch todo-add todos shell nvim].freeze
PANE_DIRECTIONS = {
  'h' => 'left',
  'j' => 'down',
  'k' => 'up',
  'l' => 'right',
  'left' => 'left',
  'down' => 'down',
  'up' => 'up',
  'right' => 'right',
}.freeze
INSTALL_DIR = Hiiro::Config.config_dir('herdr-plugin')
SOURCE_DIR = File.expand_path('../herdr-plugin', File.dirname(File.realpath(__FILE__)))
KEYS_SNIPPET = <<~TOML
  # Hiiro task actions (h herdr keys)
  [[keys.command]]
  key = "prefix+t"
  type = "plugin_action"
  command = "hiiro.switch"
  description = "switch to task"

  [[keys.command]]
  key = "prefix+shift+a"
  type = "plugin_action"
  command = "hiiro.todo-add"
  description = "add todo"

  [[keys.command]]
  key = "prefix+shift+y"
  type = "plugin_action"
  command = "hiiro.todos"
  description = "copy a todo"

  [[keys.command]]
  key = "prefix+shift+s"
  type = "plugin_action"
  command = "hiiro.shell"
  description = "task shell popup"

  [[keys.command]]
  key = "prefix+shift+e"
  type = "plugin_action"
  command = "hiiro.nvim"
  description = "task notes in nvim"

  # Vim-style pane layout controls. Herdr already uses prefix+h/j/k/l for focus.
  # Uppercase rotates a two-pane tab so the current pane lands on that edge.
  [[keys.command]]
  key = "prefix+shift+h"
  type = "shell"
  command = "h herdr move left"
  description = "move current pane to the left"

  [[keys.command]]
  key = "prefix+shift+j"
  type = "shell"
  command = "h herdr move down"
  description = "move current pane to the bottom"

  [[keys.command]]
  key = "prefix+shift+k"
  type = "shell"
  command = "h herdr move up"
  description = "move current pane to the top"

  [[keys.command]]
  key = "prefix+shift+l"
  type = "shell"
  command = "h herdr move right"
  description = "move current pane to the right"

  [[keys.command]]
  key = "prefix+alt+h"
  type = "shell"
  command = "h herdr resize left"
  description = "resize current pane left"

  [[keys.command]]
  key = "prefix+alt+j"
  type = "shell"
  command = "h herdr resize down"
  description = "resize current pane down"

  [[keys.command]]
  key = "prefix+alt+k"
  type = "shell"
  command = "h herdr resize up"
  description = "resize current pane up"

  [[keys.command]]
  key = "prefix+alt+l"
  type = "shell"
  command = "h herdr resize right"
  description = "resize current pane right"
TOML

def herdr_bin
  ENV['HERDR_BIN_PATH'] || 'herdr'
end

def source_dir
  return SOURCE_DIR if File.exist?(File.join(SOURCE_DIR, 'herdr-plugin.toml'))
  gem_root = Gem.loaded_specs['hiiro']&.full_gem_path
  gem_root && File.join(gem_root, 'herdr-plugin')
end

def pane_direction!(value)
  PANE_DIRECTIONS.fetch(value.to_s) do
    raise Hiiro::Error, 'Direction must be h, j, k, l, left, down, up, or right'
  end
end

def pane_ratio!(value)
  return nil if value.nil?
  ratio = Float(value, exception: false)
  raise Hiiro::Error, 'Ratio must be greater than 0 and less than 1' unless ratio && ratio.positive? && ratio < 1
  ratio
end

def move_current_pane(direction, ratio = nil)
  current = herdr_client.current_pane
  raise Hiiro::Error, 'No current Herdr pane' unless current
  panes = herdr_client.panes(workspace: current.workspace_id).select { |pane| pane.tab_id == current.tab_id }
  raise Hiiro::Error, "Move requires exactly two panes in the current tab; found #{panes.length}" unless panes.length == 2
  other = panes.find { |pane| pane.id != current.id }

  if %w[left up].include?(direction)
    source, target = other, current
    split = direction == 'left' ? 'right' : 'down'
    move_ratio = ratio && 1.0 - ratio
    focus = '--no-focus'
  else
    source, target = current, other
    split = direction
    move_ratio = ratio
    focus = '--focus'
  end

  detached = system(herdr_bin, 'pane', 'move', source.id, '--new-tab', '--no-focus')
  raise Hiiro::Error, 'Herdr could not detach the pane for reflow' unless detached
  args = ['pane', 'move', source.id, '--tab', target.tab_id, '--target-pane', target.id, '--split', split]
  args += ['--ratio', move_ratio.to_s] if move_ratio
  raise Hiiro::Error, 'Herdr could not reflow the pane' unless system(herdr_bin, *args, focus)
end

Hiiro.run(*ARGV, external_commands: false) do
  add_cmd(:install) do
    no_args = opts.args.empty?
    raise Hiiro::Error, 'h herdr install takes no arguments' unless no_args
    src = source_dir
    raise Hiiro::Error, 'Plugin manifest not found; reinstall the hiiro gem' unless src
    FileUtils.mkdir_p(File.dirname(INSTALL_DIR))
    FileUtils.rm_rf(INSTALL_DIR)
    FileUtils.cp_r(src, INSTALL_DIR)
    puts "Copied plugin to #{INSTALL_DIR}"
    linked = system(herdr_bin, 'plugin', 'link', INSTALL_DIR)
    puts(linked ? 'Linked plugin "hiiro" in Herdr' : 'Plugin already linked or link failed; run: herdr plugin list')
    puts "\nAdd keybindings to ~/.config/herdr/config.toml (h herdr keys prints them), then run:"
    puts '  herdr server reload-config'
  end

  add_cmd(:uninstall) do
    system(herdr_bin, 'plugin', 'unlink', PLUGIN_ID)
    FileUtils.rm_rf(INSTALL_DIR)
    puts "Removed #{INSTALL_DIR}"
  end

  add_cmd(:keys) { puts KEYS_SNIPPET }

  add_cmd(:actions) { ACTIONS.each { |name| puts "hiiro.#{name}" } }

  add_cmd(:focus, args: %i[direction]) do
    direction = pane_direction!(opts.args.first)
    raise Hiiro::Error, 'Herdr could not focus the pane' unless system(herdr_bin, 'pane', 'focus', '--current', '--direction', direction)
  end

  add_cmd(:resize, args: %i[direction amount?]) do
    direction = pane_direction!(opts.args.shift)
    amount = opts.args.shift
    args = ['pane', 'resize', '--current', '--direction', direction]
    args += ['--amount', amount] if amount
    raise Hiiro::Error, 'Herdr could not resize the pane' unless system(herdr_bin, *args)
  end

  add_cmd(:swap, args: %i[direction]) do
    direction = pane_direction!(opts.args.first)
    raise Hiiro::Error, 'Herdr could not swap the pane' unless system(herdr_bin, 'pane', 'swap', '--current', '--direction', direction)
  end

  add_cmd(:move, :layout, :arrange, args: %i[direction ratio?]) do
    move_current_pane(pane_direction!(opts.args.shift), pane_ratio!(opts.args.shift))
  end

  add_cmd(:zoom) do
    raise Hiiro::Error, 'h herdr zoom takes no arguments' unless opts.args.empty?
    raise Hiiro::Error, 'Herdr could not zoom the pane' unless system(herdr_bin, 'pane', 'zoom', '--current', '--toggle')
  end

  # Headless: bound to a key, opens the popup with the chosen action.
  add_cmd(:action, args: %i[name]) do
    name = opts.args.first
    raise Hiiro::Error, "Unknown action #{name}; one of #{ACTIONS.join(', ')}" unless ACTIONS.include?(name)
    size = %w[shell nvim].include?(name) ? %w[--width 90% --height 90%] : []
    extra = []
    if name == 'nvim' && (cwd = calling_pane_cwd)
      extra = ['--cwd', cwd, '--env', "HIIRO_HERDR_CWD=#{cwd}"]
    end
    system(herdr_bin, 'plugin', 'pane', 'open', '--plugin', PLUGIN_ID, '--entrypoint', 'popup',
           '--env', "HIIRO_HERDR_ACTION=#{name}", *size, *extra, '--focus')
  end

  # Working directory of the pane the key was pressed in (HERDR_PANE_ID, else the focused pane).
  def calling_pane_cwd
    pane = ENV['HERDR_PANE_ID'] ? herdr_client.get_pane(ENV['HERDR_PANE_ID']) : herdr_client.panes(all: true).find(&:focused?)
    pane && (pane.foreground_cwd || pane.cwd)
  rescue StandardError
    nil
  end

  # Runs inside the popup pane (real TTY, HERDR_WORKSPACE_ID set by Herdr).
  add_cmd(:popup) do
    name = ENV['HIIRO_HERDR_ACTION'] || opts.args.first
    raise Hiiro::Error, "Set HIIRO_HERDR_ACTION to one of #{ACTIONS.join(', ')}" unless ACTIONS.include?(name)
    run_popup(name)
  end

  def tasks
    Hiiro::TaskRecord.all_as_list.reject { |task| %w[done archived].include?(task.task_status) }
  end

  def current_task_name
    Hiiro::CurrentTask.new(herdr: -> { herdr_client }, pin: true).resolve&.name
  end

  def pick_task(prompt_current: true)
    current = prompt_current && current_task_name
    names = tasks.map(&:name)
    names = [current, *names.reject { |n| n == current }] if current
    raise Hiiro::Error, 'No tasks; create one with t NAME new' if names.empty?
    choice = fuzzyfind(names)
    raise Hiiro::Error, 'No task selected' if choice.nil? || choice.strip.empty?
    choice.strip
  end

  def pause(message)
    $stderr.puts message
    sleep 2
  end

  def run_popup(name)
    case name
    when 'switch'
      task = pick_task(prompt_current: false)
      system('t', 'switch', task) || pause("t switch #{task} failed")
    when 'todo-add'
      task = pick_task
      print "Todo for #{task}: "
      text = $stdin.gets.to_s.strip
      raise Hiiro::Error, 'No todo text' if text.empty?
      system('t', 'todo', 'add', '-t', task, text) || pause('todo add failed')
      sleep 1
    when 'todos'
      task = current_task_name || pick_task
      items = Hiiro::TodoItem.where(task_name: task, subtask_name: nil).exclude(status: %w[done skip]).order(:id).all
      raise Hiiro::Error, "No open todos for #{task}" if items.empty?
      text = fuzzyfind_from_map(items.to_h { |item| ["#{item.id}  #{item.text}", item.text] })
      raise Hiiro::Error, 'No todo selected' unless text
      Hiiro::Shell.pipe(text, 'pbcopy')
      puts "Copied: #{text}"
      sleep 1
    when 'shell'
      exec('t', 'sh')
    when 'nvim'
      cwd = ENV['HIIRO_HERDR_CWD']
      Dir.chdir(cwd) if cwd && Dir.exist?(cwd)
      exec(ENV['EDITOR'] || 'nvim')
    end
  rescue Hiiro::Error => e
    pause("ERROR: #{e.message}")
    exit 1
  end
end
