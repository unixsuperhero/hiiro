#!/usr/bin/env ruby
# frozen_string_literal: true

# Local MCP registry, SDK commands, and HTTP-only legacy client sync.
require 'hiiro/mcp'

Hiiro.run(*ARGV) do
  %w[ls list info add import remove configured discover saved tools tool call guide test url].each do |command|
    add_subcmd(command.to_sym) { |*args| MCPCommands.run(command, args) }
  end

  add_subcmd(:sync) { |*args| MCPSync.sync(args) }
  add_subcmd(:status) { |*args| MCPSync.status(args) }
  add_subcmd(:agents) { MCPSync.agents }
end
