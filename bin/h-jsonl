end

def extract_messages(records)
  messages = []
  current_msg_id = nil
  current_msg = nil

  records.each do |record|
    next if !record.is_a?(Hash)

    rec_type = record['type']
    next unless ['user', 'assistant'].include?(rec_type)

    message = record['message'] || {}
    next unless message.is_a?(Hash)

    msg_id = message['id']

    if rec_type == 'assistant' && msg_id && msg_id == current_msg_id
      new_content = message['content'] || []
      if current_msg && new_content.any?
        existing_types = {}
        current_msg['content'].each_with_index do |c, i|
          next unless c.is_a?(Hash)
          key = [c['type'], c['id'] || c['tool_use_id'] || '']
          existing_types[key] = i
        end

        new_content.each do |block|
          next unless block.is_a?(Hash)
          block_key = [block['type'], block['id'] || block['tool_use_id'] || '']
          if existing_types[block_key] && ['text', 'thinking'].include?(block['type'])
            idx = existing_types[block_key]
            current_msg['content'][idx]['text'] = block['text'] if block['type'] == 'text'
            current_msg['content'][idx]['thinking'] = block['thinking'] if block['type'] == 'thinking'
          elsif !existing_types[block_key]
            current_msg['content'] << block
            existing_types[block_key] = current_msg['content'].length - 1
          end
        end
      end
      next
    end

    messages << current_msg if current_msg
    current_msg = {
      'type' => rec_type,
      'role' => message['role'] || rec_type,
      'content' => message['content'] || [],
      'timestamp' => record['timestamp'],
      'cwd' => record['cwd'],
      'gitBranch' => record['gitBranch'],
      'model' => message['model'],
      'uuid' => record['uuid'],
    }
    current_msg_id = rec_type == 'assistant' ? msg_id : nil
  end

  messages << current_msg if current_msg
  messages
end

def extract_session_info(records)
  info = {
    'sessionId' => '',
    'slug' => '',
    'startTime' => nil,
    'cwd' => '',
    'gitBranch' => '',
  }

  records.each do |record|
    info['sessionId'] = record['sessionId'] if record['sessionId'] && info['sessionId'].empty?
    info['slug'] = record['slug'] if record['slug'] && info['slug'].empty?
    info['startTime'] = record['timestamp'] if record['timestamp'] && !info['startTime']
    info['cwd'] = record['cwd'] if record['cwd'] && info['cwd'].empty?
    info['gitBranch'] = record['gitBranch'] if record['gitBranch'] && info['gitBranch'].empty?
  end

  info
end

def content_to_html(content)
  parts = []

  return "<div class=\"message-text\">#{escape_html(content)}</div>" if content.is_a?(String)

  return '' unless content.is_a?(Array)

  content.each do |block|
    next unless block.is_a?(Hash)

    case block['type']
    when 'text'
      text = block['text'] || ''
      parts << "<div class=\"message-text\">#{escape_html(text)}</div>" if text.strip.length > 0
    when 'tool_use'
      tool_name = block['name'] || 'Unknown'
      tool_input = block['input'] || {}
      summary = extract_tool_summary(tool_input, tool_name)
      display_name = get_tool_display_name(tool_name)

      input_json = JSON.pretty_generate(tool_input)
      escaped_json = escape_html(input_json)
      escaped_summary = escape_html(summary)

      parts << %{
        <div class="tool-use">
            <div class="tool-header">
                <span class="tool-icon">🔧</span>
                <span class="tool-name">#{display_name}</span>
                <code class="tool-summary">#{escaped_summary}</code>
            </div>
            <details class="tool-input-details">
                <summary>View Input</summary>
                <pre class="tool-input"><code>#{escaped_json}</code></pre>
            </details>
        </div>
      }
    when 'tool_result'
      content_val = block['content'] || ''
      is_error = block['is_error'] || false

      result_text = content_val.is_a?(String) ? content_val : JSON.pretty_generate(content_val)
      result_text = result_text[0...5000] + '\n... [truncated]' if result_text.length > 5000

      escaped_result = escape_html(result_text)
      error_class = is_error ? 'error' : ''
      icon = is_error ? '❌ Error' : '📄 Result'

      parts << %{
        <div class="tool-result #{error_class}">
            <details open>
                <summary>#{icon} (#{result_text.length} chars)</summary>
                <pre class="result-content"><code>#{escaped_result}</code></pre>
            </details>
        </div>
      }
    end
  end

  parts.join("\n")
end

def escape_html(text)
  text.to_s
    .gsub('&', '&amp;')
    .gsub('<', '&lt;')
    .gsub('>', '&gt;')
    .gsub('"', '&quot;')
    .gsub("'", '&#39;')
end

o.add_subcmd(:export) { |file_path, *args|
  unless file_path
    puts "Usage: h jsonl export <file.jsonl> [--output-dir <dir>] [--name <name>]"
    next
  end

  output_dir = '.'
  name = nil

  i = 0
  while i < args.length
    case args[i]
    when '--output-dir', '-o'
      output_dir = args[i + 1]
      i += 2
    when '--name', '-n'
      name = args[i + 1]
      i += 2
    else
      i += 1
    end
  end

  file_path = File.expand_path(file_path)
  unless File.exist?(file_path)
    puts "Error: File not found: #{file_path}"
    next
  end

  puts "Reading JSONL file: #{file_path}"
  records = parse_jsonl(file_path)
  puts "  Found #{records.length} records"

  output_dir = File.expand_path(output_dir)
  FileUtils.mkdir_p(output_dir)

  base_name = name || File.basename(file_path, '.jsonl') || 'export'

  html_path = File.join(output_dir, "#{base_name}.html")
  generate_html(records, html_path)
}

o.add_subcmd(:stats) { |file_path, *args|
  unless file_path
    puts "Usage: h jsonl stats <file.jsonl>"
    next
  end

  file_path = File.expand_path(file_path)
  unless File.exist?(file_path)
    puts "Error: File not found: #{file_path}"
    next
  end

  records = parse_jsonl(file_path)
  messages = extract_messages(records)

  puts
  puts "📊 JSONL Statistics: #{File.basename(file_path)}"
  puts "─" * 50
  puts "Total records:      #{records.length}"
  puts "Messages:           #{messages.length}"

  user_msgs = messages.select { |m| m['role'] == 'user' }.length
  assistant_msgs = messages.select { |m| m['role'] == 'assistant' }.length
  puts "  User messages:    #{user_msgs}"
  puts "  Assistant msgs:   #{assistant_msgs}"

  tool_uses = messages.flat_map { |m| m['content'] || [] }.select { |c| c.is_a?(Hash) && c['type'] == 'tool_use' }
  puts "Tool uses:          #{tool_uses.length}"

  if tool_uses.any?
    tool_names = tool_uses.map { |t| t['name'] }.compact.group_by { |n| n }.map { |n, g| "#{n}(#{g.length})" }
    puts "  Tools:            #{tool_names.join(', ')}"
  end

  total_size = File.size(file_path)
  puts "File size:          #{(total_size / 1024.0).round(2)} KB"
  puts
}

o.add_subcmd(:head) { |file_path, *args|
  unless file_path
    puts "Usage: h jsonl head <file.jsonl> [-n <lines>]"
    next
  end

  lines = 10
  i = 0
  while i < args.length
    case args[i]
    when '-n'
      lines = args[i + 1].to_i
      i += 2
    else
      i += 1
    end
  end

  file_path = File.expand_path(file_path)
  unless File.exist?(file_path)
    puts "Error: File not found: #{file_path}"
    next
  end

  line_count = 0

  File.foreach(file_path) do |line|
    break if line_count >= lines
    line.strip!
    next if line.empty?

    begin
      obj = JSON.parse(line)
      puts JSON.pretty_generate(obj)
      puts "─" * 60
    rescue JSON::ParserError => e
      puts "ERROR parsing line: #{e.message}"
    end

    line_count += 1
  end
}

o.add_subcmd(:grep) { |pattern, file_path, *args|
  unless pattern && file_path
    puts "Usage: h jsonl grep <pattern> <file.jsonl>"
    next
  end

  file_path = File.expand_path(file_path)
  unless File.exist?(file_path)
    puts "Error: File not found: #{file_path}"
    next
  end

  regex = Regexp.new(pattern, Regexp::IGNORECASE)
  matches = 0

  File.foreach(file_path).with_index do |line, idx|
    line.strip!
    next if line.empty?

    begin
      obj = JSON.parse(line)
      json_str = JSON.generate(obj)
      if json_str.match?(regex)
        matches += 1
        puts "Line #{idx + 1}:"
        puts JSON.pretty_generate(obj)
        puts "─" * 60
      end
    rescue JSON::ParserError
      # skip malformed
    end
  end

  puts "Found #{matches} matching records" if matches == 0
}

o.add_subcmd(:validate) { |file_path, *args|
  unless file_path
    puts "Usage: h jsonl validate <file.jsonl>"
    next
  end

  file_path = File.expand_path(file_path)
  unless File.exist?(file_path)
    puts "Error: File not found: #{file_path}"
    next
  end

  valid_count = 0
  error_count = 0

  File.foreach(file_path).with_index do |line, idx|
    line.strip!
    next if line.empty?

    begin
      JSON.parse(line)
      valid_count += 1
    rescue JSON::ParserError => e
      error_count += 1
      puts "Line #{idx + 1}: #{e.message}"
    end
  end

  puts
  puts "✓ Valid lines:   #{valid_count}"
  puts "✗ Error lines:   #{error_count}"
  puts "Total:           #{valid_count + error_count}"

  if error_count == 0
    puts "✓ File is valid!"
  end
}

if o.runnable?
  o.run
else
  puts format('ERROR: %s', :no_runnable_found)
  puts
  o.help
end
