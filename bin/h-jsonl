#!/usr/bin/env ruby

require 'json'
require 'fileutils'
require 'time'
require 'hiiro'

o = Hiiro.init(*ARGV, plugins: [Tmux, Pins, Project])

def parse_jsonl(file_path)
  records = []
  line_num = 0

  File.readlines(file_path).each do |line|
    line_num += 1
    line = line.chomp.strip
    next if line.empty?

    begin
      record = JSON.parse(line)
      records << record
    rescue JSON::ParserError => e
      warn "Warning: Skipping malformed JSON on line #{line_num}: #{e.message}"
    end
  end

  records
end

def format_timestamp(ts)
  return '' unless ts
  begin
    time = Time.iso8601(ts)
    time.strftime('%Y-%m-%d %H:%M:%S')
  rescue
    ts
  end
end

def truncate_text(text, max_len = 500)
  if text.length <= max_len
    [text, false]
  else
    [text[0...max_len] + '...', true]
  end
end

def get_tool_display_name(name)
  display_names = {
    'Read' => 'Read File',
    'Write' => 'Write File',
    'Edit' => 'Edit File',
    'Bash' => 'Terminal',
    'Glob' => 'Find Files',
    'Grep' => 'Search',
    'Agent' => 'Subagent',
    'WebFetch' => 'Fetch URL',
    'WebSearch' => 'Web Search',
  }
  display_names[name] || name
end

def extract_tool_summary(tool_input, tool_name)
  case tool_name
  when 'Read', 'Write', 'Edit'
    tool_input['file_path'] || ''
  when 'Bash'
    cmd = tool_input['command'] || ''
    cmd.length > 100 ? cmd[0...100] + '...' : cmd
  when 'Glob'
    tool_input['pattern'] || ''
  when 'Grep'
    "/#{tool_input['pattern'] || ''}/"
  when 'Agent'
    (tool_input['description'] || '')[0...50]
  when 'WebFetch'
    tool_input['url'] || ''
  else
    tool_input.to_s[0...50]
  end
end

def generate_html(records, output_path)
  messages = extract_messages(records)
  session_info = extract_session_info(records)

  slug = session_info['slug'] || 'JSONL Export'
  session_id = session_info['sessionId'] || 'N/A'
  start_time = format_timestamp(session_info['startTime'])

  message_html = messages.map.with_index do |msg, i|
    role = msg['role'] || msg['type'] || 'unknown'
    content = msg['content'] || []
    timestamp = format_timestamp(msg['timestamp'])

    next '' if content.empty?

    content_html = content_to_html(content)
    role_class = role == 'user' ? 'user' : 'assistant'
    role_icon = role == 'user' ? '👤' : '🤖'
    role_label = role == 'user' ? 'User' : 'Claude'

    if msg['model']
      if msg['model'].downcase.include?('opus')
        role_label += ' (Opus)'
      elsif msg['model'].downcase.include?('sonnet')
        role_label += ' (Sonnet)'
      elsif msg['model'].downcase.include?('haiku')
        role_label += ' (Haiku)'
      end
    end

    %{
        <div class="message #{role_class}">
            <div class="message-header">
                <span class="role-icon">#{role_icon}</span>
                <span class="role-label">#{role_label}</span>
                <span class="timestamp">#{timestamp}</span>
            </div>
            <div class="message-content">
                #{content_html}
            </div>
        </div>
    }
  end.join("\n")

  html_content = %{<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JSONL Export: #{slug}</title>
