#!/usr/bin/env ruby

require 'hiiro'

Hiiro.run(*ARGV) do
  %w[add once every].each do |action|
    add_subcmd(action.to_sym) do |message = nil, time_arg = nil, sound = nil, *args|
      if message.nil?
        if action == 'add'
          puts 'Saved reminders.' if Hiiro::Reminder.edit(hiiro: self)
        else
          puts "Usage: h remind #{action} 'message' <time> [sound]"
        end
        next
      end

      if action == 'every'
        once, trigger_at, interval = false, nil, time_arg || '1h'
      else
        once, trigger_at, interval = Hiiro::Reminder.parse_time_arg(time_arg)
        if action == 'once'
          once = true
          trigger_at ||= (Time.now + (Hiiro::Duration.parse(time_arg || '1h')&.seconds || 3600)).iso8601
        end
      end
      row = Hiiro::Reminder.add(message: message, interval: interval, sound: sound, once: once, trigger_at: trigger_at)
      schedule = row.one_time? ? "at #{Hiiro::TimeInput.parse(row.trigger_at).strftime('%Y-%m-%d %H:%M')}" : "every #{row.interval || '1h'}"
      puts "Saved #{row.one_time? ? 'one-time' : 'recurring'} reminder ##{row.id}: #{row.message} (#{schedule})"
    end
  end

  add_subcmd(:ls, :list) do |*args|
    rows = Hiiro::Reminder.order(:id).all
    if rows.empty?
      puts 'No reminders saved.'
    else
      rows.each { |row| puts row.display_string }
    end
  end

  %w[remove pause resume].each do |action|
    add_subcmd(action.to_sym) do |ref = nil, *args|
      if ref
        row = Hiiro::Reminder[ref.to_i] if ref.match?(/\A[1-9]\d*\z/)
      else
        rows = Hiiro::Reminder.order(:id).all
        rows.select!(&:enabled) if action == 'pause'
        rows.reject!(&:enabled) if action == 'resume'
        if rows.empty?
          puts "No reminders to #{action}."
          next
        end
        choices = rows.to_h { |candidate| [candidate.display_string, candidate.id] }
        id = fuzzyfind_from_map(choices)
        row = Hiiro::Reminder[id] if id
      end
      unless row
        puts 'Reminder not found'
        next
      end
      changed = if action == 'remove'
        Hiiro::Reminder.remove(row.id)
      else
        Hiiro::Reminder.set_enabled(row.id, action == 'resume')
      end
      puts(changed ? "#{ { 'remove' => 'Removed', 'pause' => 'Paused', 'resume' => 'Resumed' }.fetch(action)} reminder: #{changed.message}" : 'Reminder not found')
    end
  end

  add_subcmd(:check) do |*args|
    deliver = lambda do |row|
      notification_args = ['-m', row.message, '-t', 'Reminder']
      notification_args += ['-s', row.sound] if row.sound
      Hiiro::Notification.deliver(notification_args)
    end
    attempts = Hiiro::Reminder.check_due(deliver: deliver)
    triggered = attempts.select { |_row, outcome| outcome.completed? }
    failed = attempts.select { |_row, outcome| outcome.outcome == 'failed' }
    if args.include?('-v') || args.include?('--verbose')
      attempts.each do |row, outcome|
        case outcome.outcome
        when 'completed' then puts "Triggered#{row.one_time? ? ' (one-time)' : ''}: #{row.message}"
        when 'failed' then puts "Delivery failed (#{outcome.run_id}): #{row.message}"
        else puts "Skipped (#{outcome.detail}): #{row.message}"
        end
      end
      puts "Checked #{Hiiro::Reminder.active.count} enabled reminders, triggered #{triggered.length}"
      completed = Hiiro::Reminder.where(once: true, enabled: false).count
      puts "#{completed} completed one-time reminder(s) (use 'h remind clean' to remove)" if completed.positive?
    end
    failed.each { |row, _outcome| warn "Reminder ##{row.id} not delivered: notification failed; it stays due" }
    exit 1 unless failed.empty?
  end

  add_subcmd(:clean) do |*args|
    removed = Hiiro::Reminder.clean
    puts(removed.positive? ? "Removed #{removed} completed one-time reminder(s)" : 'No completed one-time reminders to clean up')
  end

  add_subcmd(:editall) do |*args|
    puts 'Saved reminders.' if Hiiro::Reminder.edit(hiiro: self, reminders: Hiiro::Reminder.order(:id).all)
  end

  add_subcmd(:path) do |*args|
    print Hiiro::DB.connection.opts[:database]
  end

  add_subcmd(:howto) do |*args|
    puts <<~HOWTO
      h remind - Reminder notification system

      One-time reminders:
        h remind add 'Read the news' 15m
        h remind add 'Meeting' 202602131430
        h remind once 'Call mom' 2h
      Relative times: 30s, 15m, 2h, 1d, 1w.
      Calendar times: YYYYmmddHHMM (local time, not a Unix timestamp).

      Recurring reminders:
        h remind every 'Take a break' 30m
        h remind every 'Stand up' 1h basso
      A recurring reminder is due on its first check, then after each interval.
      Unrecognized intervals retain the one-hour recurrence fallback.

      Management (numbers are stable database IDs, not list positions):
        h remind list
        h remind pause 1
        h remind resume 1
        h remind remove 2
        h remind clean       # Remove disabled one-time reminders
        h remind check -v    # Notify due reminders and record their checkpoints
        h remind path        # Print the SQLite database path

      Editing:
        h remind add         # New reminders in a temporary YAML document
        h remind editall     # Edit a temporary projection of database rows
      Keep existing IDs; new rows omit ID. Only changed fields are saved.
      Omitted fields stay unchanged. Removing a selected row deletes only that ID.
      Concurrent field conflicts and invalid edits cancel the entire edit.
      Blank, unchanged, or failed editor output performs no writes.

      Authority: SQLite reminders in #{Hiiro::DB.connection.opts[:database]}.
      Legacy reminders.yml is an explicit 'h db migrate' input, not a live store.
      Sounds may be placed in ~/.config/hiiro/sounds/ (name without extension).

      Scheduling (nothing runs until you enable it):
        # ~/.config/hiiro/schedules.yml
        reminders:
          job: reminders
          every: 1m
        h schedule plan reminders     # show the launchd job without installing it
        h schedule enable reminders   # register it with launchd
      Each check claims a reminder occurrence once, so overlapping checks notify once.
      A failed notification is recorded (h schedule status reminder:) and retried
      by the next check. Notifications are at least once, not exactly once.
    HOWTO
  end
end
