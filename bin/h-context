#!/usr/bin/env ruby

require "hiiro"

manager = Hiiro::ContextBundle.new
hiiro = Hiiro.init(*ARGV)

CAPTURE_OPTIONS = Hiiro::Options.setup {
  flag(:force, short: :f, desc: "Replace an existing file at NAME")
  option(:task, short: :t, desc: "Also attach the file to this task ('.' for the current task)")
  option(:label, short: :l, desc: "Label for the task attachment")
}

def print_lines(lines)
  lines.each { |line| puts line }
end

def with_error_handling
  yield
rescue Hiiro::Error, SystemCallError => e
  warn e.message
  exit 1
end

# Captures into the bundle (always) and the task given with --task. The
# destination is NAME under today's directory, or a fresh temp file.
def capture_into_bundle(manager, mode, args, temp_ext: nil, png: false)
  opts = CAPTURE_OPTIONS.parse(args)
  name = opts.args.first
  task = with_error_handling do
    raise Hiiro::Error, "Unexpected arguments: #{opts.args.drop(1).join(' ')}" if opts.args.length > 1
    raise Hiiro::Error, "A file name is required." if temp_ext.nil? && !png && name.nil?
    opts.task && Hiiro::Artifact.task_for(opts.task)
  end
  destination = lambda do |_payload|
    next manager.temp_path(temp_ext) if temp_ext

    path = manager.named_path(name || "image-#{Time.now.strftime("%H%M%S")}.png")
    png && File.extname(path).downcase != ".png" ? "#{path}.png" : path
  end
  handoff = Hiiro::Artifact::Handoff.new(bundle: manager, task: task, label: opts.label)
  outcome = Hiiro::Artifact.capture(mode, overwrite: opts.force, &destination)
  status = handoff.finish(outcome)
  warn "Use --force to replace it." if outcome.existing
  exit status unless status.zero?
end

[:new, :reset, :clear].each do |name|
  hiiro.add_subcmd(name) do
    with_error_handling do
      puts manager.reset_bundle!
    end
  end
end

hiiro.add_subcmd(:path) do
  puts manager.current_bundle_path
end

[:ls, :list, :show].each do |name|
  hiiro.add_subcmd(name) do
    lines = manager.bundle_lines
    if lines.empty?
      puts "(bundle empty)"
    else
      print_lines(lines)
    end
  end
end

hiiro.add_subcmd(:copy) do
  payload = manager.copy_payload
  unless Hiiro::Clipboard.copy_text(payload)
    warn "Could not copy the bundle to the clipboard"
    exit 1
  end
  puts payload
end

hiiro.add_subcmd(:save) do |*args|
  capture_into_bundle(manager, :text, args)
end

[:tmp, :temp].each do |name|
  hiiro.add_subcmd(name) do |*args|
    capture_into_bundle(manager, :text, args, temp_ext: "txt")
  end
end

[:img, :imgas].each do |name|
  hiiro.add_subcmd(name) do |*args|
    capture_into_bundle(manager, :image, args, png: true)
  end
end

[:tmpimage, :tmpimg].each do |name|
  hiiro.add_subcmd(name) do |*args|
    capture_into_bundle(manager, :image, args, temp_ext: "png")
  end
end

hiiro.add_subcmd(:add) do |*paths|
  with_error_handling do
    raise Hiiro::Error, "Provide one or more paths to add." if paths.empty?
    print_lines(manager.add_paths(*paths))
  end
end

[:rm, :remove, :delete].each do |name|
  hiiro.add_subcmd(name) do |*targets|
    with_error_handling do
      raise Hiiro::Error, "Provide one or more bundle entries or indices to remove." if targets.empty?
      print_lines(manager.remove_entries(*targets))
    end
  end
end

[:save_bundle, :bundle_save].each do |name|
  hiiro.add_subcmd(name) do |bundle_name = nil|
    with_error_handling do
      raise Hiiro::Error, "Provide a bundle name." if bundle_name.nil? || bundle_name.strip.empty?
      puts manager.save_named_bundle(bundle_name)
    end
  end
end

[:load_bundle, :bundle_load, :use].each do |name|
  hiiro.add_subcmd(name) do |bundle_name = nil|
    with_error_handling do
      raise Hiiro::Error, "Provide a bundle name." if bundle_name.nil? || bundle_name.strip.empty?
      puts manager.load_named_bundle(bundle_name)
    end
  end
end

[:bundles, :list_bundles].each do |name|
  hiiro.add_subcmd(name) do
    bundles = manager.list_named_bundles
    if bundles.empty?
      puts "(no saved bundles)"
    else
      print_lines(bundles)
    end
  end
end

hiiro.add_subcmd(:open, :edit) do
  with_error_handling do
    case manager.edit(hiiro)
    when :saved then puts manager.current_bundle_path
    when :unchanged then puts "Bundle unchanged."
    when :cancelled then puts "Cancelled; bundle unchanged."
    end
  end
end

hiiro.add_subcmd(:help) do
  puts <<~TEXT
    h-context subcommands:
      new | reset | clear       Reset the current bundle to an empty file
      path                      Print the current bundle file path
      ls | list | show          Show current bundle entries
      copy                      Copy bundle entries to the clipboard as @/abs/path lines
      save NAME                 Save clipboard text to ~/notes/ctx/YYYY-MM-DD/NAME and add it
      tmp                       Save clipboard text to a temp file and add it
      img [NAME]                Save clipboard image to ~/notes/ctx/YYYY-MM-DD/NAME(.png) and add it
      tmpimage                  Save clipboard image to a temp file and add it
      add PATH...               Add existing paths to the bundle
      rm TARGET...              Remove bundle entries by index, absolute path, or basename
      save_bundle NAME          Save the whole current bundle as a reusable named bundle
      load_bundle NAME          Replace the current bundle with a saved named bundle
      bundles                   List saved named bundles
      open | edit               Edit the bundle in $EDITOR; every line must be an existing path

    Capture options (save, tmp, img, tmpimage):
      -f, --force               Replace an existing file at NAME (otherwise refused)
      -t, --task TASK           Also attach the file to TASK ('.' = current task)
      -l, --label LABEL         Label for the task attachment

    Exit status: 0 done, 1 nothing captured, 2 captured but an attachment failed.
  TEXT
end

hiiro.run
