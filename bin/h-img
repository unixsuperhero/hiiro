#!/usr/bin/env ruby

require 'hiiro'
require 'base64'

MIME_TYPES = {
  'jpg'  => 'image/jpeg',
  'jpeg' => 'image/jpeg',
  'gif'  => 'image/gif',
  'webp' => 'image/webp',
  'png'  => 'image/png',
}.freeze

def mime_for(path)
  MIME_TYPES.fetch(File.extname(path).downcase.delete('.'), 'image/png')
end

Hiiro.run(*ARGV) {
  add_subcmd(:save) { |*args|
    opts = Hiiro::Options.parse(args) { flag(:force, short: :f, desc: 'Replace an existing file') }
    outpath = opts.args.first
    unless outpath && opts.args.one?
      puts "Usage: h img save [--force] <outpath>"
      exit 1
    end

    outcome = Hiiro::Artifact.capture(:image, overwrite: opts.force) { outpath }
    unless outcome.ok?
      warn outcome.existing ? "#{outcome.detail} (use --force to replace it)" : outcome.detail
      exit 1
    end
    puts "Saved to #{outcome.artifact.path}"
  }

  add_subcmd(:b64) { |path=nil|
    if path
      unless File.exist?(path)
        puts "File not found: #{path}"
        exit 1
      end
      data = File.binread(path)
      mime = mime_for(path)
    else
      image = Hiiro::Clipboard.image
      unless image.ok?
        warn image.detail
        exit 1
      end
      data = image.bytes
      mime = image.content_type
    end

    puts "data:#{mime};base64,#{Base64.strict_encode64(data)}"
  }
}
