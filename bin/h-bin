#!/usr/bin/env ruby

require 'hiiro'

Hiiro.run do
  add_cmd :add, args: ['NAME', 'COMMAND...'] do
    name, *commands = opts.args
    name = name&.delete_prefix('h-')
    abort 'Use a command name containing letters, digits, underscores, or hyphens' unless name&.match?(/\A[A-Za-z0-9][A-Za-z0-9_-]*\z/)
    abort 'Subcommand names cannot be empty' if commands.any?(&:empty?)

    path = File.join(Dir.home, 'bin', "h-#{name}")
    body = commands.map { |command| "  add_cmd #{command.to_sym.inspect} do\n  end" }.join("\n\n")
    template = "#!/usr/bin/env ruby\n\nrequire 'hiiro'\n\nHiiro.run do\n"
    template << "#{body}\n" unless body.empty?
    template << "end\n"

    FileUtils.mkdir_p(File.dirname(path))
    File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o755) do |file|
      file.write(template)
      file.chmod(0o755)
    end
    puts path
  end

  # The root command's catalog: the same winners, aliases, and sources `h` dispatches.
  root = -> { Hiiro::RootCommands.build(bin_name.delete_suffix('-bin')) }

  add_subcmd(:list, :ls) do |*prefixes|
    catalog = root.call.catalog
    entries = if prefixes.empty?
      catalog.entries
    else
      prefixes.flat_map { |prefix| catalog.complete(prefix).map { |token| catalog.resolve(token).entry } }.uniq
    end
    list_runners(entries)
  end

  add_subcmd(:edit) do |*names|
    names.empty? ? edit_files(bin) : root.call.edit_commands(*names)
  end

  add_subcmd(:complete) do |word = ''|
    puts root.call.catalog.complete(word)
  end

  add_cmd :docs, opts: %i[json] do
    catalog = root.call.catalog
    puts opts.json ? catalog.to_json : catalog.to_markdown
  end
end
