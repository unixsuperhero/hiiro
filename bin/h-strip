#!/usr/bin/env ruby

require 'hiiro'

ANSI = /
  (?:
    \x1B\[[\x30-\x3F]*[\x20-\x2F]*[\x40-\x7E] |
    \x1B\][^\x07\x1B]*(?:\x07|\x1B\\) |
    \x1B[P^_][^\x1B]*(?:\x1B\\) |
    \x1B[\x20-\x2F]*[\x30-\x7E]
  )
/nx
CONTROL = /[\x00-\x08\x0B-\x1F\x7F]/n

Hiiro.run do
  add_cmd :ctrl, args: ['[FILE...|TEXT...]'] do
    arguments = opts.args
    paths = arguments.map { |argument| File.expand_path(argument) }
    input = if arguments.empty? || paths.all? { |path| File.file?(path) }
      Hiiro::Shell.read_input(*paths)
    else
      arguments.join(' ')
    end

    STDOUT.binmode.write(input.b.gsub(ANSI, '').gsub(CONTROL, ''))
    nil
  end
end
