#!/usr/bin/env ruby

require 'hiiro'

Hiiro.run(*ARGV) do
  # The abbreviated SHA of the chosen commit; nil when there are none or the
  # pick was cancelled.
  choose_sha = ->(log_args) {
    commits = Hiiro::CommitLog.read('-100', *log_args)
    next warn('No commits found') if commits.empty?

    Hiiro::CommitLog.choose(commits, hiiro: self)&.short
  }

  add_subcmd(:select) do |*select_args|
    sha = choose_sha.call(select_args)
    print sha if sha
  end

  add_subcmd(:ls) do |*ls_args|
    system('git', 'log', '--oneline', *ls_args)
  end

  add_subcmd(:show) do |sha = nil, *show_args|
    sha ||= choose_sha.call([])
    next unless sha

    system('git', 'show', sha, *show_args)
  end

  add_subcmd(:copy) do |sha = nil, *copy_args|
    sha ||= choose_sha.call([])
    next unless sha

    Hiiro::Shell.pipe(sha, 'pbcopy')
    puts "Copied #{sha} to clipboard"
  end
end
