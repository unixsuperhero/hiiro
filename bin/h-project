#!/usr/bin/env ruby

require "hiiro"

# Open or create a Herdr workspace for a project.
def open_project_workspace(name, path)
  Hiiro::Herdr.open_workspace(name.to_s.tr('.', '_'), start_directory: path)
end

def project_aliases_yaml(aliases)
  aliases.sort.map { |name, path| "#{name}: #{path}\n" }.join
end

Hiiro.run(*ARGV) do
  projects = Hiiro::Projects.new
  Hiiro::Projects.add_resolvers(self)

  project_context = ->(name = nil) { projects.context(name, chooser: Hiiro::Projects.chooser(self)) }

  add_subcmd(:open) { |project_name=nil|
    selected = project_context.call(project_name).validate!
    name = selected.project.respond_to?(:name) ? selected.project.name : selected.project
    puts "changing dir: #{selected.start_directory}"
    Dir.chdir(selected.start_directory)
    open_project_workspace(name, selected.start_directory)
  }

  add_subcmd(:path, :abspath) { |project_name=nil|
    print project_context.call(project_name).start_directory
  }

  add_subcmd(:cd) { |project_name=nil|
    selected = project_context.call(project_name).validate!
    terminal = selected.terminal
    raise Hiiro::Error, 'Not running inside a Herdr pane' unless terminal.pane_id
    client = Hiiro::Herdr.client
    terminal.validate!(client)
    client.run_in_pane(terminal.pane_id, "cd #{selected.start_directory.shellescape}")
  }

  # === LIST PROJECTS ===
  add_subcmd(:list) { |*list_args|
    all  = projects.all
    conf = projects.from_config

    puts "Projects:"
    puts

    all.keys.sort.each do |name|
      path   = all[name]
      source = conf.key?(name) ? '[config]' : '[dir]'
      puts format("  %-12s %-8s %s", name, source, path)
    end
  }

  add_subcmd(:ls) { |*ls_args|
    run_subcmd(:list, *ls_args)
  }

  add_subcmd(:add) { |name=nil, path=nil|
    unless name && path && !name.empty? && !path.empty?
      puts "Usage: h project add <name> <path>"
      next
    end
    projects.save_project(name, path)
    puts "Saved project '#{name}' => #{path}"
  }

  add_subcmd(:rm, :remove) { |name=nil|
    unless projects.remove_project(name)
      puts "Project '#{name}' not found"
      next
    end
    puts "Removed project '#{name}'"
  }

  # === SHOW PROJECT ALIASES ===
  add_subcmd(:config) { |*config_args|
    aliases = projects.from_config

    if aliases.empty?
      puts "No project aliases saved."
      puts
      puts "Create it with YAML format:"
      puts "  project_name: /path/to/project"
    else
      puts project_aliases_yaml(aliases)
    end
  }

  # === EDIT PROJECT ALIASES ===
  add_subcmd(:edit) { |*edit_args|
    aliases = projects.from_config
    content = aliases.empty? ? "# project_name: /path/to/project\n" : project_aliases_yaml(aliases)

    input = Hiiro::InputFile.yaml_file(hiiro: self, content: content, prefix: 'project-edit-')
    doc = input.edit.document
    input.cleanup
    edited = doc.parsed

    if !doc.valid? || doc.empty? || !edited.is_a?(Hash) || edited.empty?
      puts "No changes applied."
      next
    end

    edited = edited.to_h { |name, path| [name.to_s, path.to_s] }
    edited.each { |name, path| projects.save_project(name, path) unless aliases[name] == path }
    (aliases.keys - edited.keys).each { |name| projects.remove_project(name) }
  }

  # === PROJECTS SCREEN ===
  add_subcmd(:ui) { |*ui_args|
    opts = Hiiro::Options.setup {
      option(:root, desc: 'Root directory to scan; repeatable', multi: true)
    }.parse(ui_args)

    roots = opts.root.empty? ? Hiiro::ProjectCatalog.default_roots : opts.root
    catalog = Hiiro::ProjectCatalog.load(roots:, aliases: projects.from_config)
    current = Hiiro::CurrentTask.new(herdr: -> { herdr_client }, pin: true).resolve
    Hiiro::ProjectScreen.new(catalog:, scope: :global, current:).run
    nil # the screen's false return would become a non-zero exit status
  }


  add_subcmd(:select) {
    selection = projects.pick(chooser: Hiiro::Projects.chooser(self))
    print projects.context(selection: selection).start_directory
  }

  add_subcmd(:copy) {
    selection = projects.pick(chooser: Hiiro::Projects.chooser(self))
    selected = projects.context(selection: selection).start_directory
    Hiiro::Shell.pipe(selected, 'pbcopy')
    puts "Copied project path '#{selected}' to clipboard"
  }

  add_subcmd(:sh) { |project_name=nil, *native_args|
    selected = project_context.call(project_name).validate!
    Dir.chdir(selected.start_directory)
    native_args.empty? ? exec(ENV['SHELL'] || 'zsh') : exec(*native_args)
  }

  # === HELP ===
  add_subcmd(:help) { |*help_args|
    puts <<~HELP
      h-project - Project directory and Herdr workspace manager

      USAGE:
        h-project <project_name>        Open project (fuzzy match) and focus its Herdr workspace
        h-project open <project_name>   Same as above
        h-project list                  List all known projects
        h-project ls                    Alias for list
        h-project add <name> <path>     Save a project alias
        h-project rm <name>             Remove a saved alias
        h-project config                Show saved project aliases as YAML
        h-project edit                  Edit saved project aliases as YAML
        h-project ui [--root DIR ...]   Projects screen over worktrees, directories, and aliases
        h-project sh <project_name>     Open shell in project directory
        h-project ui [--root DIR ...]   TUI over every worktree, dir, and alias (see docs/h-project.md)

      SOURCES:
        Directories in ~/proj/ and aliases saved in registry table `project`
        (legacy ~/.config/hiiro/projects.yml is an explicit `h db migrate` input).

      ALIAS FORMAT (h-project config / edit):
        project_name: /path/to/project
        another: /some/other/path

      MATCHING:
        Exact names win, then unique prefixes.
        Ambiguous names open an object-mapped picker in a TTY.
        Non-TTY ambiguity and missing projects fail without launching work.
    HELP
  }

  add_default {
    run_subcmd(:help)
  }
end
