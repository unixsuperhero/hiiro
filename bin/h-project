#!/usr/bin/env ruby

require "hiiro"

# Open or create a Herdr workspace for a project.
def open_project_workspace(name, path)
  Hiiro::Herdr.open_workspace(name.to_s.tr('.', '_'), start_directory: path)
end

Hiiro.run(*ARGV) do
  projects = Hiiro::Projects.new
  Hiiro::Projects.add_resolvers(self)

  project_context = ->(name = nil) { projects.context(name, chooser: method(:fuzzyfind_from_map)) }

  add_subcmd(:open) { |project_name=nil|
    selected = project_context.call(project_name).validate!
    name = selected.project.respond_to?(:name) ? selected.project.name : selected.project
    puts "changing dir: #{selected.start_directory}"
    Dir.chdir(selected.start_directory)
    open_project_workspace(name, selected.start_directory)
  }

  add_subcmd(:path, :abspath) { |project_name=nil|
    print project_context.call(project_name).start_directory
  }

  add_subcmd(:cd) { |project_name=nil|
    selected = project_context.call(project_name).validate!
    terminal = selected.terminal
    raise Hiiro::Error, 'Not running inside a Herdr pane' unless terminal.pane_id
    client = Hiiro::Herdr.client
    terminal.validate!(client)
    client.run_in_pane(terminal.pane_id, "cd #{selected.start_directory.shellescape}")
  }

  # === LIST PROJECTS ===
  add_subcmd(:list) { |*list_args|
    all  = projects.all
    conf = projects.from_config

    puts "Projects:"
    puts

    all.keys.sort.each do |name|
      path   = all[name]
      source = conf.key?(name) ? '[config]' : '[dir]'
      puts format("  %-12s %-8s %s", name, source, path)
    end
  }

  add_subcmd(:ls) { |*ls_args|
    run_subcmd(:list, *ls_args)
  }

  add_subcmd(:add) { |name=nil, path=nil|
    unless name && path && !name.empty? && !path.empty?
      puts "Usage: h project add <name> <path>"
      next
    end
    projects.save_project(name, path)
    puts "Saved project '#{name}' => #{path}"
  }

  add_subcmd(:rm, :remove) { |name=nil|
    record = Hiiro::Project.find_by_name(name)
    unless record
      puts "Project '#{name}' not found"
      next
    end
    record.destroy
    puts "Removed project '#{name}'"
  }

  add_subcmd(:config) {
    puts Hiiro::Project.editor_projection.to_yaml
  }

  add_subcmd(:edit) do
    puts(Hiiro::Project.edit(hiiro: self) ? "Projects updated" : "No projects changed")
  rescue ArgumentError, Hiiro::Error, Sequel::ConstraintViolation => e
    warn "Projects not changed: #{e.message}"
  end

  add_subcmd(:select) {
    selection = projects.pick(chooser: method(:fuzzyfind_from_map))
    print projects.context(selection: selection).start_directory
  }

  add_subcmd(:copy) {
    selection = projects.pick(chooser: method(:fuzzyfind_from_map))
    selected = projects.context(selection: selection).start_directory
    Hiiro::Shell.pipe(selected, 'pbcopy')
    puts "Copied project path '#{selected}' to clipboard"
  }

  add_subcmd(:sh) { |project_name=nil, *native_args|
    selected = project_context.call(project_name).validate!
    Dir.chdir(selected.start_directory)
    native_args.empty? ? exec(ENV['SHELL'] || 'zsh') : exec(*native_args)
  }

  # === HELP ===
  add_subcmd(:help) { |*help_args|
    puts <<~HELP
      h-project - Project directory and Herdr workspace manager

      USAGE:
        h-project <project_name>        Open project (fuzzy match) and focus its Herdr workspace
        h-project open <project_name>   Same as above
        h-project list                  List all known projects
        h-project ls                    Alias for list
        h-project add <name> <path>     Save a project alias
        h-project rm <name>             Remove a saved alias
        h-project config                Show the SQLite editor projection
        h-project edit                  Edit saved aliases
        h-project sh <project_name>     Open shell in project directory

      SOURCES:
        Directories in ~/proj/ and saved project aliases in SQLite.

      EDIT FORMAT:
        YAML rows with id, name, and path. New rows omit id.
        Set delete: true to remove a displayed alias; omitted rows are preserved.

      MATCHING:
        Exact names win, then unique prefixes.
        Ambiguous names open an object-mapped picker in a TTY.
        Non-TTY ambiguity and missing projects fail without launching work.
    HELP
  }

  add_default {
    run_subcmd(:help)
  }
end
