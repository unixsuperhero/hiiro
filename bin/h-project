#!/usr/bin/env ruby

require "hiiro"

# Open or create a Herdr workspace for a project.
def open_project_workspace(name, path)
  Hiiro::Herdr.open_workspace(name.to_s.tr('.', '_'), start_directory: path)
end

Hiiro.run(*ARGV) do
  projects = Hiiro::Projects.new
  Hiiro::Projects.add_resolvers(self)

  # === OPEN PROJECT (default) ===
  add_subcmd(:open) { |project_name|
    result = Hiiro::Matcher.by_prefix(projects.all, project_name) { |name, _| name }
    matches = result.matches

    case matches.count
    when 0
      name = 'proj'
      path = File.join(Dir.home, 'proj')

      unless Dir.exist?(path)
        puts "Error: #{path.inspect} does not exist"
        exit 1
      end

      puts "changing dir: #{path}"
      Dir.chdir(path)

      open_project_workspace(name, path)
    when 1
      name, path = matches.first.item

      puts "changing dir: #{path}"
      Dir.chdir(path)

      open_project_workspace(name, path)
    when (2..)
      puts "ERROR: Multiple matches found"
      puts
      puts "Matches:"
      matches.each { |match|
        name, path = match.item
        puts format("  %s: %s", name, path)
      }
    end
  }

  # === LIST PROJECTS ===
  add_subcmd(:list) { |*list_args|
    all  = projects.all
    conf = projects.from_config

    puts "Projects:"
    puts

    all.keys.sort.each do |name|
      path   = all[name]
      source = conf.key?(name) ? '[config]' : '[dir]'
      puts format("  %-12s %-8s %s", name, source, path)
    end
  }

  add_subcmd(:ls) { |*ls_args|
    run_subcmd(:list, *ls_args)
  }

  add_subcmd(:add) { |name=nil, path=nil|
    unless name && path && !name.empty? && !path.empty?
      puts "Usage: h project add <name> <path>"
      next
    end
    projects.save_project(name, path)
    puts "Saved project '#{name}' => #{path}"
  }

  add_subcmd(:rm, :remove) { |name=nil|
    record = Hiiro::Project.find_by_name(name)
    unless record
      puts "Project '#{name}' not found"
      next
    end
    record.destroy
    puts "Removed project '#{name}'"
  }

  add_subcmd(:config) {
    puts Hiiro::Project.editor_projection.to_yaml
  }

  add_subcmd(:edit) do
    puts(Hiiro::Project.edit(hiiro: self) ? "Projects updated" : "No projects changed")
  rescue ArgumentError, Hiiro::Error, Sequel::ConstraintViolation => e
    warn "Projects not changed: #{e.message}"
  end

  # === SELECT PROJECT ===
  add_subcmd(:select) { |*select_args|
    all = projects.all

    if all.empty?
      STDERR.puts "No projects found"
      next
    end

    conf = projects.from_config
    lines = all.each_with_object({}) do |(name, path), h|
      source = conf.key?(name) ? '[config]' : '[dir]'
      display = format("%-15s %s  %s", name, source, path)
      h[display] = path
    end

    selected = fuzzyfind_from_map(lines)
    print selected if selected
  }

  # === COPY PROJECT PATH ===
  add_subcmd(:copy) { |*copy_args|
    all = projects.all

    if all.empty?
      STDERR.puts "No projects found"
      next
    end

    conf = projects.from_config
    lines = all.each_with_object({}) do |(name, path), h|
      source = conf.key?(name) ? '[config]' : '[dir]'
      display = format("%-15s %s  %s", name, source, path)
      h[display] = path
    end

    selected = fuzzyfind_from_map(lines)
    if selected
      Hiiro::Shell.pipe(selected, 'pbcopy')
      puts "Copied project path '#{selected}' to clipboard"
    end
  }

  # === SHELL IN PROJECT ===
  add_subcmd(:sh) { |project_name=nil, *args|
    if project_name.nil? || project_name.empty?
      puts "Usage: h project sh <project_name> [command...]"
      next
    end

    re = /#{project_name}/i
    conf_matches = projects.from_config.select { |k, v| k.match?(re) }
    dir_matches  = projects.dirs.select { |proj, path| proj.match?(re) }
    matches = dir_matches.merge(conf_matches)
    matches = matches.select { |name, path| name == project_name } if matches.count > 1

    case matches.count
    when 0
      puts "Project '#{project_name}' not found"
      puts
      puts "Available projects:"
      projects.all.keys.sort.each { |k| puts "  #{k}" }
    when 1
      _, path = matches.first
      Dir.chdir(path)
      args.empty? ? exec(ENV['SHELL'] || 'zsh') : exec(*args)
    else
      puts "Ambiguous project '#{project_name}' — multiple matches:"
      matches.each { |name, path| puts format("  %-15s %s", name, path) }
    end
  }

  # === HELP ===
  add_subcmd(:help) { |*help_args|
    puts <<~HELP
      h-project - Project directory and Herdr workspace manager

      USAGE:
        h-project <project_name>        Open project (fuzzy match) and focus its Herdr workspace
        h-project open <project_name>   Same as above
        h-project list                  List all known projects
        h-project ls                    Alias for list
        h-project add <name> <path>     Save a project alias
        h-project rm <name>             Remove a saved alias
        h-project config                Show the SQLite editor projection
        h-project edit                  Edit saved aliases
        h-project sh <project_name>     Open shell in project directory

      SOURCES:
        Directories in ~/proj/ and saved project aliases in SQLite.

      EDIT FORMAT:
        YAML rows with id, name, and path. New rows omit id.
        Set delete: true to remove a displayed alias; omitted rows are preserved.

      MATCHING:
        Project names are matched using regex (case insensitive).
        If multiple matches are found, an exact match is preferred.
        If still ambiguous, all matches are displayed.
    HELP
  }

  add_default {
    run_subcmd(:help)
  }
end
