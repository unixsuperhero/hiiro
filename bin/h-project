#!/usr/bin/env ruby

require "hiiro"

# Open or create a Herdr workspace for a project.
def open_project_workspace(name, path)
  Hiiro::Herdr.open_workspace(name.to_s.tr('.', '_'), start_directory: path)
end

def project_aliases_yaml(aliases)
  aliases.sort.map { |name, path| "#{name}: #{path}\n" }.join
end

Hiiro.run(*ARGV) do
  projects = Hiiro::Projects.new
  Hiiro::Projects.add_resolvers(self)

  # === OPEN PROJECT (default) ===
  add_subcmd(:open) { |project_name|
    re = /#{project_name}/i

    # conf_matches = projects.from_config.select { |k, v| k.match?(re) }
    # dir_matches  = projects.dirs.select { |proj, path| proj.match?(re) }

    dir_matches = Hiiro::Matcher.by_prefix(projects.dirs, project_name){|k,v| k }
    matches = dir_matches.matches

    case dir_matches.matches.count
    when 0
      name = 'proj'
      path = File.join(Dir.home, 'proj')

      unless Dir.exist?(path)
        puts "Error: #{path.inspect} does not exist"
        exit 1
      end

      puts "changing dir: #{path}"
      Dir.chdir(path)

      open_project_workspace(name, path)
    when 1
      name, path = matches.first.item

      puts "changing dir: #{path}"
      Dir.chdir(path)

      open_project_workspace(name, path)
    when (2..)
      puts "ERROR: Multiple matches found"
      puts
      puts "Matches:"
      matches.each { |name, path|
        puts format("  %s: %s", name, path)
      }
    end
  }

  # === LIST PROJECTS ===
  add_subcmd(:list) { |*list_args|
    all  = projects.all
    conf = projects.from_config

    puts "Projects:"
    puts

    all.keys.sort.each do |name|
      path   = all[name]
      source = conf.key?(name) ? '[config]' : '[dir]'
      puts format("  %-12s %-8s %s", name, source, path)
    end
  }

  add_subcmd(:ls) { |*ls_args|
    run_subcmd(:list, *ls_args)
  }

  # === SHOW PROJECT ALIASES ===
  add_subcmd(:config) { |*config_args|
    aliases = projects.from_config

    if aliases.empty?
      puts "No project aliases saved."
      puts
      puts "Create it with YAML format:"
      puts "  project_name: /path/to/project"
    else
      puts project_aliases_yaml(aliases)
    end
  }

  # === EDIT PROJECT ALIASES ===
  add_subcmd(:edit) { |*edit_args|
    aliases = projects.from_config
    content = aliases.empty? ? "# project_name: /path/to/project\n" : project_aliases_yaml(aliases)

    input = yaml_input_file(content:, prefix: 'project-edit-')
    doc = input.edit.document
    input.cleanup
    edited = doc.parsed

    if !doc.valid? || doc.empty? || !edited.is_a?(Hash) || edited.empty?
      puts "No changes applied."
      next
    end

    edited = edited.to_h { |name, path| [name.to_s, path.to_s] }
    edited.each { |name, path| projects.save_project(name, path) unless aliases[name] == path }
    (aliases.keys - edited.keys).each { |name| Hiiro::RegistryEntry.where(resource_type: 'project', name:).destroy }
  }

  # === SELECT PROJECT ===
  add_subcmd(:select) { |*select_args|
    all = projects.all

    if all.empty?
      STDERR.puts "No projects found"
      next
    end

    conf = projects.from_config
    lines = all.each_with_object({}) do |(name, path), h|
      source = conf.key?(name) ? '[config]' : '[dir]'
      display = format("%-15s %s  %s", name, source, path)
      h[display] = path
    end

    selected = fuzzyfind_from_map(lines)
    print selected if selected
  }

  # === COPY PROJECT PATH ===
  add_subcmd(:copy) { |*copy_args|
    all = projects.all

    if all.empty?
      STDERR.puts "No projects found"
      next
    end

    conf = projects.from_config
    lines = all.each_with_object({}) do |(name, path), h|
      source = conf.key?(name) ? '[config]' : '[dir]'
      display = format("%-15s %s  %s", name, source, path)
      h[display] = path
    end

    selected = fuzzyfind_from_map(lines)
    if selected
      Hiiro::Shell.pipe(selected, 'pbcopy')
      puts "Copied project path '#{selected}' to clipboard"
    end
  }

  # === PROJECTS SCREEN ===
  add_subcmd(:ui) { |*ui_args|
    opts = Hiiro::Options.setup {
      option(:root, desc: 'Root directory to scan; repeatable', multi: true)
    }.parse(ui_args)

    roots = opts.root.empty? ? Hiiro::ProjectCatalog.default_roots : opts.root
    catalog = Hiiro::ProjectCatalog.load(roots:, aliases: projects.from_config)
    current = Hiiro::CurrentTask.new(herdr: -> { herdr_client }, pin: true).resolve
    Hiiro::ProjectScreen.new(catalog:, scope: :global, current:).run
    nil # the screen's false return would become a non-zero exit status
  }

  # === SHELL IN PROJECT ===
  add_subcmd(:sh) { |project_name=nil, *args|
    if project_name.nil? || project_name.empty?
      puts "Usage: h project sh <project_name> [command...]"
      next
    end

    re = /#{project_name}/i
    conf_matches = projects.from_config.select { |k, v| k.match?(re) }
    dir_matches  = projects.dirs.select { |proj, path| proj.match?(re) }
    matches = dir_matches.merge(conf_matches)
    matches = matches.select { |name, path| name == project_name } if matches.count > 1

    case matches.count
    when 0
      puts "Project '#{project_name}' not found"
      puts
      puts "Available projects:"
      projects.all.keys.sort.each { |k| puts "  #{k}" }
    when 1
      _, path = matches.first
      Dir.chdir(path)
      args.empty? ? exec(ENV['SHELL'] || 'zsh') : exec(*args)
    else
      puts "Ambiguous project '#{project_name}' — multiple matches:"
      matches.each { |name, path| puts format("  %-15s %s", name, path) }
    end
  }

  # === HELP ===
  add_subcmd(:help) { |*help_args|
    puts <<~HELP
      h-project - Project directory and Herdr workspace manager

      USAGE:
        h-project <project_name>        Open project (fuzzy match) and focus its Herdr workspace
        h-project open <project_name>   Same as above
        h-project list                  List all known projects
        h-project ls                    Alias for list
        h-project config                Show saved project aliases as YAML
        h-project edit                  Edit saved project aliases as YAML
        h-project sh <project_name>     Open shell in project directory
        h-project ui [--root DIR ...]   TUI over every worktree, dir, and alias (see docs/h-project.md)

      SOURCES:
        Projects are discovered from two sources:
        1. Directories in ~/proj/
        2. Aliases saved in registry table `project`
           (~/.config/hiiro/projects.yml is imported once and renamed .bak)

      ALIAS FORMAT (h-project config / edit):
        project_name: /path/to/project
        another: /some/other/path

      MATCHING:
        Project names are matched using regex (case insensitive).
        If multiple matches are found, an exact match is preferred.
        If still ambiguous, all matches are displayed.
    HELP
  }

  add_default {
    run_subcmd(:help)
  }
end
