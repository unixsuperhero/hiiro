#!/usr/bin/env ruby

require 'hiiro'

Hiiro.run(*ARGV) do
  select_todo = ->(pool) {
    return nil if pool.empty?
    map = pool.each_with_object({}) { |item, h| h[todo_manager.format_item(item)] = item.id.to_s }
    fuzzyfind_from_map(map)
  }

  add_subcmd(:ls) do |*ls_args|
    show_all = ls_args.delete('-a') || ls_args.delete('--all')
    status_filter = nil
    tag_filter = nil
    task_filter = nil

    while ls_args.any?
      arg = ls_args.shift
      case arg
      when '-s', '--status'
        status_filter = ls_args.shift
      when '-t', '--tag'
        tag_filter = ls_args.shift
      when '--task'
        task_filter = ls_args.shift
      end
    end

    items = if status_filter
      todo_manager.filter_by_status(*status_filter.split(','))
    elsif tag_filter
      todo_manager.filter_by_tag(tag_filter)
    elsif task_filter
      todo_manager.filter_by_task(task_filter)
    elsif show_all
      todo_manager.all
    else
      todo_manager.active
    end

    if items.empty?
      puts "No todo items found."
    else
      puts todo_manager.list(items)
    end
  end

  add_subcmd(:list) do |*list_args|
    run_subcmd(:ls, *list_args)
  end

  add_subcmd(:add) do |*add_args|
    if add_args.empty?
      new_items = todo_manager.edit_items(hiiro: self)
      if new_items.empty?
        puts "No items added."
        next
      end

      todo_manager.add_items(new_items)
      if new_items.length == 1
        puts "Added: #{todo_manager.format_item(new_items.first)}"
      else
        puts "Added #{new_items.length} items:"
        new_items.each { |item| puts "  #{todo_manager.format_item(item)}" }
      end
      next
    end

    tags = nil
    text_parts = []

    while add_args.any?
      arg = add_args.shift
      case arg
      when '-t', '--tags'
        tags = add_args.shift
      else
        text_parts << arg
      end
    end

    text = text_parts.join(' ')
    if text.empty?
      puts "Usage: h todo add <text> [-t tags]"
      exit 1
    end

    item = todo_manager.add(text, tags: tags)
    puts "Added: #{todo_manager.format_item(item)}"
  end

  add_subcmd(:rm) do |*rm_args|
    id_or_index = rm_args.shift
    id_or_index ||= select_todo.call(todo_manager.active)
    next puts "No item selected." if id_or_index.nil?

    item = todo_manager.remove(id_or_index)
    if item
      puts "Removed: #{item.text}"
    else
      puts "Item not found: #{id_or_index}"
      exit 1
    end
  end

  add_subcmd(:remove) do |*remove_args|
    run_subcmd(:rm, *remove_args)
  end

  add_subcmd(:change) do |*change_args|
    id_or_index = change_args.shift
    id_or_index ||= select_todo.call(todo_manager.active)
    next puts "No item selected." if id_or_index.nil?

    changes = {}

    while change_args.any?
      arg = change_args.shift
      case arg
      when '--text'
        changes[:text] = change_args.shift
      when '--tags', '-t'
        changes[:tags] = change_args.shift
      when '--status', '-s'
        changes[:status] = change_args.shift
      else
        changes[:text] = [arg, *change_args].join(' ').strip
        break
      end
    end

    item = todo_manager.change(id_or_index, **changes)
    if item
      puts "Updated: #{todo_manager.format_item(item)}"
    else
      puts "Item not found: #{id_or_index}"
      exit 1
    end
  end

  add_subcmd(:start) do |*start_args|
    id_or_index = start_args.shift
    id_or_index ||= select_todo.call(todo_manager.active)
    next puts "No item selected." if id_or_index.nil?

    item = todo_manager.start(id_or_index)
    if item
      puts "Started: #{todo_manager.format_item(item)}"
    else
      puts "Item not found: #{id_or_index}"
      exit 1
    end
  end

  add_subcmd(:done) do |*done_args|
    id_or_index = done_args.shift
    id_or_index ||= select_todo.call(todo_manager.active)
    next puts "No item selected." if id_or_index.nil?

    item = todo_manager.done(id_or_index)
    if item
      puts "Done: #{todo_manager.format_item(item)}"
    else
      puts "Item not found: #{id_or_index}"
      exit 1
    end
  end

  add_subcmd(:skip) do |*skip_args|
    id_or_index = skip_args.shift
    id_or_index ||= select_todo.call(todo_manager.active)
    next puts "No item selected." if id_or_index.nil?

    item = todo_manager.skip(id_or_index)
    if item
      puts "Skipped: #{todo_manager.format_item(item)}"
    else
      puts "Item not found: #{id_or_index}"
      exit 1
    end
  end

  add_subcmd(:reset) do |*reset_args|
    id_or_index = reset_args.shift
    id_or_index ||= select_todo.call(todo_manager.completed)
    next puts "No item selected." if id_or_index.nil?

    item = todo_manager.reset(id_or_index)
    if item
      puts "Reset: #{todo_manager.format_item(item)}"
    else
      puts "Item not found: #{id_or_index}"
      exit 1
    end
  end

  add_subcmd(:search) do |*search_args|
    query = search_args.join(' ')
    if query.empty?
      puts "Usage: h todo search <query>"
      exit 1
    end

    items = todo_manager.search(query)
    if items.empty?
      puts "No items matching: #{query}"
    else
      puts todo_manager.list(items)
    end
  end

  add_subcmd(:editall) do |*args|
    todo_manager.edit_items(todo_manager.all, hiiro: self)
  end

  add_subcmd(:help) do |*args|
    puts <<~HELP
      Usage: h todo <command> [args]

      Commands:
        ls, list              List todo items (active by default)
          -a, --all           Show all items including done/skip
          -s, --status STATUS Filter by status (not_started,started,done,skip)
          -t, --tag TAG       Filter by tag
          --task TASK         Filter by task name

        add [text] [-t tags]  Add todo item(s)
                              With no args, opens editor for YAML input

        rm, remove <id>       Remove a todo item

        change <id>           Modify a todo item
          --text TEXT         New text
          --tags TAGS         New tags
          --status STATUS     New status

        start <id>            Mark item as started
        done <id>             Mark item as done
        skip <id>             Mark item as skipped
        reset <id>            Reset item to not_started

        search <query>        Search items by text, tags, or task

        editall               Edit database todos as temporary YAML

      Item IDs:
        Items are identified by a permanent numeric ID (1, 2, 3, ...).
        IDs are never reused, even after items are deleted.

      Status icons:
        [ ] not_started
        [>] started
        [x] done
        [-] skip
    HELP
  end
end
