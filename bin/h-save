#!/usr/bin/env ruby

require 'hiiro'
require 'fileutils'

def saved_root
  ENV.fetch('HIIRO_SAVED_DIR') { File.join(Dir.home, 'saved') }
end

def saved_dir
  FileUtils.mkdir_p(saved_root)
  saved_root
end

def saved_files
  Dir.children(saved_dir).reject { |f| f.start_with?('.') }.sort.reverse
end

def slug_for(text)
  slug = text.strip.downcase.gsub(/[^a-z0-9]+/, '-').gsub(/\A-|-\z/, '')[0, 32]
  slug = slug.sub(/-\z/, '')
  slug.empty? ? 'text' : slug
end

# Inbox policy: <timestamp>-<slug>.txt or <timestamp>-image.png, with -2, -3, ...
# on collision; an existing file is never replaced.
def inbox_candidates(payload)
  stamp = Time.now.strftime('%Y%m%d%H%M%S')
  base = payload.content_type == 'image/png' ? "#{stamp}-image" : "#{stamp}-#{slug_for(payload.bytes.dup.force_encoding('UTF-8').scrub)}"
  Hiiro::Artifact.numbered(saved_root, base, payload.extension)
end

def save_text(text)
  Hiiro::Artifact.capture(:text_arg, text: text) { |payload| inbox_candidates(payload) }.artifact&.path
end

def resolve_saved(name)
  files = saved_files
  if files.empty?
    puts "Nothing saved in #{saved_root}"
    return nil
  end

  if name
    result = Hiiro::Matcher.by_substring(files, name, key: :to_s)
    files = result.matches.map(&:item)
    if files.empty?
      puts "No saved file matching '#{name}'"
      return nil
    end
    exact = files.find { |file| file == name }
    files = [exact] if exact
  end

  items = files.map { |file| Hiiro::Selection::Item.new(id: "saved:#{file}", title: file, open_target: File.join(saved_root, file), record: file) }
  Hiiro::Selection.pick(items, picker: 'saved-files', tty: true)&.open_target
end

save_opts = Hiiro::Options.setup {
  flag(:bundle, short: :b, desc: 'Also add the saved file to the current h context bundle')
  option(:task, short: :t, desc: "Also attach the saved file to this task ('.' for the current task)")
  option(:label, short: :l, desc: 'Label for the task attachment')
}

Hiiro.run(*ARGV) do
  add_default { |*args|
    opts = save_opts.parse(args)
    if opts.help?
      puts 'Usage: h save [--bundle] [--task TASK [--label LABEL]] [text...]'
      puts save_opts.help_text
      next
    end

    begin
      task = Hiiro::Artifact.task_for(opts.task) if opts.task
    rescue Hiiro::Error => e
      warn e.message
      exit 1
    end
    handoff = Hiiro::Artifact::Handoff.new(bundle: (Hiiro::ContextBundle.new if opts.bundle), task: task, label: opts.label)

    outcome = if opts.args.any?
      Hiiro::Artifact.capture(:text_arg, text: opts.args.join(' ')) { |payload| inbox_candidates(payload) }
    else
      Hiiro::Artifact.capture(:image_first) { |payload| inbox_candidates(payload) }
    end
    status = handoff.finish(outcome)
    exit status unless status.zero?
  }

  add_subcmd(:ls, :list) {
    saved_files.each { |f| puts f }
  }

  add_subcmd(:dir) {
    puts saved_dir
  }

  add_subcmd(:show, :cat) { |name = nil|
    path = resolve_saved(name)
    next unless path

    if path.end_with?('.png')
      puts path
    else
      print File.read(path)
    end
  }

  add_subcmd(:copy) { |name = nil|
    path = resolve_saved(name)
    next unless path

    copied = path.end_with?('.png') ? Hiiro::Clipboard.copy_image(path) : Hiiro::Clipboard.copy_text(File.binread(path))
    unless copied
      warn "Could not copy #{File.basename(path)} to the clipboard"
      exit 1
    end
    puts "Copied #{File.basename(path)} to clipboard"
  }

  add_subcmd(:open) { |name = nil|
    path = resolve_saved(name)
    system('open', path) if path
  }

  add_subcmd(:edit) { |name = nil|
    path = resolve_saved(name)
    edit_files(path) if path
  }

  add_subcmd(:rm, :remove) { |name = nil|
    path = resolve_saved(name)
    next unless path

    File.delete(path)
    puts "Removed #{File.basename(path)}"
  }
end
