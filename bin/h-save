#!/usr/bin/env ruby

require 'hiiro'
require 'fileutils'
require 'tempfile'

def saved_root
  ENV.fetch('HIIRO_SAVED_DIR') { File.join(Dir.home, 'saved') }
end

def saved_dir
  FileUtils.mkdir_p(saved_root)
  saved_root
end

def saved_files
  Dir.children(saved_dir).reject { |f| f.start_with?('.') }.sort.reverse
end

def clipboard_text
  `pbpaste`
end

def clipboard_image
  tmp = Tempfile.new(['h-save-', '.png'])
  tmp.close
  return tmp.path if system('pngpaste', tmp.path, out: File::NULL, err: File::NULL)

  tmp.unlink
  nil
end

def slug_for(text)
  slug = text.strip.downcase.gsub(/[^a-z0-9]+/, '-').gsub(/\A-|-\z/, '')[0, 32]
  slug = slug.sub(/-\z/, '')
  slug.empty? ? 'text' : slug
end

def unique_path(base, ext)
  path = File.join(saved_dir, "#{base}.#{ext}")
  n = 1
  while File.exist?(path)
    n += 1
    path = File.join(saved_dir, "#{base}-#{n}.#{ext}")
  end
  path
end

def save_text(text)
  stamp = Time.now.strftime('%Y%m%d%H%M%S')
  path = unique_path("#{stamp}-#{slug_for(text)}", 'txt')
  File.write(path, text)
  path
end

def save_image(tmp_path)
  stamp = Time.now.strftime('%Y%m%d%H%M%S')
  path = unique_path("#{stamp}-image", 'png')
  FileUtils.mv(tmp_path, path)
  path
end

def resolve_saved(name)
  files = saved_files
  if files.empty?
    puts "Nothing saved in #{saved_root}"
    return nil
  end

  if name
    result = Hiiro::Matcher.by_substring(files, name, key: :to_s)
    if result.ambiguous?
      match = fuzzyfind(result.matches.map(&:item))
    else
      match = result.first&.item
      puts "No saved file matching '#{name}'" unless match
    end
  else
    match = fuzzyfind(files)
  end

  match && File.join(saved_root, match)
end

Hiiro.run(*ARGV) do
  add_default { |*args|
    if args.any?
      puts save_text(args.join(' '))
      next
    end

    if (image = clipboard_image)
      puts save_image(image)
      next
    end

    text = clipboard_text
    if text.empty?
      puts 'Clipboard is empty'
      exit 1
    end

    puts save_text(text)
  }

  add_subcmd(:ls, :list) {
    saved_files.each { |f| puts f }
  }

  add_subcmd(:dir) {
    puts saved_dir
  }

  add_subcmd(:show, :cat) { |name = nil|
    path = resolve_saved(name)
    next unless path

    if path.end_with?('.png')
      puts path
    else
      print File.read(path)
    end
  }

  add_subcmd(:copy) { |name = nil|
    path = resolve_saved(name)
    next unless path

    if path.end_with?('.png')
      system('osascript', '-e', "set the clipboard to (read (POSIX file #{path.inspect}) as «class PNGf»)")
    else
      Hiiro::Shell.pipe(File.read(path), 'pbcopy')
    end
    puts "Copied #{File.basename(path)} to clipboard"
  }

  add_subcmd(:open) { |name = nil|
    path = resolve_saved(name)
    system('open', path) if path
  }

  add_subcmd(:edit) { |name = nil|
    path = resolve_saved(name)
    edit_files(path) if path
  }

  add_subcmd(:rm, :remove) { |name = nil|
    path = resolve_saved(name)
    next unless path

    File.delete(path)
    puts "Removed #{File.basename(path)}"
  }
end
