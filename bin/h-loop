#!/usr/bin/env ruby
# h-loop — recurring loop recipes, run one cycle at a time as owned schedules.
#
#   ~/ai/loops/<name>/config.yml   {name, frequency, prompt} plus agent: [argv] or command: [argv]
#   schedule loop-<name>           each cycle's outcome and log are recorded (h schedule status loop-<name>)
#   ~/ai/home.html                 written only by `h loop render`, from those records

require 'hiiro'
require 'cgi'

HOME_HTML = File.join(Dir.home, 'ai/home.html')
RESERVED  = %w[list ls add rm start stop restart run status render ui help].freeze

ADD_TEMPLATE = <<~YAML
  # h loop add — save this file to create a new loop. Lines starting with # are ignored.
  name: my-loop
  frequency: 10m    # 30s | 5m | 1h
  # Deterministic work each cycle (no agent):
  # command: [h, pr-monitor, --once]
  # Or an agent that interprets the prompt each cycle (explicit opt-in; the prompt
  # is passed as its last argument and its output is the cycle's log):
  # agent: [claude, -p, --model, sonnet]
  prompt: |
    Describe what the agent should report each cycle.
YAML

def loop_dir(name) = File.join(Hiiro::Schedule.loops_root, name)
def schedule_name(name) = "loop-#{name}"

def loop_names(args)
  names = args.flatten.compact
  names.empty? ? Hiiro::Schedule::Loops.configs.keys : names
end

def loop_definition(name) = Hiiro::Schedule.definition(schedule_name(name))

def last_outcomes(name, limit: 5) = Hiiro::JobOutcome.recent(limit: limit, definition: schedule_name(name)).select { |o| o.definition == schedule_name(name) }

def log_tail(outcome, lines: 20)
  path = outcome&.log_path
  path && File.file?(path) ? File.readlines(path, chomp: true).last(lines) : []
end

def show_status(name)
  definitions = Hiiro::Schedule.definitions
  definition = definitions[schedule_name(name)]
  unless definition
    puts "no such loop: #{name}"
    return false
  end
  checkpoint = Hiiro::ScheduleCheckpoint.for(schedule_name(name))
  puts "loop:       #{name}"
  if definition.is_a?(Hiiro::Schedule::Invalid)
    puts "config:     invalid: #{definition.error}"
  else
    puts "frequency:  #{definition.recurrence_text}"
    puts "runs:       #{definition.agent ? 'agent' : 'command'} #{definition.program.first}"
  end
  puts "schedule:   #{checkpoint&.enabled ? 'enabled' : 'not enabled'}"
  outcomes = last_outcomes(name)
  if outcomes.empty?
    puts "\n(no recorded cycles yet)"
    return true
  end
  puts "\ncycles:"
  outcomes.each { |o| puts "  #{o.finished_at}  #{o.status_text.ljust(16)} #{o.detail}" }
  latest = outcomes.find(&:completed?)
  tail = log_tail(latest)
  unless tail.empty?
    puts "\nlast completed cycle output (#{latest.log_path}):"
    tail.each { |line| puts "  #{line}" }
  end
  true
end

def cmd_list
  configs = Hiiro::Schedule::Loops.configs
  if configs.empty?
    puts '(no loops — try `h loop add`)'
    return
  end
  definitions = Hiiro::Schedule.definitions
  printf("%-14s %-10s %-8s %-16s %s\n", 'NAME', 'FREQ', 'ENABLED', 'LAST OUTCOME', 'FINISHED')
  configs.each do |name, (_path, config)|
    definition = definitions[schedule_name(name)]
    last = last_outcomes(name, limit: 1).first
    state = Hiiro::ScheduleCheckpoint.for(schedule_name(name))&.enabled ? 'yes' : 'no'
    outcome = definition.is_a?(Hiiro::Schedule::Invalid) ? 'invalid' : (last&.status_text || '-')
    printf("%-14s %-10s %-8s %-16s %s\n", name, config['frequency'] || '10m', state, outcome, last&.finished_at || '-')
    puts "  #{definition.error}" if definition.is_a?(Hiiro::Schedule::Invalid)
  end
end

def cmd_add(hiiro)
  input = Hiiro::InputFile.yaml_file(hiiro: hiiro, content: ADD_TEMPLATE, prefix: 'h-loop-add-')
  document = input.edit.document
  return warn('aborted: editor failed or nothing changed') unless document.editor_succeeded? && document.changed?
  raise Hiiro::Error, "invalid YAML: #{document.error.message}" unless document.valid?

  config = document.parsed
  raise Hiiro::Error, 'expected a YAML mapping' unless config.is_a?(Hash)

  name = config['name'].to_s.strip
  return warn('aborted: name is empty or unchanged from template') if name.empty? || name == 'my-loop'
  return warn("aborted: '#{name}' is reserved") if RESERVED.include?(name)
  return warn("aborted: loop #{name} already exists") if File.exist?(loop_dir(name))

  Hiiro::Schedule.build(schedule_name(name), Hiiro::Schedule::Loops.fields(config), source: 'h loop add')
  FileUtils.mkdir_p(loop_dir(name))
  File.write(File.join(loop_dir(name), 'config.yml'), YAML.dump(config))
  puts "added: #{name} -> #{File.join(loop_dir(name), 'config.yml')} (start it with h loop start #{name})"
ensure
  input&.cleanup
end

def cmd_rm(names)
  names.each do |name|
    unless Dir.exist?(loop_dir(name))
      warn "no such loop: #{name}"
      next
    end
    Hiiro::Schedule.disable(schedule_name(name)) if Hiiro::ScheduleCheckpoint.for(schedule_name(name))&.enabled
    FileUtils.rm_rf(loop_dir(name))
    puts "removed: #{name}"
  end
end

# ---------- render (a view of recorded outcomes) ----------

def html_escape(text) = CGI.escapeHTML(text.to_s)

def render_section(name)
  outcomes = last_outcomes(name)
  latest = outcomes.find(&:completed?)
  history = outcomes.map do |o|
    "<li><span class='badge #{html_escape(o.outcome)}'>#{html_escape(o.status_text)}</span> #{html_escape(o.finished_at)} #{html_escape(o.detail)}</li>"
  end.join
  output = log_tail(latest, lines: 60)
  body = output.empty? ? "<p class='empty'>No completed cycle yet.</p>" : "<pre>#{html_escape(output.join("\n"))}</pre>"
  <<~HTML
    <section id="loop-#{html_escape(name)}">
      <header><h2>#{html_escape(name)}</h2><span class="freshness">#{latest ? "completed #{html_escape(latest.finished_at)}" : 'no completed cycle'}</span></header>
      #{body}
      <ul class="history">#{history}</ul>
    </section>
  HTML
end

HOME_STYLES = <<~CSS
  :root { color-scheme: light dark; --bg: #f7f7f8; --fg: #1a1a1a; --muted: #6a6a72; --card: #fff; --line: #e5e5eb; --bad: #b42318; --good: #166534; }
  @media (prefers-color-scheme: dark) { :root { --bg: #0f0f11; --fg: #f0f0f2; --muted: #9aa0a6; --card: #17171b; --line: #2a2a30; --bad: #f97066; --good: #86efac; } }
  body { margin: 0; font: 15px/1.5 -apple-system, ui-sans-serif, system-ui; background: var(--bg); color: var(--fg); }
  header.top { padding: 24px 32px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: baseline; }
  header.top h1 { margin: 0; font-size: 20px; }
  main { padding: 24px 32px; display: grid; gap: 20px; max-width: 1100px; margin: 0 auto; }
  section { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px 20px; }
  section header { display: flex; justify-content: space-between; align-items: baseline; }
  section h2 { margin: 0; font-size: 16px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .freshness, .updated { color: var(--muted); font-size: 12px; }
  pre { white-space: pre-wrap; font-size: 13px; }
  .empty { color: var(--muted); font-style: italic; }
  .badge { font-size: 11px; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--bad); }
  .badge.completed { color: var(--good); }
  ul.history { padding-left: 18px; color: var(--muted); font-size: 12px; }
CSS

def cmd_render
  sections = Hiiro::Schedule::Loops.configs.keys.map { |name| render_section(name) }.join("\n")
  html = <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <title>AI Loops · home</title>
      <style>#{HOME_STYLES}</style>
    </head>
    <body>
      <header class="top"><h1>AI Loops</h1><span class="updated">rendered #{html_escape(Time.now.iso8601)} from recorded outcomes</span></header>
      <main>
        #{sections}
      </main>
    </body>
    </html>
  HTML
  FileUtils.mkdir_p(File.dirname(HOME_HTML))
  File.write(HOME_HTML, html)
  puts "rendered: #{HOME_HTML}"
end

# ---------- dispatch ----------

Hiiro.run(*ARGV) do
  add_subcmd(:list, :ls) { cmd_list }
  add_subcmd(:add)       { cmd_add(self) }
  add_subcmd(:rm)        { |*names| cmd_rm(names) }

  add_subcmd(:start) do |*names|
    loop_names(names).each do |name|
      Hiiro::Schedule.enable(loop_definition(name))
      puts "started: #{name} (schedule #{schedule_name(name)})"
    end
  end

  add_subcmd(:stop) do |*names|
    loop_names(names).each do |name|
      Hiiro::Schedule.disable(schedule_name(name))
      puts "stopped: #{name}"
    end
  end

  add_subcmd(:restart) do |*names|
    loop_names(names).each do |name|
      Hiiro::Schedule.disable(schedule_name(name))
      Hiiro::Schedule.enable(loop_definition(name))
      puts "restarted: #{name}"
    end
  end

  add_subcmd(:run) do |name = nil|
    raise Hiiro::Error, 'Usage: h loop run NAME' unless name

    result = Hiiro::Schedule.tick(loop_definition(name))
    outcome = result[:outcome]
    unless outcome
      puts "#{name}: cycle #{result[:occurrence].key} already ran"
      next
    end
    puts "#{name}: #{outcome.status_text} (#{outcome.run_id})#{outcome.detail ? ": #{outcome.detail}" : ''}"
    puts "  log #{outcome.log_path}" if outcome.log_path
    exit 1 unless %w[completed skipped-overlap].include?(outcome.outcome)
  end

  add_subcmd(:status) { |name = nil| name ? show_status(name) : cmd_list }
  add_subcmd(:render, :r) { cmd_render }
  add_subcmd(:ui) { Hiiro::JobScreen.new(definition: 'loop-', interval: Float(ENV.fetch('HIIRO_UI_REFRESH', '5'))).run }

  add_subcmd(:prs)   { show_status('prs') }
  add_subcmd(:slack) { show_status('slack') }
end
