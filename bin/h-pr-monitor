#!/usr/bin/env ruby

require 'hiiro'
require 'optparse'

options = Hiiro::PrMonitor::Options.defaults
once = false
interval = Integer(ENV.fetch('SLEEP_FOR', 60))

OptionParser.new do |opts|
  opts.banner = "Usage: h pr-monitor [options]"

  opts.on("-a", "--no-notify-approvals", "Disable notifications for approvals and change requests") { options.notify_approvals = false }
  opts.on("-s", "--no-notify-status", "Disable notifications for check status changes") { options.notify_status = false }
  opts.on("-D", "--no-notify-dependencies", "Disable notifications when every dependency has merged") { options.notify_dependencies = false }
  opts.on("-u", "--no-notify-publishing", "Disable notifications when marking a PR ready") { options.notify_publishing = false }
  opts.on("-r", "--mark-ready", "Mark a draft ready once its head's checks pass (fresh, complete snapshot)") { options.mark_ready = true }
  opts.on("-q", "--queue-fixes", "Queue one fix job per failing head revision (never launched)") { options.queue_fixes = true }
  opts.on("-t", "--tag TAG", "Only monitor tracked PRs with this tag (repeatable)") { |tag| options.tags << tag }
  opts.on("-1", "--once", "Run one cycle and exit") { once = true }
  opts.on("-i", "--interval SECONDS", Integer, "Seconds between cycles (default: SLEEP_FOR or 60)") { |seconds| interval = seconds }
  opts.on("-h", "--help", "Prints this help") do
    puts opts
    exit
  end
end.parse!

monitor = Hiiro::PrMonitor.new(manager: Hiiro::PinnedPRManager.new, options: options)
begin
  loop do
    puts "--- #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}"
    monitor.cycle
    break if once

    sleep interval
  end
rescue Interrupt
  exit 130
rescue Hiiro::Error => e
  abort "ERROR: #{e.message}"
end
