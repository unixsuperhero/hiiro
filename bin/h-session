#!/usr/bin/env ruby

require 'hiiro'
require 'tempfile'
require 'yaml'

# Compatibility command: the legacy session name maps to a Herdr workspace.
Hiiro.run(*ARGV, tasks: true, plugins: [Pins]) do
  herdr = herdr_client
  Hiiro::Herdr.add_resolvers(self)

  add_subcmd(:ls, :list) { |*args|
    args.empty? ? herdr.workspaces.each { |workspace| puts workspace } : system('herdr', 'workspace', 'list', *args)
  }

  add_subcmd(:new) { |name = nil, cwd = nil|
    herdr.new_workspace(name, start_directory: cwd, focus: true)
  }

  add_subcmd(:kill) { |ref = nil|
    ref = resolve(:session, ref)
    herdr.close_workspace(ref) if ref
  }

  add_subcmd(:attach, :switch) { |ref = nil|
    ref = resolve(:session, ref)
    herdr.focus_workspace(ref) if ref
  }

  add_subcmd(:rename) { |ref = nil, new_name = nil|
    ref = resolve(:session, ref)
    herdr.rename_workspace(ref, new_name) if ref && new_name
  }

  add_subcmd(:has) { |ref = nil|
    puts herdr.workspace_exists?(ref)
  }

  add_subcmd(:info) { |ref = nil|
    workspace = ref ? herdr.find_workspace(ref) : herdr.current_workspace
    puts(workspace || 'Workspace not found')
  }

  add_subcmd(:open) { |name = nil|
    unless name
      puts 'Usage: h session open <name>'
      next
    end
    herdr.open_workspace(name)
  }

  add_subcmd(:sh) { |workspace_ref = nil, *command|
    workspace = herdr.find_workspace(workspace_ref)
    unless workspace
      puts "Workspace '#{workspace_ref}' does not exist"
      next
    end

    herdr.new_tab(
      workspace: workspace,
      name: command.first,
      command: command.empty? ? nil : command.shelljoin,
      focus: true
    )
  }

  add_subcmd(:select) do
    selected = resolve(:session)
    print selected if selected
  end

  add_subcmd(:copy) do
    selected = resolve(:session)
    if selected
      Hiiro::Shell.pipe(selected, 'pbcopy')
      puts "Copied workspace '#{selected}' to clipboard"
    end
  end

  add_subcmd(:orphans) do
    task_workspace_names = env.all_tasks.map(&:session_name)
    orphans = herdr.workspaces.reject { |workspace| task_workspace_names.include?(workspace.name) }

    if orphans.empty?
      puts 'No orphan workspaces'
      next
    end

    puts "Orphan workspaces (#{orphans.count}):"
    orphans.each { |workspace| puts "  #{workspace.name}" }
  end

  add_subcmd(:okill) do
    task_workspace_names = env.all_tasks.map(&:session_name)
    orphans = herdr.workspaces.reject { |workspace| task_workspace_names.include?(workspace.name) }

    if orphans.empty?
      puts 'No orphan workspaces to close'
      next
    end

    tempfile = Tempfile.new(['orphan-workspaces-', '.yml'])
    tempfile.write(orphans.map(&:id).to_yaml)
    tempfile.close
    edit_files(tempfile.path)
    to_close = YAML.safe_load_file(tempfile.path) || []
    tempfile.unlink

    to_close.each do |workspace_id|
      herdr.close_workspace(workspace_id)
      puts "Closed: #{workspace_id}"
    end
  end
end
