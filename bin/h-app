#!/usr/bin/env ruby

require 'pathname'
require 'hiiro'

Hiiro.run(*ARGV) {
  app_context = ->(name = nil) do
    selected = context
    name.nil? ? selected.with_directory(selected.root_directory, source: selected.root_source) : selected.for_app(name)
  end
  nested_context = ->(native_args) do
    remaining = native_args.dup
    selected = context
    if remaining.first == '--app'
      remaining.shift
      name = remaining.shift
      raise Hiiro::Error, 'Missing app name after --app' if name.nil? || name.empty? || name.start_with?('-')
      selected = selected.for_app(name)
    end
    selected.validate!
    [selected, remaining]
  end

  add_subcmd(:show) { puts Hiiro::AppRecord.editor_projection.to_yaml }

  add_subcmd(:config, :edit) do
    puts(Hiiro::AppRecord.edit(hiiro: self) ? "Apps updated" : "No apps changed")
  rescue ArgumentError, Hiiro::Error, Sequel::ConstraintViolation => e
    warn "Apps not changed: #{e.message}"
  end

  add_subcmd(:cd) { |app_name=nil|
    selected = app_context.call(app_name).validate!
    terminal = selected.terminal
    raise Hiiro::Error, 'Not running inside a Herdr pane' unless terminal.pane_id
    client = Hiiro::Herdr.client
    terminal.validate!(client)
    client.run_in_pane(terminal.pane_id, "cd #{selected.start_directory.shellescape}")
  }

  add_subcmd(:open) { |app_name=nil|
    selected = app_context.call(app_name).validate!
    system('open', selected.start_directory)
  }

  add_subcmd(:ls, :list) {
    apps = environment.all_apps
    if apps.empty?
      puts "No apps configured."
      puts "Add one with: h app add <name> <relative_path>"
      puts "Edit saved aliases with: h app edit"
    else
      puts "Configured apps:"
      puts
      apps.each { |a| puts format("  %-20s => %s", a.name, a.relative_path) }
    end
  }

  add_subcmd(:path) { |app_name=nil|
    selected = app_context.call(app_name)
    puts Pathname.new(selected.start_directory).relative_path_from(Pathname.new(selected.invocation_directory))
  }

  add_subcmd(:abspath) { |app_name=nil|
    puts app_context.call(app_name).start_directory
  }

  add_subcmd(:add) { |app_name=nil, relative_path=nil|
    if app_name.nil? || app_name.empty? || relative_path.nil? || relative_path.empty?
      puts "Usage: h app add <app_name> <relative_path_from_root>"
      next
    end
    existing = Hiiro::AppRecord.find_by_name(app_name)
    if existing
      puts "App '#{app_name}' already exists with path: #{existing.path}"
      puts "Remove it first with: h app rm #{app_name}"
      next
    end
    Hiiro::AppRecord.create(name: app_name, path: relative_path)
    puts "Added app '#{app_name}' => #{relative_path}"
  }

  add_subcmd(:rm, :remove) { |app_name=nil|
    if app_name.nil? || app_name.empty?
      puts "Usage: h app rm <app_name>"
      next
    end
    record = Hiiro::AppRecord.find_by_name(app_name)
    unless record
      puts "App '#{app_name}' not found"
      puts
      puts "Available apps:"
      Hiiro::AppRecord.all.each { |a| puts format("  %-20s => %s", a.name, a.path) }
      next
    end
    record.destroy
    puts "Removed app '#{app_name}' (was: #{record.path})"
  }

  %w[fd rg vim].each do |tool|
    add_subcmd(tool.to_sym) { |app_name=nil, *native_args|
      selected = app_context.call(app_name).validate!
      Dir.chdir(selected.start_directory)
      exec(tool, *native_args)
    }
  end

  add_subcmd(:sh) { |app_name=nil, *native_args|
    selected = app_context.call(app_name).validate!
    Dir.chdir(selected.start_directory)
    native_args.empty? ? exec(ENV['SHELL'] || 'zsh') : exec(*native_args)
  }

  add_subcmd(:service) do |*native_args|
    selected, remaining = nested_context.call(native_args)
    sm = Hiiro::ServiceManager.new(context: selected)
    Hiiro::ServiceManager.build_hiiro(this, sm, context: selected, args: remaining).run
  end

  add_subcmd(:run) do |*native_args|
    selected, remaining = nested_context.call(native_args)
    rt = Hiiro::RunnerTool.new(context: selected)
    Hiiro::RunnerTool.build_hiiro(this, rt, context: selected, args: remaining).run
  end

  add_subcmd(:file) do |*native_args|
    selected, remaining = nested_context.call(native_args)
    af = Hiiro::AppFiles.new(context: selected)
    Hiiro::AppFiles.build_hiiro(this, af, context: selected, args: remaining).run
  end
}
