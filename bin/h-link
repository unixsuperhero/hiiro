#!/usr/bin/env ruby

require 'yaml'
require 'fileutils'
require 'time'
require 'pry'
require 'tempfile'
require "hiiro"

opts = Hiiro::Options.setup {
  option(:shorthand, short: :s, desc: 'Shorthand alias for the link')
  option(:tag, short: :t, multi: true, desc: 'Tag for the link (repeatable)')
  option(:tags, multi: true, desc: 'Tag for the link (alias for --tag, repeatable)')
}

# One registry entry of table `link`, shown the way h-link always has.
class LinkPresenter
  attr_reader :entry

  def initialize(entry)
    @entry = entry
  end

  def url         = entry.value
  def shorthand   = entry.short_name
  def description = entry.description
  def created_at  = entry.created_at
  def tags        = entry.tags

  def matches?(*terms)
    searchable = [url, description, shorthand].compact.join(' ').downcase
    terms.all? { |term| searchable.include?(term.downcase) }
  end

  def display_string(index = nil, exclude_tags: [])
    num = index ? "#{(index + 1).to_s.rjust(3)}." : ""
    shorthand_str = shorthand ? " [#{shorthand}]" : ""
    desc_str = description.to_s.empty? ? "" : " - #{description}"
    link_tags = tags - Array(exclude_tags)
    tags_str = link_tags.any? ? " " + link_tags.map { |t| "\e[30;104m#{t}\e[0m" }.join(' ') : ""
    "#{num}#{shorthand_str} #{url}#{desc_str}#{tags_str}".strip
  end

  # The links.yml row shape, used by the edit round-trip.
  def to_h
    {
      'url'         => url,
      'description' => description,
      'shorthand'   => shorthand,
      'created_at'  => created_at
    }
  end

  def to_yaml(*) = to_h.to_yaml
end

class LinkManager
  TABLE = 'link'

  def link_template
    { 'url' => '', 'description' => '', 'shorthand' => nil, 'created_at' => Time.now.iso8601 }
  end

  def dataset = Hiiro::RegistryEntry.where(resource_type: TABLE)
  def count   = Hiiro::Table.named(TABLE).count

  def hash_matches?(links_hash, *args)
    links_hash.select { |line, link| link.matches?(*args) }
  end

  def search_links(links, *args)
    links.select { |link| link.matches?(*args) }
  end

  def load_link_hash(links=nil)
    links ||= load_links

    links.each_with_index.each_with_object({}) do |(link, idx), h|
      h[link.display_string(idx)] = link
    end
  end

  def load_links
    dataset.order(:created_at, :id).all.map { |entry| LinkPresenter.new(entry) }
  end

  # Opens rows (links.yml shape) in the editor; returns the edited list of
  # string-keyed hashes, or nil when the result is empty or not valid YAML.
  def edit_rows(hiiro, rows)
    input = hiiro.yaml_input_file(content: rows.to_yaml, prefix: 'link-edit-')
    doc = input.edit.document
    input.cleanup
    return nil if !doc.valid? || doc.empty?

    Array(doc.parsed).select { |row| row.is_a?(Hash) }.map { |row| row.transform_keys(&:to_s) }
  end

  # Creates or updates the entry holding row['url']. Keys absent from row keep their stored values.
  def save_row(row)
    url = row['url'].to_s
    shorthand = row['shorthand'].to_s.empty? ? nil : row['shorthand'].to_s
    fields = {}
    fields[:short_name] = shorthand if row.key?('shorthand')
    fields[:description] = row['description'].to_s if row.key?('description')
    fields[:created_at] = row['created_at'].to_s if row['created_at']

    entry = dataset.where(value: url).first
    if entry
      entry.update(fields)
    else
      entry = Hiiro::RegistryEntry.create(
        fields.merge(
          resource_type: TABLE,
          name:          Hiiro::DB.link_name(url, shorthand, fields[:description]),
          description:   fields[:description].to_s,
          value:         url,
          created_at:    fields[:created_at] || Time.now.iso8601
        )
      )
    end
    entry
  end

  # Writes the edited rows back by url, deleting links from `previous` whose url is gone.
  def apply_rows(rows, previous)
    rows.each { |row| save_row(row) }
    kept = rows.map { |row| row['url'].to_s }
    previous.reject { |link| kept.include?(link.url) }.each { |link| delete(link) }
  end

  def delete(link)
    Hiiro::Tag.where(taggable_type: 'RegistryEntry', taggable_id: link.entry.id.to_s).delete
    link.entry.destroy
  end

  def extract_placeholders(url)
    Hiiro::URLTemplate.new(url).placeholders
  end

  def has_placeholders?(url)
    Hiiro::URLTemplate.new(url).placeholders?
  end

  def prompt_for_placeholder_values(url, link=nil)
    placeholders = extract_placeholders(url)
    return {} if placeholders.empty?

    # Create a YAML template with placeholder names as keys
    template = placeholders.each_with_object({}) { |name, hash| hash[name] = '' }

    tmpfile = Tempfile.new(['link-params-', '.yml'])

    # Add the link as YAML comments if provided
    if link
      link_yaml = link.to_yaml
      link_yaml.each_line do |line|
        tmpfile.puts("# #{line.chomp}")
      end
      tmpfile.puts("#")
      tmpfile.puts("# Fill in placeholder values below:")
      tmpfile.puts("#")
    end

    tmpfile.write(template.to_yaml)
    tmpfile.close

    editor = ENV['EDITOR'] || 'safe_nvim' || 'nvim'
    system(editor, tmpfile.path)

    values = YAML.load_file(tmpfile.path) || {}
    tmpfile.unlink

    values
  end

  def substitute_placeholders(url, values)
    Hiiro::URLTemplate.new(url, values: values).url
  end

  def find_link_by_ref(ref, links)
    if ref =~ /^\d+$/
      idx = ref.to_i - 1
      return [idx, links[idx]] if idx >= 0 && idx < links.length
    else
      links.each_with_index do |link, idx|
        return [idx, link] if link.shorthand == ref
      end
    end
    [nil, nil]
  end
end

lm = LinkManager.new

Hiiro.run(*ARGV, plugins: [Pins]) do
  add_subcmd(:add) do |*add_args|
    vals = opts.parse!(add_args)

    if vals.help?
      puts "Usage: h link add [<url>] [description] [--shorthand <alias>] [--tag <tag> ...]"
      puts
      puts opts.help_text
      exit 0
    end

    if vals.args.empty?
      new_rows = lm.edit_rows(self, [lm.link_template])
      if new_rows.nil?
        puts "ERROR: Unable to read updated file."
        exit 1
      end

      new_rows.each { |row| lm.save_row(row) }

      if new_rows.length == 1
        puts "Saved link ##{lm.count}: #{new_rows.first['url']}"
      else
        puts "Saved #{new_rows.length} links"
      end
      exit 0
    end

    url = vals.args.shift
    description = vals.args.join(' ')
    tags = (Array(vals.tag) + Array(vals.tags)).uniq.reject(&:empty?)

    entry = lm.save_row({ 'url' => url, 'description' => description, 'shorthand' => vals.shorthand }.reject { |_, v| v.to_s.empty? })
    entry.tag(*tags) if tags.any?

    puts "Saved link ##{lm.count}: #{url}"
  end

  add_subcmd(:ls) do |*ls_args|
    links = lm.load_links
    if links.empty?
      puts "No links saved."
    else
      links.each_with_index do |link, idx|
        puts link.display_string(idx)
      end
    end
  end

  add_subcmd(:list) do |*list_args|
    run_subcmd(:ls, *list_args)
  end

  add_subcmd(:search) do |*search_args|
    if search_args.empty?
      puts "Usage: h link search <term> [term...]"
      exit 1
    end

    links = lm.load_links
    matches = links.each_with_index.select { |link, idx| link.matches?(*search_args) }

    if matches.empty?
      puts "No links found matching: #{search_args.join(' ')}"
    else
      matches.each do |link, idx|
        puts link.display_string(idx)
      end
    end
  end

  add_subcmd(:select) do |*select_args|
    links = lm.load_links

    if links.empty?
      STDERR.puts "No links saved."
      exit 1
    end

    lines = lm.load_link_hash(links)

    if select_args.any?
      lines = lm.hash_matches?(lines, *select_args)
    end

    selected = fuzzyfind(lines.keys)

    if !selected.strip.empty?
      link = lines[selected.strip]
      if link
        url = link.url

        if lm.has_placeholders?(url)
          values = lm.prompt_for_placeholder_values(url, link)
          url = lm.substitute_placeholders(url, values)
        end

        puts url
      end
    end
  end

  add_subcmd(:copy) do |*copy_args|
    links = lm.load_links

    if links.empty?
      STDERR.puts "No links saved."
      next
    end

    lines = lm.load_link_hash(links)

    if copy_args.any?
      lines = lm.hash_matches?(lines, *copy_args)
    end

    selected = fuzzyfind(lines.keys)

    if !selected.strip.empty?
      link = lines[selected.strip]
      if link
        url = link.url

        if lm.has_placeholders?(url)
          values = lm.prompt_for_placeholder_values(url, link)
          url = lm.substitute_placeholders(url, values)
        end

        Hiiro::Shell.pipe(url, 'pbcopy')
        puts "Copied URL '#{url}' to clipboard"
      end
    end
  end

  add_subcmd(:editall) do |*editall_args|
    links_before = lm.load_links
    rows = lm.edit_rows(self, links_before.map(&:to_h))

    if rows.nil?
      puts "ERROR: Unable to read updated file...reverting."
      next
    end

    lm.apply_rows(rows, links_before)
  end

  add_subcmd(:edit) do |*edit_args|
    if edit_args.empty?
      puts "Usage: h link edit <number|shorthand>"
      exit 1
    end

    links = lm.load_links
    idx, link = lm.find_link_by_ref(edit_args.first, links)

    if link.nil?
      puts "Link not found: #{edit_args.first}"
      exit 1
    end

    updated_rows = lm.edit_rows(self, [link.to_h])

    if updated_rows.nil? || updated_rows.empty?
      puts "ERROR: Unable to read updated file...reverting."
      exit 1
    end

    lm.apply_rows(updated_rows, [link])

    if updated_rows.length == 1
      puts "Updated link ##{idx + 1}"
    else
      puts "Updated link ##{idx + 1} and added #{updated_rows.length - 1} more"
    end
  end

  add_subcmd(:rm) do |*rm_args|
    links = lm.load_links

    if links.empty?
      puts "No links saved."
      exit 0
    end

    if rm_args.empty?
      lines = lm.load_link_hash(links)
      selected = fuzzyfind(lines.keys)
      next if selected.nil? || selected.strip.empty?
      link = lines[selected.strip]
      next unless link
      lm.delete(link)
      puts "Removed: #{link.url}"
    else
      rm_args.each do |ref|
        idx, link = lm.find_link_by_ref(ref, links)
        if link.nil?
          # Try URL substring match
          matches = lm.search_links(links, ref)
          if matches.length == 1
            link = matches.first
          elsif matches.length > 1
            puts "Ambiguous: #{matches.length} links match '#{ref}'. Use a number or shorthand."
            matches.each_with_index { |l, i| puts "  #{l.display_string(i)}" }
            next
          else
            puts "Link not found: #{ref}"
            next
          end
        end
        lm.delete(link)
        puts "Removed: #{link.url}"
      end
    end
  end

  add_subcmd(:remove) do |*remove_args|
    run_subcmd(:rm, *remove_args)
  end

  add_subcmd(:open) do |*open_args|
    links = lm.load_links

    if open_args.empty?
      lines = lm.load_link_hash(links)

      exit_code = 1

      if open_args.any?
        lines = lm.hash_matches?(lines, *open_args)
      end

      selected = fuzzyfind(lines.keys)

      if !selected.strip.empty?
        link = lines[selected.strip]
        if link
          url = link.url

          if lm.has_placeholders?(url)
            values = lm.prompt_for_placeholder_values(url, link)
            url = lm.substitute_placeholders(url, values)
          end

          system('open', url)
          exit_code = 0
        end
      end

      exit exit_code
    end

    idx, link = lm.find_link_by_ref(open_args.first, links)

    if link.nil?
      matches = lm.search_links(links, *open_args)

      if matches.count == 1
        link = matches.first
      end
    end

    if link.nil?
      puts "Link not found: #{open_args.first}"
      exit 1
    end

    url = link.url

    if lm.has_placeholders?(url)
      values = lm.prompt_for_placeholder_values(url, link)
      url = lm.substitute_placeholders(url, values)
    end

    system('open', url)
  end

  add_subcmd(:tags) do |*tag_args|
    by_id = lm.load_links.to_h { |link| [link.entry.id.to_s, link] }
    link_tags = Hiiro::Tag.where(taggable_type: 'RegistryEntry', taggable_id: by_id.keys)
    names = link_tags.select_map(:name).uniq.sort

    Hiiro::Tag.filter(tag_args, names).each do |tag|
      puts "#{tag}:"
      link_tags.where(name: tag).select_map(:taggable_id).each do |id|
        puts "  #{by_id[id].display_string(exclude_tags: [tag])}"
      end
    end.empty? && puts("No tags found!")
  end

  add_subcmd(:paste) do |*paste_args|
    url = `pbpaste`.strip

    if url.empty?
      puts "Clipboard is empty."
      exit 1
    end

    vals = opts.parse!(paste_args)
    description = vals.args.join(' ')
    tags = (Array(vals.tag) + Array(vals.tags)).uniq.reject(&:empty?)

    entry = lm.save_row({ 'url' => url, 'description' => description, 'shorthand' => vals.shorthand }.reject { |_, v| v.to_s.empty? })
    entry.tag(*tags) if tags.any?

    puts "Saved link ##{lm.count}: #{url}"
  end

  add_subcmd(:path) do |*path_args|
    print "#{Hiiro::DB::DB_FILE} (table link)"
  end
end
