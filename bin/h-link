#!/usr/bin/env ruby

require 'yaml'
require 'time'
require 'pry'
require "hiiro"

opts = Hiiro::Options.setup {
  option(:shorthand, short: :s, desc: 'Shorthand alias for the link')
  option(:tag, short: :t, multi: true, desc: 'Tag for the link (repeatable)')
  option(:tags, multi: true, desc: 'Tag for the link (alias for --tag, repeatable)')
}

# One saved link: a RegistryEntry of table `link` (url → value, shorthand →
# short_name, description, created_at) read through the link vocabulary.
class LinkPresenter
  attr_reader :entry

  def initialize(entry)
    @entry = entry
  end

  def id          = entry.id
  def url         = entry.value
  def shorthand   = entry.short_name
  def description = entry.description
  def created_at  = entry.created_at
  def tags        = entry.tags

  def matches?(*terms)
    searchable = [url, description, shorthand].compact.join(' ').downcase
    terms.all? { |term| searchable.include?(term.downcase) }
  end

  def display_string(index = nil, exclude_tags: [])
    num = index ? "#{(index + 1).to_s.rjust(3)}." : ""
    shorthand_str = shorthand ? " [#{shorthand}]" : ""
    desc_str = description.to_s.empty? ? "" : " - #{description}"
    link_tags = tags - Array(exclude_tags)
    tags_str = link_tags.any? ? " " + link_tags.map { |t| "\e[30;104m#{t}\e[0m" }.join(' ') : ""
    "#{num}#{shorthand_str} #{url}#{desc_str}#{tags_str}".strip
  end

  # The edit row shape: the stable entry id plus the links.yml fields.
  def to_h
    {
      'id'          => id,
      'url'         => url,
      'description' => description,
      'shorthand'   => shorthand,
      'created_at'  => created_at
    }
  end

  def to_yaml(*) = to_h.to_yaml
end

class LinkManager
  TABLE = 'link'
  LINK_TEMPLATE = {
    'url' => '',
    'description' => '',
    'shorthand' => nil,
    'created_at' => Time.now.iso8601,
  }
  # Edit-row field → registry column.
  COLUMNS = { 'url' => :value, 'description' => :description, 'shorthand' => :short_name, 'created_at' => :created_at }.freeze

  def dataset = Hiiro::RegistryEntry.where(resource_type: TABLE)
  def count   = dataset.count

  def search_links(links, *args)
    links.select { |link| link.matches?(*args) }
  end

  def load_links
    dataset.order(:created_at, :id).all.map { |entry| LinkPresenter.new(entry) }
  end

  def find(id) = dataset.where(id: id).first

  # Creates the registry row for a link; the entry name is derived like the
  # legacy import (shorthand, else description, else the url).
  def create(url:, description: '', shorthand: nil, created_at: nil, tags: [])
    shorthand = nil if shorthand.to_s.empty?
    entry = Hiiro::RegistryEntry.create(
      resource_type: TABLE,
      name:          Hiiro::DB.link_name(url, shorthand, description),
      value:         url,
      short_name:    shorthand,
      description:   description.to_s,
      created_at:    created_at || Time.now.iso8601
    )
    entry.tag(*tags) if tags.any?
    LinkPresenter.new(entry)
  end

  def delete(link)
    entry = link.respond_to?(:entry) ? link.entry : link
    Hiiro::Tag.where(taggable_type: 'RegistryEntry', taggable_id: entry.id.to_s).delete
    entry.destroy
  end

  def edit_links(links = nil, hiiro:)
    selected = links.nil? ? [] : Array(links)
    baseline = selected.to_h { |link| [link.id, { values: link.entry.values.dup, tags: Hiiro::Tag.for(link.entry).order(:id).map { |tag| tag.values.dup } }] }
    rows = links.nil? ? [LINK_TEMPLATE] : selected.map(&:to_h)
    input = Hiiro::InputFile.yaml_file(hiiro: hiiro, content: rows.to_yaml, prefix: 'link-edit-')
    document = input.edit.document
    raise Hiiro::Error, document.error.message unless document.editor_succeeded?
    return nil if document.empty? || !document.changed?
    begin
      raise Hiiro::Error, document.error.message unless document.valid?
      parsed = document.data
      apply_edit(parsed.is_a?(Hash) ? [parsed] : parsed, baseline: baseline)
    rescue Hiiro::Error => e
      raise Hiiro::Error, "#{e.message}; links unchanged, edited text kept at #{input.keep}"
    end
  ensure
    input&.cleanup
  end

  def apply_edit(rows, baseline:)
    raise Hiiro::Error, 'Links must be an array of records' unless rows.is_a?(Array)
    fields = COLUMNS.keys
    ids = []
    rows.each do |row|
      raise Hiiro::Error, 'Each link must be a record' unless row.is_a?(Hash)
      raise Hiiro::Error, 'Unknown link fields' unless (row.keys - fields - ['id']).empty?
      fields.each do |field|
        next unless row.key?(field)
        raise Hiiro::Error, "Invalid link #{field}" unless row[field].nil? || row[field].is_a?(String)
      end
      if row.key?('url') || !row.key?('id')
        raise Hiiro::Error, 'A link needs a URL' unless row['url'].is_a?(String) && !row['url'].strip.empty?
      end
      next unless row.key?('id')
      id = row['id']
      raise Hiiro::Error, 'Unknown or duplicate link ID' unless id.is_a?(Integer) && baseline.key?(id) && !ids.include?(id)
      ids << id
    end
    Hiiro::RegistryEntry.db.transaction(mode: :immediate) do
      (baseline.keys - ids).each do |id|
        current = find(id)
        next unless current
        before = baseline.fetch(id)
        tags = Hiiro::Tag.for(current).order(:id).map(&:values)
        raise Hiiro::Error, "Link ##{id} changed before deletion" unless current.values == before[:values] && tags == before[:tags]
        delete(current)
      end
      rows.map do |row|
        attrs = row.reject { |key, _| key == 'id' }.to_h { |key, value| [COLUMNS.fetch(key), value] }
        unless row.key?('id')
          next create(url: attrs[:value], description: attrs[:description] || '', shorthand: attrs[:short_name], created_at: attrs[:created_at])
        end
        id = row.fetch('id')
        before = baseline.fetch(id)[:values]
        changes = attrs.reject { |key, value| value == before[key] }
        current = find(id)
        next LinkPresenter.new(current) if changes.empty?
        raise Hiiro::Error, "Link ##{id} was removed" unless current
        changes.each do |key, value|
          raise Hiiro::Error, "Link ##{id} #{COLUMNS.key(key)} changed concurrently" unless current[key] == before[key] || current[key] == value
          current[key] = value
        end
        current.save_changes
        LinkPresenter.new(current)
      end
    end
  end

  def extract_placeholders(url)
    Hiiro::URLTemplate.new(url).placeholders
  end

  def has_placeholders?(url)
    Hiiro::URLTemplate.new(url).placeholders?
  end

  # Values for the URL's {placeholders}, edited as YAML. nil when the editor
  # failed or left the template unchanged; invalid YAML or fields raise with
  # the edited text kept.
  def prompt_for_placeholder_values(url, link = nil, hiiro:)
    placeholders = extract_placeholders(url)
    return {} if placeholders.empty?

    header = link ? link.to_h.to_yaml.lines.map { |line| "# #{line}" }.join + "#\n# Fill in placeholder values below:\n#\n" : ''
    template = header + placeholders.to_h { |name| [name, ''] }.to_yaml
    input = Hiiro::InputFile.yaml_file(hiiro: hiiro, content: template, prefix: 'link-params-')
    document = input.edit.document
    return nil unless document.editor_succeeded? && document.changed?

    values = document.data
    error = document.error&.message ||
            ('Placeholder values must be a mapping' unless values.is_a?(Hash)) ||
            ("Unknown placeholders: #{(values.keys.map(&:to_s) - placeholders).join(', ')}" unless (values.keys.map(&:to_s) - placeholders).empty?) ||
            ('Placeholder values must be text or numbers' unless values.values.all? { |v| v.nil? || v.is_a?(String) || v.is_a?(Numeric) })
    raise Hiiro::Error, "#{error}; edited text kept at #{input.keep}" if error

    values.to_h { |key, value| [key.to_s, value.to_s] }
  ensure
    input&.cleanup
  end

  # The link's URL with placeholders filled; nil when the prompt was cancelled.
  def expand(link, hiiro:)
    return link.url unless has_placeholders?(link.url)

    values = prompt_for_placeholder_values(link.url, link, hiiro: hiiro)
    values && substitute_placeholders(link.url, values)
  end

  def items(links)
    links.each_with_index.map do |link, idx|
      Hiiro::Selection::Item.new(id: "link:#{link.id}", title: link.display_string(idx), open_target: link.url, copy_text: link.url, record: link)
    end
  end

  # Links matching every term, numbered as in `h link ls`, offered to the
  # picker; the chosen original link, or nil when none match or it was cancelled.
  def pick(links, *terms)
    offered = items(links).select { |item| item.record.matches?(*terms) }
    Hiiro::Selection.pick(offered, picker: 'links', tty: true)&.record
  end

  def substitute_placeholders(url, values)
    Hiiro::URLTemplate.new(url, values: values).url
  end

  def find_link_by_ref(ref, links)
    if ref =~ /^\d+$/
      idx = ref.to_i - 1
      return [idx, links[idx]] if idx >= 0 && idx < links.length
    else
      links.each_with_index do |link, idx|
        return [idx, link] if link.shorthand == ref
      end
    end
    [nil, nil]
  end
end

lm = LinkManager.new

Hiiro.run(*ARGV, plugins: [:Pins]) do
  add_subcmd(:add) do |*add_args|
    vals = opts.parse!(add_args)

    if vals.help?
      puts "Usage: h link add [<url>] [description] [--shorthand <alias>] [--tag <tag> ...]"
      puts
      puts opts.help_text
      exit 0
    end

    if vals.args.empty?
      new_links = lm.edit_links(hiiro: self)
      next unless new_links

      count = lm.count
      if new_links.length == 1
        puts "Saved link ##{count}: #{new_links.first.url}"
      else
        puts "Saved #{new_links.length} links"
      end
      exit 0
    end

    url = vals.args.shift
    description = vals.args.join(' ')
    tags = (Array(vals.tag) + Array(vals.tags)).uniq.reject(&:empty?)

    lm.create(url: url, description: description, shorthand: vals.shorthand, tags: tags)

    puts "Saved link ##{lm.count}: #{url}"
  end

  add_subcmd(:ls) do |*ls_args|
    links = lm.load_links
    if links.empty?
      puts "No links saved."
    else
      links.each_with_index do |link, idx|
        puts link.display_string(idx)
      end
    end
  end

  add_subcmd(:list) do |*list_args|
    run_subcmd(:ls, *list_args)
  end

  add_subcmd(:search) do |*search_args|
    if search_args.empty?
      puts "Usage: h link search <term> [term...]"
      exit 1
    end

    links = lm.load_links
    matches = links.each_with_index.select { |link, idx| link.matches?(*search_args) }

    if matches.empty?
      puts "No links found matching: #{search_args.join(' ')}"
    else
      matches.each do |link, idx|
        puts link.display_string(idx)
      end
    end
  end

  # URL of the link picked from those matching terms, placeholders filled.
  # Exits 1 when nothing is saved or matches, or the pick or prompt is cancelled.
  picked_url = lambda do |terms|
    links = lm.load_links
    abort 'No links saved.' if links.empty?
    abort "Link not found: #{terms.join(' ')}" unless links.any? { |link| link.matches?(*terms) }
    link = lm.pick(links, *terms)
    abort 'No link selected.' unless link
    url = lm.expand(link, hiiro: self)
    abort 'Cancelled.' unless url
    url
  rescue Hiiro::Error => e
    abort e.message
  end

  add_subcmd(:select) do |*select_args|
    puts picked_url.call(select_args)
  end

  add_subcmd(:copy) do |*copy_args|
    url = picked_url.call(copy_args)
    abort "Could not copy '#{url}' to the clipboard" unless Hiiro::Selection.copy_text(url)
    puts "Copied URL '#{url}' to clipboard"
  end

  add_subcmd(:editall) do |*editall_args|
    updated_links = lm.edit_links(lm.load_links, hiiro: self)
    puts "Saved link edits" if updated_links
  end

  add_subcmd(:edit) do |*edit_args|
    if edit_args.empty?
      puts "Usage: h link edit <number|shorthand>"
      exit 1
    end

    links = lm.load_links
    idx, link = lm.find_link_by_ref(edit_args.first, links)

    if link.nil?
      puts "Link not found: #{edit_args.first}"
      exit 1
    end

    updated_links = lm.edit_links([link], hiiro: self)
    next unless updated_links
    if updated_links.empty?
      puts "Removed link ##{idx + 1}"
    elsif updated_links.length == 1
      puts "Updated link ##{idx + 1}"
    else
      puts "Updated link ##{idx + 1} and added #{updated_links.length - 1} more"
    end
  end

  add_subcmd(:rm) do |*rm_args|
    links = lm.load_links

    if links.empty?
      puts "No links saved."
      exit 0
    end

    if rm_args.empty?
      link = lm.pick(links)
      next unless link
      lm.delete(link)
      puts "Removed: #{link.url}"
    else
      rm_args.each do |ref|
        idx, link = lm.find_link_by_ref(ref, links)
        if link.nil?
          # Try URL substring match
          matches = lm.search_links(links, ref)
          if matches.length == 1
            link = matches.first
          elsif matches.length > 1
            puts "Ambiguous: #{matches.length} links match '#{ref}'. Use a number or shorthand."
            matches.each_with_index { |l, i| puts "  #{l.display_string(i)}" }
            next
          else
            puts "Link not found: #{ref}"
            next
          end
        end
        lm.delete(link)
        puts "Removed: #{link.url}"
      end
    end
  end

  add_subcmd(:remove) do |*remove_args|
    run_subcmd(:rm, *remove_args)
  end

  # A number or shorthand opens that link; other terms open the single match
  # or offer the matches to the picker.
  add_subcmd(:open) do |*open_args|
    _, link = lm.find_link_by_ref(open_args.first, lm.load_links) if open_args.any?
    url = if link
      begin
        lm.expand(link, hiiro: self) || abort('Cancelled.')
      rescue Hiiro::Error => e
        abort e.message
      end
    else
      picked_url.call(open_args)
    end

    exit 1 unless Hiiro::Selection.open_target(url)
  end

  add_subcmd(:tags) do |*tag_args|
    by_id = lm.load_links.to_h { |link| [link.id.to_s, link] }
    link_tags = Hiiro::Tag.where(taggable_type: 'RegistryEntry', taggable_id: by_id.keys)
    names = link_tags.select_map(:name).uniq.sort
    names = names.select { |name| tag_args.any? { |term| name.include?(term) } } unless tag_args.empty?

    names.each do |tag|
      puts "#{tag}:"
      link_tags.where(name: tag).select_map(:taggable_id).uniq.each do |id|
        puts "  #{by_id[id].display_string(exclude_tags: [tag])}"
      end
    end.empty? && puts("No tags found!")
    true
  end

  add_subcmd(:paste) do |*paste_args|
    clip = Hiiro::Clipboard.text
    url = clip.ok? ? clip.bytes.force_encoding('UTF-8').strip : ''

    if url.empty?
      puts(clip.ok? || clip.status == :empty_clipboard ? "Clipboard is empty." : clip.detail)
      exit 1
    end

    vals = opts.parse!(paste_args)
    description = vals.args.join(' ')
    tags = (Array(vals.tag) + Array(vals.tags)).uniq.reject(&:empty?)

    lm.create(url: url, description: description, shorthand: vals.shorthand, tags: tags)

    puts "Saved link ##{lm.count}: #{url}"
  end

  add_subcmd(:path) do |*path_args|
    print "#{Hiiro::DB::DB_FILE} (table link)"
  end
end
