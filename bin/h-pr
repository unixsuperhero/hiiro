#!/usr/bin/env ruby

require "hiiro"
require "time"
require "fileutils"
require "yaml"
require "json"

Hiiro.run(*ARGV, plugins: [:Pins]) do
  pm = pinned_manager = Hiiro::PinnedPRManager.new
  Hiiro::PinnedPRManager.add_resolvers(self)

  # Set by `h cpr`: the current branch's PR, qualified in the selected
  # directory. A command that takes one PR uses it in place of that argument,
  # so the rest of its argv keeps its own grammar.
  current_target = ENV.delete('HIIRO_PR_CURRENT')&.then do |text|
    Hiiro::PullRequestReference.qualified(text) || abort("ERROR: HIIRO_PR_CURRENT is not owner/name#N: #{text}")
  end
  split_target = ->(args) { current_target ? [current_target.to_s, args] : [args.first, args.drop(1)] }

  actions = Hiiro::PrActions.new(manager: pm, resolver: ->(text) { pm.lookup_reference(resolve(:pr, text)) },
                                 queue: -> { Hiiro::Queue.current(self) })

  # One PR argument: as given, or the current branch's PR and/or a pick from
  # the tracked PRs when omitted. [] when nothing was picked.
  one_target = ->(ref, default: :pick) {
    next [ref] if ref
    if default == :current_or_pick
      current = pm.fetch_current_branch_pr
      next [current.reference.to_s] if current
    end
    [resolve(:pr, nil)].compact
  }

  # Exits 1 unless every target succeeded.
  run_action = ->(name, targets, params = {}) {
    outcomes = actions.perform(Hiiro::PrActions::Request.new(name: name, params: params, targets: targets))
    exit 1 unless outcomes.all?(&:ok)
    true
  }

  no_extra_args = ->(name, rest) {
    raise Hiiro::Error, "#{name}: unexpected argument(s) #{rest.join(' ')}" if rest.any?
  }

  edit_pr_records = -> {
    prs = pinned_manager.load_pinned
    baseline = pinned_manager.edit_baseline(prs)
    input = yaml_input_file(content: pinned_manager.edit_rows(prs).to_yaml, prefix: 'pr-records-')
    begin
      input.edit
      document = input.document
      if !document.valid?
        puts "Aborted: #{document.error.message}"
      elsif document.changed? && !document.empty?
        pinned_manager.apply_edits(document.parsed, baseline: baseline)
        puts 'Updated tracked PR records.'
      end
    rescue Hiiro::Error => e
      puts "Aborted: #{e.message}"
    ensure
      input.cleanup
    end
  }

  # Foreground waiting: native `gh pr checks` on this terminal, qualified by
  # URL. The exit status is gh's own; a nonzero exit is called failing only
  # when a snapshot shows a failed check, never for an error or interruption.
  watch_block = ->(*all_args) {
    opts = Hiiro::Options.setup {
      option(:select, short: :s, type: :flag, desc: 'Select PR via fuzzyfinder')
    }.parse(all_args)
    ref, extra = split_target.(opts.args)
    text = opts.select ? resolve(:pr, nil) : (ref && resolve(:pr, ref))
    next puts('No PR selected') if opts.select && text.nil?

    reference = pm.lookup_reference(text)
    argv = ['gh', 'pr', 'checks', reference.url]
    argv << '--watch' if get_value(:watch)
    argv << '--fail-fast' if get_value(:fail_fast)
    outcome = Hiiro::Shell.foreground(Hiiro::CommandSpecification.new(*argv, *extra))
    if outcome.signal == 'INT' || outcome.exit_code == 130
      puts "#{reference}: interrupted"
      exit 130
    end

    title = pm.find(reference)&.title
    verdict = if outcome.success? then 'passed'
              elsif outcome.exit_code == 8 then 'pending'
              else
                observed = pm.fetcher.fetch([reference]).fetch(reference)
                if observed.is_a?(Hiiro::PrSnapshot)
                  title ||= observed.fields['title']
                  summary = Hiiro::CheckSummary.from_rollup(observed.checks.nodes, truncated: !observed.checks.complete,
                                                            freeze_active: pm.code_freeze_active?)
                  summary&.red? ? 'failing' : 'unknown'
                else
                  'unknown'
                end
              end
    puts "#{reference}: checks #{verdict} (gh #{outcome})"
    Hiiro::Notification.deliver(['-t', "PR checks #{verdict}", '-m', [reference.to_s, title].compact.join(': '), '-l', reference.url])
    exit outcome.shell_code
  }

  add_subcmd(:check, &watch_block)
  add_subcmd(:watch, watch: true, &watch_block)
  add_subcmd(:fwatch, watch: true, fail_fast: true, &watch_block)

  add_flag(:verbose, short: :v, desc: 'verbose output')
  add_cmd(:tst, args: [:a], opts: [:verbose]) do |*x|
    puts x: x
    puts 'test'
  end

  add_subcmd(:number) { |*args|
    print Hiiro::Git::Pr.current.number
  }

  add_subcmd(:link) { |*args|
    ref, = split_target.(args)
    text = resolve(:pr, ref)
    next unless text

    print pm.lookup_reference(text).url
  }

  add_subcmd(:edit) { edit_files(__FILE__) }

  add_subcmd(:open) { |*refs|
    refs = [current_target.to_s] if current_target
    targets = refs.empty? ? one_target.(nil, default: :current_or_pick) : refs
    next puts('No PR selected') if targets.empty?
    run_action.('open', actions.targets(targets))
  }

  add_subcmd(:view) { |*args|
    ref, rest = split_target.(args)
    no_extra_args.('view', rest)
    targets = one_target.(ref, default: :current_or_pick)
    next puts('No PR selected') if targets.empty?
    run_action.('view', actions.targets(targets))
  }

  add_subcmd(:select) do |*args|
    # Get my open PRs
    output = `gh pr list --author @me --state open --json number,title,headRefName 2>/dev/null`.strip

    if output.empty?
      STDERR.puts "No open PRs found"
      next
    end

    prs = (JSON.parse(output) rescue []).map { |data| Hiiro::Git::Pr.from_gh_json(data) }
    if prs.empty?
      STDERR.puts "No open PRs found"
      next
    end

    lines = prs.each_with_object({}) do |pr, h|
      display = "##{pr.number} [#{pr.head_branch}] #{pr.title}"
      h[display] = pr.number.to_s
    end

    selected = fuzzyfind_from_map(lines)
    print selected if selected
  end

  add_subcmd(:copy) do |*args|
    output = `gh pr list --author @me --state open --json number,title,headRefName 2>/dev/null`.strip

    if output.empty?
      STDERR.puts "No open PRs found"
      next
    end

    prs = (JSON.parse(output) rescue []).map { |data| Hiiro::Git::Pr.from_gh_json(data) }
    if prs.empty?
      STDERR.puts "No open PRs found"
      next
    end

    lines = prs.each_with_object({}) do |pr, h|
      display = "##{pr.number} [#{pr.head_branch}] #{pr.title}"
      h[display] = pr.number.to_s
    end

    selected = fuzzyfind_from_map(lines)

    if selected
      Hiiro::Shell.pipe(selected, 'pbcopy')
      puts "Copied PR ##{selected} to clipboard"
    end
  end

  # === PR Tracking ===

  add_subcmd(:track) do |ref = nil|
    ref ||= current_target&.to_s
    reference = if ref.nil? || ref == '-'
      # Current branch's PR first, then a fuzzy pick from your open PRs
      current = pinned_manager.fetch_current_branch_pr
      if current
        current.reference
      else
        my_prs = pinned_manager.fetch_my_prs
        next puts "No open PRs found" if my_prs.empty?

        lines = my_prs.each_with_object({}) do |pr, h|
          h["#{pr.reference} [#{pr.head_branch}] #{pr.title}"] = pr.reference
        end
        selected = fuzzyfind_from_map(lines)
        next puts "No PR selected" unless selected
        selected
      end
    else
      pinned_manager.lookup_reference(ref)
    end

    local = {}
    env = Environment.current rescue nil
    if env
      task = env.task
      local[:task]            = task.name      if task
      local[:worktree]        = task.tree_name if task&.tree_name
      local[:herdr_workspace] = env.session&.name
    end

    record, outcome = pinned_manager.track(reference, **local)
    next puts "Already tracking #{reference}" if outcome == :already

    report = pinned_manager.refresh([record], force: true)
    record.refresh
    puts "Now tracking #{reference}: #{record.title}"
    report.failed.each { |_, error| puts "  snapshot #{record.freshness}: #{error}" }
    puts
    run_subcmd(:update)
  end

  print_refresh_problems = ->(report) {
    report.incomplete.each { |pr, error| puts "  incomplete #{pr.reference}: #{error}" }
    report.failed.each { |pr, error| puts "  refresh failed #{pr.reference}: #{error}" }
    report.unqualified.each { |pr, error| puts "  not refreshed id #{pr.id} #{pr.reference}: #{error}" }
  }

  add_subcmd(:ls) do |*ls_args|
    opts = Hiiro::Options.parse(ls_args) { |o|
      o.flag(:update,   short: 'u', desc: 'update status before listing')
      o.flag(:verbose,  short: 'v', desc: 'multi-line output per PR')
      o.flag(:checks,   short: 'C', desc: 'show individual check run details')
      o.flag(:diff,     short: 'd', desc: 'open diff for selected PR')
      o.flag(:all,      short: 'a', desc: 'show all tracked PRs (no filter)')
      pm.add_options(o)
      o.mutual_exclusion(:all, :active, :merged, :drafts, :red, :green, :pending, :conflicts)
    }

    if opts.help
      puts opts.help_text
      exit 1
    end

    pinned = pinned_manager.load_pinned
    next puts "No tracked PRs" if pinned.empty?

    report = pinned_manager.refresh(pinned, force: opts.update)
    pinned = pinned_manager.load_pinned
    print_refresh_problems.call(report)

    results = pinned_manager.apply_filters(pinned, opts)

    if results.empty?
      puts pinned_manager.filter_active?(opts) ? "No PRs match filters." : "No tracked PRs."
      next
    end

    if opts.diff
      lines = results.each_with_index.each_with_object({}) do |(pr, idx), h|
        key = pinned_manager.strip_ansi(pinned_manager.display_pinned(pr, idx, oneline: true))
        h[key] = pinned_manager.reference_text(pr)
      end
      pr_number = fuzzyfind_from_map(lines)
      run_action.('diff', actions.targets([pr_number])) if pr_number
      next
    end

    if opts.numbers
      results.each { |pr| puts pr.number }
    else
      slot_w  = results.map { |pr| (pr.slot || 1).to_s.length }.max
      succ_w  = results.filter_map { |pr| pr.checks&.dig('success')&.to_i&.to_s&.length }.max || 1
      total_w = results.filter_map { |pr| pr.checks&.dig('total')&.to_i&.to_s&.length }.max || 1
      as_w    = results.map { |pr| [pr.reviews&.dig('approved').to_i.to_s.length, 1].max }.max
      crs_w   = results.map { |pr| [pr.reviews&.dig('changes_requested').to_i.to_s.length, 1].max }.max
      widths  = { slot: slot_w, succ: succ_w, total: total_w, as: as_w, crs: crs_w }
      results.each_with_index do |pr, idx|
        puts pinned_manager.display_pinned(pr, idx, widths: widths, oneline: !opts.verbose)
        pinned_manager.display_check_runs(pr) if opts.checks
      end
      last_checked = pinned.filter_map(&:last_checked).max
      puts "---"
      puts "Last updated: #{last_checked || 'never'}"
    end
  end

  add_subcmd(:status) do |*status_args|
    refs = current_target ? [current_target.to_s] : (status_args.empty? ? [nil] : status_args)
    order = %w[FAILURE ERROR TIMED_OUT CANCELLED ACTION_REQUIRED PENDING IN_PROGRESS QUEUED SUCCESS SKIPPED NEUTRAL]
    ok = true

    refs.each do |ref|
      reference = pinned_manager.lookup_reference(ref && resolve(:pr, ref))
      tracked = pinned_manager.find(reference)
      if tracked
        pinned_manager.refresh([tracked], force: true)
        tracked.refresh
        summary, complete, error = tracked.check_summary, tracked.checks_complete?, tracked.refresh_error
        title, state, url, freshness = tracked.title, tracked.state, tracked.url, tracked.freshness
      else
        result = pinned_manager.fetcher.fetch([reference]).fetch(reference)
        if result.is_a?(Hiiro::PrSnapshot)
          summary = Hiiro::CheckSummary.from_rollup(result.checks.nodes, truncated: !result.checks.complete,
                                                    freeze_active: pinned_manager.code_freeze_active?)
          complete, error, freshness = result.checks.complete, result.error, 'fresh'
          title, state, url = result.fields.values_at('title', 'state', 'url')
        else
          title, state, url, freshness, error = nil, nil, reference.url, 'unknown', result.error
        end
      end

      counts = summary&.counts_by_outcome || {}
      line = if freshness == 'unknown' then 'checks unknown'
             elsif counts.empty? then 'no checks'
             else order.filter_map { |s| "#{counts[s]} #{s.downcase}" if counts[s] > 0 }.join(', ')
             end
      ok &&= freshness == 'fresh'

      puts reference.to_s
      puts title if title
      puts state.downcase if state
      puts line
      puts "checks incomplete" if freshness == 'fresh' && !complete
      puts "snapshot #{freshness}: #{error}" if error
      puts url
      puts if refs.length > 1
    end
    ok
  end

  add_subcmd(:update) do |*update_args|
    opts = Hiiro::Options.parse(update_args) { |o|
      o.flag(:force_update, long: 'force-update', short: 'u', desc: 'force refresh even if recently checked')
      o.flag(:all, short: 'a', desc: 'show all tracked PRs (no filter)')
      pm.add_options(o)
      o.mutual_exclusion(:all, :active, :merged, :drafts, :red, :green, :pending, :conflicts)
    }

    pinned = pinned_manager.load_pinned

    if pinned.empty?
      puts "No tracked PRs to update"
      next
    end

    active = pinned.select(&:active?)
    puts "Updating status for #{active.length} active PR(s) (#{pinned.length - active.length} closed/merged skipped)..."
    report = pinned_manager.refresh(pinned, force: opts.force_update)
    puts "All PRs recently checked (within last 2 minutes). Use -u to force update." unless report.attempted?
    print_refresh_problems.call(report)
    puts "Done."

    puts
    # The refresh just ran; listing with -u would fetch everything a second time.
    run_subcmd(:ls, *opts.original_args.reject { |arg| %w[-u --force-update].include?(arg) })
  end

  add_subcmd(:green) do |*green_args|
    opts = Hiiro::Options.parse(green_args) { |o| pm.add_options(o) }
    pinned = pinned_manager.load_pinned
    results = pinned_manager.apply_filters(pinned, opts, forced: [:green])

    if results.empty?
      puts "No PRs match."
      next
    end

    if opts.numbers
      results.each { |pr| puts pr.number }
    else
      results.each_with_index { |pr, i| puts pinned_manager.display_pinned(pr, i) }
    end
  end

  add_subcmd(:red) do |*red_args|
    opts = Hiiro::Options.parse(red_args) { |o| pm.add_options(o) }
    pinned = pinned_manager.load_pinned
    results = pinned_manager.apply_filters(pinned, opts, forced: [:red])

    if results.empty?
      puts "No PRs match."
      next
    end

    if opts.numbers
      results.each { |pr| puts pr.number }
    else
      results.each_with_index { |pr, i| puts pinned_manager.display_pinned(pr, i) }
    end
  end

  add_subcmd(:old) do |*old_args|
    opts = Hiiro::Options.parse(old_args) { |o| pm.add_options(o) }
    pinned = pinned_manager.load_pinned
    results = pinned_manager.apply_filters(pinned, opts, forced: [:merged])

    if results.empty?
      puts "No PRs match."
      next
    end

    if opts.numbers
      results.each { |pr| puts pr.number }
    else
      results.each_with_index { |pr, i| puts pinned_manager.display_pinned(pr, i) }
    end
  end

  add_subcmd(:prune) do |*args|
    pinned = pinned_manager.load_pinned

    if pinned.empty?
      puts "No tracked PRs"
      next
    end

    merged_or_closed = pinned.select { |pr| pr.merged? || pr.closed? }

    if merged_or_closed.empty?
      puts "No merged or closed PRs to prune"
      next
    end

    puts "Pruning #{merged_or_closed.length} merged/closed PR(s):"
    puts
    run_action.('untrack', actions.for_records(merged_or_closed))
    puts
    puts "Done. #{pinned_manager.load_pinned.length} PR(s) still tracked."
  end

  add_subcmd(:draft) do |*draft_args|
    opts = Hiiro::Options.parse(draft_args) { |o| pm.add_options(o) }
    pinned = pinned_manager.load_pinned
    results = pinned_manager.apply_filters(pinned, opts, forced: [:drafts])

    if results.empty?
      puts "No PRs match."
      next
    end

    if opts.numbers
      results.each { |pr| puts pr.number }
    else
      results.each_with_index { |pr, i| puts pinned_manager.display_pinned(pr, i) }
    end
  end

  add_subcmd(:assigned) do
    prs = pinned_manager.fetch_assigned_prs

    if prs.empty?
      puts "No PRs assigned to you"
      next
    end

    tracked_refs = pinned_manager.load_pinned.map(&:reference).to_set
    puts "PRs assigned to you (#{prs.count}):"
    puts
    prs.each_with_index do |pr, i|
      tracked = tracked_refs.include?(pr.reference) ? ' [tracked]' : ''
      puts "  #{i + 1}. #{pr.reference} #{pr.title} [#{pr.head_branch}]#{tracked}"
    end
  end

  add_subcmd(:created) do
    prs = pinned_manager.fetch_my_prs

    if prs.empty?
      puts "No open PRs created by you"
      next
    end

    tracked_refs = pinned_manager.load_pinned.map(&:reference).to_set
    puts "PRs created by you (#{prs.count}):"
    puts
    prs.each_with_index do |pr, i|
      tracked = tracked_refs.include?(pr.reference) ? ' [tracked]' : ''
      puts "  #{i + 1}. #{pr.reference} #{pr.title} [#{pr.head_branch}]#{tracked}"
    end
  end

  add_subcmd(:missing) do
    my_prs = pinned_manager.fetch_my_and_assigned_prs
    tracked_refs = pinned_manager.load_pinned.map(&:reference).to_set
    missing = my_prs.reject { |pr| tracked_refs.include?(pr.reference) }

    if missing.empty?
      puts "All your PRs are tracked"
      next
    end

    puts "Untracked PRs (#{missing.count}):"
    puts
    missing.each do |pr|
      relationship = pr.assigned ? 'assigned' : 'authored'
      puts "  #{pr.reference} [#{pr.head_branch}] #{pr.title} (#{relationship})"
    end
  end

  add_subcmd(:amissing) do
    my_prs = pinned_manager.fetch_my_and_assigned_prs
    tracked_refs = pinned_manager.load_pinned.map(&:reference).to_set
    missing = my_prs.reject { |pr| tracked_refs.include?(pr.reference) }

    if missing.empty?
      puts "All your PRs are already tracked"
      next
    end

    lines = ['---']
    missing.each do |pr|
      relationship = pr.assigned ? 'assigned' : 'authored'
      lines << ''
      lines << "# [#{relationship}] [#{pr.head_branch}] #{pr.title}"
      lines << "- #{pr.url}"
    end

    input = yaml_input_file(content: lines.join("\n"), prefix: 'pr-amissing-')
    input.edit
    to_add = input.parsed_file || []
    input.cleanup

    references = Array(to_add).map do |entry|
      Hiiro::PullRequestReference.qualified(entry) || raise(Hiiro::Error, "Not a PR URL or owner/name#N: #{entry}")
    end
    records = references.filter_map do |reference|
      record, outcome = pinned_manager.track(reference)
      record unless outcome == :already
    end
    pinned_manager.refresh(records, force: true)
    added = records.each do |record|
      record.refresh
      puts "Tracked: #{record.reference} #{record.title}"
    end.length

    puts
    puts "Added #{added} PR(s) to tracking."
  end

  # Opens the task's Herdr workspace in the task directory. Nothing is staged,
  # committed, or checked out; `h pr checkout` stays the explicit way to switch.
  add_subcmd(:attach) do |*args|
    ref, rest = split_target.(args)
    no_extra_args.('attach', rest)
    text = resolve(:pr, ref)
    next unless text

    pr = pinned_manager.find(text)
    raise Hiiro::Error, "#{text} is not tracked; run 'h pr track' first" unless pr

    workspace = nil
    working_dir = Dir.pwd
    if pr.task
      task = Hiiro::Environment.current.find_task(pr.task)
      if task
        workspace = herdr_client.find_workspace(task.session_name)
        working_dir = task.tree.path if task.tree
      end
    end
    raise Hiiro::Error, "Task '#{pr.task || '(none)'}' has no active Herdr workspace" unless workspace

    herdr_client.new_tab(name: "pr-#{pr.number}", workspace: workspace, start_directory: working_dir, focus: true)
    puts "Opened #{pr.reference} in #{working_dir} (head branch #{pr.head_branch || 'unknown'}; nothing checked out or committed)"
  end

  add_subcmd(:rm) do |*args|
    ref, rest = split_target.(args)
    no_extra_args.('rm', rest)
    pinned = pinned_manager.load_pinned
    next puts('No tracked PRs') if pinned.empty?

    text = ref || begin
      lines = pinned.each_with_index.each_with_object({}) do |(pr, idx), h|
        h[pinned_manager.strip_ansi(pinned_manager.display_pinned(pr, idx, oneline: true))] = pinned_manager.reference_text(pr)
      end
      fuzzyfind_from_map(lines)
    end
    next puts('No PR selected') unless text

    run_action.('untrack', actions.targets([text]))
  end

  # === PR State and Actions ===

  %w[ready to-draft diff checkout sync].each do |name|
    add_subcmd(name.to_sym) do |*args|
      ref, rest = split_target.(args)
      no_extra_args.(name, rest)
      targets = one_target.(ref)
      next puts('No PR selected') if targets.empty?
      run_action.(name, actions.targets(targets))
    end
  end

  MERGE_FLAGS = {
    '--merge' => ['strategy', 'merge'], '--squash' => ['strategy', 'squash'], '--rebase' => ['strategy', 'rebase'],
    '-d' => ['delete_branch', true], '--delete-branch' => ['delete_branch', true],
  }.freeze

  add_subcmd(:merge) do |*args|
    flags, positional = args.partition { |arg| arg.start_with?('-') }
    unknown = flags - MERGE_FLAGS.keys
    raise Hiiro::Error, "merge: unknown flag(s) #{unknown.join(' ')} (use #{MERGE_FLAGS.keys.join(', ')})" if unknown.any?
    strategies = flags.map { |flag| MERGE_FLAGS[flag] }.select { |key, _| key == 'strategy' }.uniq
    raise Hiiro::Error, 'merge: choose one of --merge, --squash, --rebase' if strategies.length > 1

    ref, rest = split_target.(positional)
    no_extra_args.('merge', rest)
    targets = one_target.(ref)
    next puts('No PR selected') if targets.empty?
    run_action.('merge', actions.targets(targets), flags.to_h { |flag| MERGE_FLAGS[flag] })
  end

  add_subcmd(:fix) do |*fix_args|
    opts = Hiiro::Options.parse(fix_args) do
      flag(:red, short: :r, desc: 'Fix all PRs with failing checks')
      flag(:run, short: :R, desc: 'Launch queue tasks immediately after queuing')
    end

    pinned = pinned_manager.load_pinned
    refs = current_target ? [current_target.to_s] : opts.args
    targets = if opts.red
      failing = pinned.select(&:red?)
      next puts('No PRs with failing checks') if failing.empty?
      actions.for_records(failing)
    elsif refs.empty?
      # Default: fuzzy-select from failing PRs, fall back to all tracked
      failing = pinned.select(&:red?)
      candidates = failing.empty? ? pinned : failing
      next puts('No tracked PRs') if candidates.empty?
      lines = candidates.each_with_index.each_with_object({}) do |(pr, idx), h|
        h[pinned_manager.strip_ansi(pinned_manager.display_pinned(pr, idx, oneline: true))] = pr
      end
      selected = fuzzyfind_from_map(lines)
      next puts('No PR selected') unless selected
      actions.for_records([selected])
    else
      actions.targets(refs)
    end

    run_action.('fix', targets, 'run' => opts.run == true)
  end

  add_subcmd(:comment) do |*args|
    opts = Hiiro::Options.parse(args) { option(:body, short: :b, desc: 'comment text (otherwise an editor opens)') }
    ref, rest = split_target.(opts.args)
    no_extra_args.('comment', rest)
    texts = one_target.(ref)
    next puts('No PR selected') if texts.empty?
    targets = actions.targets(texts)

    body = opts.body
    unless body
      input = md_input_file(prefix: 'pr-comment-')
      document = input.edit.document
      input.cleanup
      next puts('Cancelled: editor exited unsuccessfully') unless document.editor_succeeded?
      body = document.result.to_s
    end
    run_action.('comment', targets, 'comment' => body)
  end

  TEMPLATES_DIR = File.join(Dir.home, '.config', 'hiiro', 'pr_templates')

  add_subcmd(:templates) do
    FileUtils.mkdir_p(TEMPLATES_DIR)
    files = Dir.glob(File.join(TEMPLATES_DIR, '*.md')).sort

    if files.empty?
      puts "No templates found. Use 'h pr new-template <name>' to create one."
      next
    end

    puts "Comment templates:"
    puts
    files.each do |f|
      name = File.basename(f, '.md')
      first_line = File.readlines(f).first&.strip || ''
      puts "  #{name.ljust(20)}  #{first_line}"
    end
  end

  add_subcmd(:'new-template') do |name = nil|
    FileUtils.mkdir_p(TEMPLATES_DIR)

    unless name
      STDERR.puts "Usage: h pr new-template <name>"
      next
    end

    path = File.join(TEMPLATES_DIR, "#{name}.md")

    if File.exist?(path)
      puts "Template '#{name}' already exists, opening for edit..."
    end

    edit_files(path)
    puts "Template saved: #{path}"
  end

  add_subcmd(:'from-template') do |*args|
    ref, rest = split_target.(args)
    no_extra_args.('from-template', rest)
    FileUtils.mkdir_p(TEMPLATES_DIR)
    files = Dir.glob(File.join(TEMPLATES_DIR, '*.md')).sort

    if files.empty?
      STDERR.puts "No templates found. Use 'h pr new-template <name>' to create one."
      next
    end

    texts = one_target.(ref)
    next puts('No PR selected') if texts.empty?
    targets = actions.targets(texts)

    template_map = files.each_with_object({}) do |f, h|
      name = File.basename(f, '.md')
      first_line = File.readlines(f).first&.strip || ''
      h["#{name.ljust(20)}  #{first_line}"] = f
    end

    template_path = fuzzyfind_from_map(template_map)
    next unless template_path

    run_action.('comment', targets, 'comment' => File.read(template_path).strip)
  end

  add_subcmd(:branch) do |*args|
    arg, rest = split_target.(args)
    no_extra_args.('branch', rest)
    pr_number = resolve(:pr, arg)
    next unless pr_number

    pr = pinned_manager.find(pr_number)

    unless pr
      puts "PR ##{pr_number} not in tracked list"
      next
    end

    if pr.head_branch
      puts pr.head_branch
    else
      puts "PR ##{pr.number} has no branch info"
    end
  end

  add_subcmd(:'for-task') do |task_name = nil|
    tracked = pinned_manager.load_pinned

    if tracked.empty?
      puts "No tracked PRs"
      next
    end

    task_name ||= begin
      env = Environment.current rescue nil
      env&.task&.name
    end

    unless task_name
      STDERR.puts "Not in a task context. Pass a task name: h pr for-task <name>"
      next
    end

    matches = tracked.select { |pr| pr.task == task_name }

    if matches.empty?
      puts "No tracked PRs for task '#{task_name}'"
      next
    end

    puts "PRs for task '#{task_name}':"
    puts
    matches.each_with_index { |pr, i| puts pinned_manager.display_pinned(pr, i) }
  end

  add_subcmd(:tag) do |*raw_args|
    opts = Hiiro::Options.parse(raw_args) do
      flag(:edit, short: 'e', desc: 'open YAML editor to bulk-tag multiple PRs')
    end

    if opts.edit
      pinned = pinned_manager.load_pinned

      if pinned.empty?
        puts "No tracked PRs to tag"
        next
      end

      yaml_content = <<~YAML
        # Select PRs to tag and list the tags to apply.
        # All listed PRs will receive all listed tags.
        # Lines starting with # are comments and are ignored.

        prs:
        #{pinned.map { |pr| "- #{pr.id}  # #{pr.reference}: #{pr.title}" }.join("\n")}

        tags:
        -
      YAML

      input = yaml_input_file(content: yaml_content, prefix: 'pr-tag-')
      input.edit
      parsed = input.document.valid? ? input.document.parsed : nil
      input.cleanup

      unless parsed.is_a?(Hash)
        puts "Aborted: could not parse YAML"
        next
      end

      selected_ids = Array(parsed['prs'])
      new_tags         = Array(parsed['tags']).map(&:to_s).reject(&:empty?)

      if selected_ids.empty? || new_tags.empty?
        puts "Aborted: need at least one PR and one tag"
        next
      end

      original_ids = pinned.map(&:id)
      unless selected_ids.all? { |id| id.is_a?(Integer) && original_ids.include?(id) } && selected_ids.uniq == selected_ids
        puts "Aborted: select original PR ids only"
        next
      end
      updated = 0
      Hiiro::DB.connection.transaction(mode: :immediate) do
        selected_ids.each do |id|
          original = pinned.find { |pr| pr.id == id }
          pinned_manager.change_tags(original, add: new_tags)
          updated += 1
        end
      end
      puts "Updated #{updated} PR(s)."
    else
      ref, tag_names = split_target.(opts.args)

      if ref.nil? || tag_names.empty?
        puts "Usage: h pr tag <ref> <tag> [tag2 ...]"
        puts "       h pr tag -e  (bulk edit mode)"
        next
      end

      pr_number = resolve(:pr, ref)
      next unless pr_number

      pinned = pinned_manager.load_pinned
      pr = pinned_manager.find(pr_number)
      unless pr
        puts "PR ##{pr_number} not in tracked list"
        next
      end

      pr = pinned_manager.change_tags(pr, add: tag_names)
      puts "Tagged #{pr.reference} with: #{tag_names.join(', ')}"
      puts "  Tags now: #{pr.tags.join(', ')}"
    end
  end

  add_subcmd(:untag) do |*args|
    ref, tag_names = split_target.(args)
    if ref.nil?
      puts "Usage: h pr untag <ref> [tag ...]  (omit tags to clear all)"
      next
    end

    pr_number = resolve(:pr, ref)
    next unless pr_number

    pinned = pinned_manager.load_pinned
    pr = pinned_manager.find(pr_number)
    unless pr
      puts "PR ##{pr_number} not in tracked list"
      next
    end

    if tag_names.empty?
      pinned_manager.change_tags(pr, clear: true)
      puts "Cleared all tags from #{pr.reference}"
    else
      pinned_manager.change_tags(pr, remove: tag_names)
      puts "Removed tag(s) #{tag_names.join(', ')} from #{pr.reference}"
    end

  end

  add_subcmd(:tags) do |*raw_args|
    opts = Hiiro::Options.parse(raw_args) { |o|
      o.flag(:update,  short: 'u', desc: 'update status before listing')
      o.flag(:verbose, short: 'v', desc: 'multi-line output per PR')
      o.flag(:checks,  short: 'C', desc: 'show individual check run details')
    }
    filter_tags = opts.args

    pinned = pinned_manager.load_pinned

    if pinned.empty?
      puts "No tracked PRs."
      next
    end

    pinned_manager.refresh(pinned, force: opts.update)
    pinned = pinned_manager.load_pinned

    by_tag = Hash.new { |h, k| h[k] = [] }
    untagged = []

    pinned.each do |pr|
      tags = Array(pr.tags)
      if tags.empty?
        untagged << pr
      else
        tags.each { |t| by_tag[t] << pr }
      end
    end

    if filter_tags.any?
      unknown = filter_tags - by_tag.keys
      unknown.each { |t| STDERR.puts "No PRs tagged '#{t}'" }
      by_tag = by_tag.select { |tag, _| filter_tags.include?(tag) }
      if by_tag.empty?
        puts "No PRs match tag(s): #{filter_tags.join(', ')}"
        next
      end
    end

    render_group = lambda do |label, prs, current_tag|
      puts label
      slot_w  = prs.map { |pr| (pr.slot || 1).to_s.length }.max
      succ_w  = prs.filter_map { |pr| pr.checks&.dig('success')&.to_i&.to_s&.length }.max || 1
      total_w = prs.filter_map { |pr| pr.checks&.dig('total')&.to_i&.to_s&.length }.max || 1
      as_w    = prs.map { |pr| [pr.reviews&.dig('approved').to_i.to_s.length, 1].max }.max
      crs_w   = prs.map { |pr| [pr.reviews&.dig('changes_requested').to_i.to_s.length, 1].max }.max
      widths  = { slot: slot_w, succ: succ_w, total: total_w, as: as_w, crs: crs_w }
      prs.each_with_index do |pr, idx|
        line = pinned_manager.display_pinned(pr, idx, widths: widths, oneline: !opts.verbose)
        if current_tag
          other = Array(pr.tags) - [current_tag]
          line += "  " + other.map { |t| "\e[30;104m#{t}\e[0m" }.join(' ') if other.any?
        end
        puts "  #{line}"
        pinned_manager.display_check_runs(pr) if opts.checks
      end
    end

    by_tag.sort.each do |tag, prs|
      render_group.call("\e[30;104m#{tag}\e[0m (#{prs.length})", prs, tag)
    end

    render_group.call("(untagged) (#{untagged.length})", untagged, nil) if untagged.any? && filter_tags.empty?
  end

  # === Multi-PR actions (mCMD) ===
  # Each opens a YAML selection of all tracked PRs plus the action's fields,
  # then runs the same action, validation, and outcomes as the single command.

  Hiiro::PrActions.bulk_names.each do |bulk|
    add_subcmd(bulk.to_sym) do |*args|
      action = Hiiro::PrActions.for_bulk(bulk)
      pinned = pinned_manager.load_pinned
      next puts('No tracked PRs') if pinned.empty?

      editor = ->(text) {
        input = yaml_input_file(content: text, prefix: "pr-#{bulk}-")
        input.edit.document.tap { input.cleanup }
      }
      status, value = actions.edit(action.name, pinned, editor: editor)
      case status
      when :cancelled
        puts "Cancelled: #{value}"
      when :empty
        puts 'No PRs selected; nothing to do.'
      when :invalid
        puts "Invalid selection: #{value}"
        exit 1
      else
        exit 1 unless actions.perform(value).all?(&:ok)
      end
      true
    end
  end

  add_subcmd(:dep) do |*args|
    run_child(:dep) do |h|
      # A dependency argument: a tracked PR (number, slot, pin, URL) or, for a
      # bare number nobody tracks, that number in the depending PR's repository.
      dependency_reference = ->(owner, text) {
        value = resolve(:pr, text).to_s
        Hiiro::PullRequestReference.parse(value, repo: owner.reference.repo) ||
          raise(Hiiro::Error, "Not a PR reference: #{text}")
      }

      dependency_label = ->(dep, pinned) {
        if dep.is_a?(Integer)
          "##{dep} (unresolved legacy number; re-add as owner/name##{dep} or URL)"
        else
          ref = Hiiro::PullRequestReference.qualified(dep)
          tracked = pinned.find { |p| p.reference == ref }
          tracked ? "#{dep}: #{tracked.title}" : "#{dep} (not tracked)"
        end
      }

      h.add_subcmd(:add) { |*args|
        ref, dep_refs = split_target.(args)
        if ref.nil? || dep_refs.empty?
          puts "Usage: h pr dep add <pr> <dep1> [dep2 ...]"
          next
        end

        pr_number = resolve(:pr, ref)
        next unless pr_number

        pr = pinned_manager.find(pr_number)
        unless pr
          puts "PR #{pr_number} is not tracked — pin it first with: h pr track #{pr_number}"
          next false
        end

        deps = dep_refs.map { |dep| dependency_reference.call(pr, dep) }
        pr = pinned_manager.change_dependencies(pr, add: deps)
        puts "#{pr.reference} now depends on: #{pr.depends_on.map { |dep| dep.is_a?(Integer) ? "##{dep}" : dep }.join(', ')}"
      }

      h.add_subcmd(:rm) { |*args|
        ref, dep_refs = split_target.(args)
        if ref.nil?
          puts "Usage: h pr dep rm <pr> [dep1 dep2 ...]  (omit deps to clear all)"
          next
        end

        pr_number = resolve(:pr, ref)
        next unless pr_number

        pr = pinned_manager.find(pr_number)
        unless pr
          puts "PR #{pr_number} not in tracked list"
          next false
        end

        if dep_refs.empty?
          pr = pinned_manager.change_dependencies(pr, clear: true)
          puts "Cleared all dependencies from #{pr.reference}"
        else
          # A bare number also removes a legacy unqualified entry with that number.
          removed = dep_refs.flat_map do |dep|
            qualified = dependency_reference.call(pr, dep)
            typed = dep.to_s.strip.delete_prefix('#')
            typed.match?(/\A\d+\z/) && typed.to_i == qualified.number ? [qualified, qualified.number] : [qualified]
          end
          pr = pinned_manager.change_dependencies(pr, remove: removed)
          puts "Removed dep(s) #{removed.grep(Hiiro::PullRequestReference).join(', ')} from #{pr.reference}"
          puts "  Remaining: #{Array(pr.depends_on).map { |dep| dep.is_a?(Integer) ? "##{dep}" : dep }.join(', ').then { |s| s.empty? ? '(none)' : s }}"
        end
      }

      h.add_subcmd(:ls) { |ref = nil|
        ref ||= current_target&.to_s
        pinned = pinned_manager.load_pinned

        if ref
          pr_number = resolve(:pr, ref)
          next unless pr_number
          pr = pinned_manager.find(pr_number)
          unless pr
            puts "PR #{pr_number} not in tracked list"
            next false
          end
          deps = Array(pr.depends_on)
          if deps.empty?
            puts "#{pr.reference} has no dependencies"
          else
            puts "#{pr.reference}: #{pr.title}"
            puts "  depends on:"
            deps.each { |dep| puts "    #{dependency_label.call(dep, pinned)}" }
          end
        else
          with_deps = pinned.select { |p| Array(p.depends_on).any? }
          if with_deps.empty?
            puts "No dependency relationships configured."
            puts "Use: h pr dep add <pr> <dep1> [dep2 ...]"
          else
            with_deps.each do |pr|
              puts "#{pr.reference}: #{pr.title}"
              Array(pr.depends_on).each { |dep| puts "  └─ #{dependency_label.call(dep, pinned)}" }
            end
          end
        end
      }

      h.add_subcmd(:config) {
        puts ENV.fetch('HIIRO_TEST_DB', Hiiro::DB::DB_FILE)
      }

      h.add_subcmd(:edit) {
        edit_pr_records.call
      }
    end
  end

  add_subcmd(:config) do |*args|
    make_child do
      add_subcmd(:path) do
        puts ENV.fetch('HIIRO_TEST_DB', Hiiro::DB::DB_FILE)
      end

      add_subcmd(:vim) do
        edit_pr_records.call
      end
    end.run
  end

  add_subcmd(:q, :query) { |*args|
    def pr_query(args)
      opts = Hiiro::Options.parse(args) { flag(:all, short: :a, desc: 'show all rows (no limit)') }
      query_args = opts.args
      db = Hiiro::DB.connection
      limit = opts.all ? nil : 50

      if query_args.empty?
        ds = db[:prs]
        ds = ds.limit(limit) if limit
        rows = ds.all
      elsif query_args[0].include?(' ') || query_args[0].upcase =~ /\A(SELECT|INSERT|UPDATE|DELETE|WITH)/
        sql = query_args.join(' ')
        rows = db.fetch(sql).all
        rows = rows.first(limit) if limit
      else
        conditions = query_args.each_with_object({}) do |pair, h|
          k, v = pair.split('=', 2)
          h[k] = v if k && v
        end
        ds = db[:prs]
        conditions.each { |k, v| ds = ds.where(k.to_sym => v) }
        ds = ds.limit(limit) if limit
        rows = ds.all
      end

      return puts "(no results)" if rows.empty?
      keys = rows.first.keys
      col_widths = keys.map { |k| [k.to_s.length, rows.map { |r| r[k].to_s.length }.max].max.clamp(0, 60) }
      header = keys.each_with_index.map { |k, i| k.to_s.ljust(col_widths[i]) }.join("  ")
      puts header
      puts "-" * header.length
      rows.each do |row|
        puts keys.each_with_index.map { |k, i|
          val = row[k].to_s; val = val[0..57] + "..." if val.length > 60; val.ljust(col_widths[i])
        }.join("  ")
      end
      puts "(#{rows.length} rows)"
    end
    pr_query(args)
  }
end
