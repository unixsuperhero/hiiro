#!/usr/bin/env ruby

require 'hiiro'
require 'yaml'

Hiiro.run(*ARGV, plugins: [Pins]) do
  herdr = herdr_client
  Hiiro::Herdr.add_resolvers(self)

  home_config_path = Hiiro::Config.path('pane_homes.yml')

  load_homes = -> {
    begin
      PaneHome.all_as_hash
    rescue => e
      warn "PaneHome DB load failed: #{e}"
      next({}) unless File.exist?(home_config_path)
      YAML.load_file(home_config_path) || {}
    end
  }

  save_homes = ->(config) {
    begin
      config.each do |name, data|
        existing = PaneHome.find_by_name(name)
        if existing
          existing.update(data_json: Hiiro::DB::JSON.dump(data))
        else
          pane_home = PaneHome.new(name: name.to_s)
          pane_home.data = data
          pane_home.save
        end
      end
      PaneHome.where(Sequel.~(name: config.keys.map(&:to_s))).delete
      File.write(home_config_path, config.to_yaml)
    rescue => e
      warn "PaneHome DB save failed: #{e}"
      File.write(home_config_path, config.to_yaml)
    end
  }

  add_subcmd(:ls) { |*args|
    if args.empty?
      herdr.panes(workspace: ENV['HERDR_WORKSPACE_ID']).each { |pane| puts pane }
    else
      system('herdr', 'pane', 'list', *args)
    end
  }

  add_subcmd(:lsa) { |*args|
    args.empty? ? herdr.panes(all: true).each { |pane| puts pane } : system('herdr', 'pane', 'list', *args)
  }

  add_subcmd(:split) { |direction = 'right', *args|
    system('herdr', 'pane', 'split', '--current', '--direction', direction, *args)
  }

  add_subcmd(:hsplit, :splith) { |*args|
    args.empty? ? herdr.hsplit_window : system('herdr', 'pane', 'split', '--current', '--direction', 'down', *args)
  }

  add_subcmd(:vsplit, :splitv) { |*args|
    args.empty? ? herdr.vsplit_window : system('herdr', 'pane', 'split', '--current', '--direction', 'right', *args)
  }

  add_subcmd(:kill) { |target = nil|
    target = resolve(:pane, target)
    herdr.kill_pane(target) if target
  }

  add_subcmd(:swap) { |source = nil, target = nil|
    if source && target
      herdr.swap_pane(source, target)
    elsif source
      herdr.swap_current_pane(source.to_sym)
    else
      puts 'Usage: h pane swap <left|right|up|down> OR h pane swap <source> <target>'
    end
  }

  add_subcmd(:zoom) { |target = nil|
    herdr.zoom_pane(target)
  }

  add_subcmd(:capture) { |target = nil, lines = nil|
    target ||= ENV['HERDR_PANE_ID']
    content = herdr.read_pane(target, lines: lines)
    print content if content
  }

  add_subcmd(:select) { |target = nil|
    target = resolve(:pane, target)
    print target if target
  }

  add_subcmd(:copy) { |target = nil|
    target = resolve(:pane, target)
    if target
      Hiiro::Shell.pipe(target, 'pbcopy')
      puts "Copied pane '#{target}' to clipboard"
    end
  }

  add_subcmd(:sw, :switch) { |target = nil|
    target = resolve(:pane, target)
    herdr.focus_pane(target) if target
  }

  add_subcmd(:home) do
    run_child(:home) do |h|
      h.add_subcmd(:ls) {
        homes = load_homes.call
        if homes.empty?
          puts 'No home panes configured.'
          puts 'Use: h pane home add <name> <workspace> [path]'
        else
          homes.each do |name, config|
            workspace = config['workspace'] || config['session']
            path = config['path'] ? "  #{config['path']}" : ''
            puts "#{name.ljust(20)} #{workspace}#{path}"
          end
        end
      }

      h.add_subcmd(:add) { |name, workspace, path = nil|
        unless name && workspace
          puts 'Usage: h pane home add <name> <workspace> [path]'
          next
        end

        homes = load_homes.call
        homes[name] = { 'workspace' => workspace }
        homes[name]['path'] = File.expand_path(path) if path
        save_homes.call(homes)
        puts "Added '#{name}' → #{workspace}#{path ? " (#{File.expand_path(path)})" : ''}"
      }

      h.add_subcmd(:rm) { |name|
        unless name
          puts 'Usage: h pane home rm <name>'
          next
        end

        homes = load_homes.call
        if homes.delete(name)
          save_homes.call(homes)
          puts "Removed home pane '#{name}'"
        else
          puts "Home pane '#{name}' not found"
        end
      }

      h.add_subcmd(:switch) { |name = nil|
        homes = load_homes.call

        if name.nil?
          if homes.empty?
            puts "No home panes configured. Use 'h pane home add <name> <workspace> [path]'"
            next
          end
          display_map = homes.each_with_object({}) do |(home_name, config), map|
            workspace = config['workspace'] || config['session']
            map["#{home_name}  [#{workspace}#{config['path'] ? "  #{config['path']}" : ''}]"] = home_name
          end
          name = fuzzyfind_from_map(display_map)
          next unless name
        end

        config = homes[name]
        unless config
          matches = homes.keys.select { |home_name| home_name.start_with?(name) }
          if matches.one?
            name = matches.first
            config = homes[name]
          else
            puts(matches.empty? ? "Home pane '#{name}' not found" : "Ambiguous home pane '#{name}': #{matches.join(', ')}")
            next
          end
        end

        workspace_name = config['workspace'] || config['session']
        workspace = herdr.find_workspace(workspace_name)
        unless workspace
          herdr.new_workspace(workspace_name, start_directory: config['path'], tab_name: name, focus: true)
          next
        end

        tab = herdr.tabs(workspace: workspace).find { |candidate| candidate.name == name }
        unless tab
          result = herdr.new_tab(name: name, workspace: workspace, start_directory: config['path'], focus: true)
          next if result['tab']
        end

        herdr.focus_workspace(workspace.id)
        herdr.focus_tab(tab.id) if tab
      }
    end
  end

  add_subcmd(:move) { |target, tab, split = 'right'|
    unless target && tab
      puts 'Usage: h pane move <pane> <tab> [right|down]'
      next
    end
    system('herdr', 'pane', 'move', target, '--tab', tab, '--split', split, '--focus')
  }

  add_subcmd(:break) { |target = nil|
    herdr.break_pane(src: target)
  }

  add_subcmd(:join) { |source, target, direction = 'down'|
    unless source && target
      puts 'Usage: h pane join <source> <target> [right|down]'
      next
    end
    herdr.join_pane(source, target, horizontal: direction == 'right')
  }

  add_subcmd(:resize) { |direction, amount = nil, target = nil|
    unless %w[left right up down].include?(direction)
      puts 'Usage: h pane resize <left|right|up|down> [amount] [pane]'
      next
    end
    herdr.resize_pane(target: target, direction: direction, amount: amount)
  }

  add_subcmd(:info) { |target = nil|
    pane = target ? herdr.get_pane(target) : herdr.current_pane
    if pane
      puts pane
      puts "  Size: #{pane.width}x#{pane.height}" if pane.width.positive? && pane.height.positive?
      puts "  Agent: #{pane.agent}" if pane.agent
      puts "  Path: #{pane.path || pane.cwd}" if pane.path || pane.cwd
      puts "  Status: #{pane.agent_status}" if pane.agent_status
    else
      puts 'Pane not found'
    end
  }
end
