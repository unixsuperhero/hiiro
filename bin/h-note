#!/usr/bin/env ruby

require "hiiro"
require "open3"
require "pathname"
require "tmpdir"
require "fileutils"

hiiro = Hiiro.init(*ARGV)

# Helper class for directory operations
class Directory
  # Temporarily change to a directory, run block, then change back
  def self.temp_cd(dir, &block)
    original_dir = Dir.pwd
    Dir.chdir(dir)
    yield
  ensure
    Dir.chdir(original_dir)
  end

  # Print directory tree with indentation
  def self.dir_tree(dir, prefix = "", base_dir = nil)
    base_dir ||= dir
    entries = Dir.entries(dir).reject { |e| e.start_with?('.') }.sort

    entries.each do |entry|
      path = File.join(dir, entry)
      relative_path = Pathname.new(path).relative_path_from(base_dir)

      if File.directory?(path)
        puts "#{prefix}#{path}/"
        dir_tree(path, prefix + "  ", base_dir)
      else
        puts "#{prefix}#{path}"
      end
    end
  end
end

notes_dir = ENV['NOTES_DIR'] || File.join(Dir.home, 'notes')

hiiro.add_subcmd(:modify) { |*args|
  system(ENV['EDITOR'] || 'nvim', __FILE__)
}


hiiro.add_subcmd(:open) { |*args|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Directory.temp_cd(notes_dir) {
    system(ENV['EDITOR'] || 'vim', '-O', *args)
  }
}

hiiro.add_subcmd(:edit) { |*args|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Directory.temp_cd(notes_dir) {
    system(ENV['EDITOR'] || 'vim', '-O', *args)
  }
}

hiiro.add_subcmd(:categories) { |*args|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Directory.temp_cd(notes_dir) {
    Directory.dir_tree(notes_dir)
  }
}

hiiro.add_subcmd(:tagged_files) { |*args|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Directory.temp_cd(notes_dir) {
    args.each do |tag|
      tag = tag.sub(/^#+/, '')
      tag_pattern = format('#%s\\b', tag)
      cmd = format('rg -S %s %s', tag_pattern.inspect, notes_dir)
      out, err, status = Open3.capture3(cmd)

      if status.success?
        puts format('#%s', tag)
        puts format('#%s', tag).gsub(/./, ?-)
        out.lines.each do |line|
          file = line.sub(/:.*/, '')
          puts File.absolute_path(file)
        end
      end

      puts
    end
  }
}

hiiro.add_subcmd(:ls) { |*args|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Directory.temp_cd(notes_dir) {
    Dir.glob('**/*').each { |f| puts File.join(notes_dir, f) }
  }
}

hiiro.add_subcmd(:tags) { |*args|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Directory.temp_cd(notes_dir) {
    tag_pattern = '#[^#[:space:]]+'
    cmd = format('rg -SI %s %s', tag_pattern.inspect, notes_dir)
    out, err, status = Open3.capture3(cmd)

    if status.success?
      puts out.scan(Regexp.new(tag_pattern)).sort.uniq
    end
  }
}

hiiro.add_subcmd(:copy) { |outdir=nil, *files|
  groups = files.group_by{|f| File.file?(f) ? :file : :not_file }

  file_group = groups[:file] || []
  not_file_group = groups[:not_file] || []

  if not_file_group.any?
    puts "NOT FILES: #{not_file_group.map(&:inspect).join(', ')}"
  end

  abs_outdir = File.join(notes_dir, outdir)
  unless Dir.exist?(abs_outdir)
    FileUtils.mkdir_p(abs_outdir)
  end

  file_group.each do |f|
    abs_suboutdir = File.join(abs_outdir, File.dirname(f))
    unless Dir.exist?(abs_suboutdir)
      FileUtils.mkdir_p(abs_suboutdir)
    end
    abs_outfile = File.join(abs_outdir, f)
    FileUtils.cp_r(f, abs_outfile)
  end
}

hiiro.add_subcmd(:move) { |outdir=nil, *files|
  groups = files.group_by{|f| File.file?(f) ? :file : File.directory?(f) ? :file : :not_file }

  file_group = groups[:file] || []
  not_file_group = groups[:not_file] || []

  if not_file_group.any?
    puts "NOT FILES: #{not_file_group.map(&:inspect).join(', ')}"
  end

  abs_outdir = File.join(notes_dir, outdir)
  unless Dir.exist?(abs_outdir)
    FileUtils.mkdir_p(abs_outdir)
  end

  FileUtils.mv(file_group, abs_outdir, secure: true, verbose: true, noop: ENV['NOOP'].to_s.length > 0)
}

hiiro.add_subcmd(:save) { |outfile=nil, *content|
  unless Dir.exist?(notes_dir)
    Dir.mkdir(notes_dir)
  end

  Dir.chdir(notes_dir)

  unless outfile
    tempname = File.basename(Tempfile.new('note.'))
    outfile = File.join(notes_dir, 'random', tempname)
  end

  outfile = File.absolute_path(outfile)
  outdir = File.dirname(outfile)
  unless Dir.exist?(outdir)
    FileUtils.mkdir_p(outdir)
  end
  contents = contents&.join(' ') || `pbpaste`

  if contents == ''
    contents = `pbpaste`
  end
  File.write(outfile, contents)
  print outfile
}

hiiro.run

