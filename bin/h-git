#!/usr/bin/env ruby

require 'hiiro'
require 'json'
require 'open3'
require 'shellwords'
require 'tempfile'
require 'yaml'

def clean?
  status = `git status --porcelain -uall`.strip
  status.empty?
end

def dirty?
  !clean?
end

def plan_line(change)
  notes = []
  notes << "renamed from #{change.source.inspect}" if change.source
  notes << 'deleted' if change.status == 'D'
  notes << 'binary' if change.binary
  notes << 'staged+unstaged: whole file' if change.partial?
  notes.empty? ? change.path.inspect : "#{change.path.inspect}  (#{notes.join(', ')})"
end

def print_plan(plan, change_set)
  puts
  plan.groups.each_with_index do |group, i|
    puts "  [#{i + 1}] #{group.subject}"
    group.paths.each { |path| puts "        - #{plan_line(change_set.find(path))}" }
  end
  puts
end

def untracked_files(repo_root)
  output, error, status = Open3.capture3(
    'git', '-C', repo_root, 'ls-files', '--others', '--exclude-standard', '-z'
  )
  raise "Could not list untracked files: #{error.strip}" unless status.success?

  output.split("\0").reject(&:empty?).sort
end

def ignore_candidate_groups(files)
  extensions = files.each_with_object([]) do |path, patterns|
    extension = File.extname(path)
    patterns << "*#{extension}" unless extension.empty? || extension == '.'
  end.uniq.sort

  directories = files.each_with_object([]) do |path, patterns|
    directory = File.dirname(path)
    patterns << "#{directory}/*" unless directory == '.'
  end.uniq.sort

  {
    'Exact files' => files,
    'Extensions' => extensions,
    'Directories' => directories
  }
end

def write_ignore_candidates(path, groups)
  File.open(path, 'w') do |file|
    file.puts '# Delete every pattern you do not want, then save and quit.'
    groups.each do |heading, patterns|
      next if patterns.empty?

      file.puts
      file.puts "# #{heading}"
      patterns.each { |pattern| file.puts "- #{pattern.to_json}" }
    end
  end
end

def load_ignore_patterns(path)
  patterns = YAML.safe_load(File.read(path), aliases: false) || []
  raise 'The edited YAML must contain an array of strings.' unless patterns.is_a?(Array) && patterns.all?(String)
  raise 'Git ignore patterns cannot contain newlines.' if patterns.any? { |pattern| pattern.match?(/[\r\n]/) }

  patterns.map(&:strip).reject(&:empty?).uniq
end

def append_gitignore(repo_root, patterns)
  path = File.join(repo_root, '.gitignore')
  content = File.exist?(path) ? File.binread(path) : ''
  existing_patterns = content.lines.map(&:chomp)
  new_patterns = patterns - existing_patterns
  return [path, []] if new_patterns.empty?

  File.open(path, 'ab') do |file|
    file.write("\n") unless content.empty? || content.end_with?("\n")
    new_patterns.each { |pattern| file.puts(pattern) }
  end

  [path, new_patterns]
end

Hiiro.run(*ARGV, plugins: [:Pins]) do
  add_flag(:dry_run, short: :n, default: false)
  add_flag(:yes, short: :y, default: false)
  add_flag(:whole_files, short: :w, default: false)
  add_option(:model, short: :m, default: 'sonnet')

  add_cmd(:clean) do
    status = `git status --porcelain -uall`.strip
    exit (clean? ? 0 : 1)
  end

  add_cmd(:dirty) do
    status = `git status --porcelain -uall`.strip
    exit (dirty? ? 0 : 1)
  end

  add_cmd(:ignore) do
    repo_root, _error, status = Open3.capture3('git', 'rev-parse', '--show-toplevel')
    unless status.success?
      puts 'Not inside a git work tree.'
      next false
    end

    files = untracked_files(repo_root.strip)
    if files.empty?
      puts 'No untracked files to ignore.'
      next
    end

    editor = Shellwords.split(ENV['EDITOR'].to_s)
    if editor.empty?
      puts '$EDITOR is not set.'
      next false
    end

    Tempfile.create(['h-git-ignore-', '.yml']) do |tempfile|
      write_ignore_candidates(tempfile.path, ignore_candidate_groups(files))
      next false unless system(*editor, tempfile.path)

      begin
        patterns = load_ignore_patterns(tempfile.path)
      rescue Psych::SyntaxError, RuntimeError => error
        puts "Could not use edited YAML: #{error.message}"
        next false
      end

      gitignore_path, added = append_gitignore(repo_root.strip, patterns)
      if added.empty?
        puts 'No new ignore patterns selected.'
      else
        puts "Added #{added.size} pattern(s) to #{gitignore_path}:"
        added.each { |pattern| puts "  #{pattern}" }
      end
    end
  end

  add_cmd(:commit, opts: %i[model], flags: %i[dry_run yes whole_files]) do
    git = Hiiro::Git::IndexGit.at(Dir.pwd)
    unless git
      puts 'Not inside a git work tree.'
      next false
    end

    change_set = Hiiro::Git::ChangeSet.capture(git)
    if change_set.empty?
      puts 'Nothing to commit — working tree is clean.'
      next
    end

    planner = Hiiro::Git::CommitPlanner.new(model: @opts.model)
    puts "Analyzing #{change_set.changes.size} changed file(s) with #{planner.command.first} (#{@opts.model})..."
    if change_set.diff_truncated?
      puts "The diff is #{change_set.diff.bytesize} bytes; the planner sees the first #{Hiiro::Git::ChangeSet::MAX_DIFF_BYTES}."
    end

    validation = Hiiro::Git::CommitPlan.validate(planner.call(change_set, cwd: git.root), change_set)
    unless validation.valid?
      puts 'The planner returned an unusable plan; nothing was staged or committed:'
      validation.errors.each { |error| puts "  - #{error}" }
      next false
    end
    plan = validation.plan
    print_plan(plan, change_set)

    partial = change_set.partial
    if partial.any?
      puts 'These files have staged and unstaged changes; a commit takes the whole working file:'
      partial.each { |change| puts "  #{change.path.inspect}" }
      puts
    end

    if @opts.dry_run
      puts '(dry run — no commits made; index and working tree unchanged)'
      next
    end

    if partial.any? && !@opts.whole_files
      puts 'Nothing was committed. Rerun with --whole-files to commit those files whole,'
      puts 'or stage/commit them yourself first.'
      next false
    end

    unless @opts.yes
      print "Create #{plan.groups.size} commit(s)? [y/N] "
      answer = $stdin.gets
      puts unless $stdin.tty?
      unless answer&.strip&.match?(/\Ay(es)?\z/i)
        puts 'Cancelled; nothing was committed.'
        next false
      end
    end

    if Hiiro::Git::ChangeSet.capture(git).fingerprint != change_set.fingerprint
      puts 'HEAD, the index, or working files changed after planning; nothing was committed. Run again.'
      next false
    end

    outcome = Hiiro::Git::CommitExecution.new(git, change_set).call(plan) do |event|
      if event.is_a?(Hiiro::Git::CommitExecution::Step)
        puts "✓ [#{event.number}] #{event.sha[0, 12]} #{event.group.subject}"
      else
        puts "✗ [#{event.number}] #{event.operation} failed: #{event.message}"
      end
    end
    next true if outcome.success?

    failed = outcome.failure.number
    puts
    puts "Stopped: #{outcome.completed.size} of #{plan.groups.size} commit(s) made."
    puts "Commits #{failed}-#{plan.groups.size} were not made; their files keep their original staging."
    false
  end

  add_subcmd(:edit) { edit_files(__FILE__) }

  add_default do
    puts 'Usage: h-git <subcommand>'
    puts
    puts 'Subcommands:'
    puts '  ignore  Edit suggested patterns for untracked files, then add them to .gitignore'
    puts '  commit  Group dirty files into logical commits via claude sonnet'
    puts '          -n/--dry-run   show the plan without committing'
    puts '          -y/--yes       skip the confirmation prompt'
    puts '          -w/--whole-files  commit files that also have unstaged changes whole'
    puts '          -m/--model M   model to use (default: sonnet)'
  end
end
