#!/usr/bin/env ruby

require 'hiiro'

# Compatibility command: the legacy window name maps to a Herdr tab.
Hiiro.run(*ARGV, plugins: [Pins]) do
  herdr = herdr_client
  Hiiro::Herdr.add_resolvers(self)

  add_subcmd(:ls) { |*args|
    if args.empty?
      herdr.tabs(workspace: ENV['HERDR_WORKSPACE_ID']).each { |tab| puts tab }
    else
      system('herdr', 'tab', 'list', *args)
    end
  }

  add_subcmd(:lsa) { |*args|
    args.empty? ? herdr.tabs(all: true).each { |tab| puts tab } : system('herdr', 'tab', 'list', *args)
  }

  add_subcmd(:new) { |name = nil, cwd = nil|
    herdr.new_tab(name: name, start_directory: cwd, focus: true)
  }

  add_subcmd(:kill) { |target = nil|
    target = resolve(:window, target)
    herdr.close_tab(target) if target
  }

  add_subcmd(:rename) { |new_name, target = nil|
    target ||= herdr.current_tab&.id
    herdr.rename_tab(target, new_name) if target && new_name
  }

  add_subcmd(:select) { |target = nil|
    target = resolve(:window, target)
    print target if target
  }

  add_subcmd(:copy) { |target = nil|
    target = resolve(:window, target)
    if target
      Hiiro::Shell.pipe(target, 'pbcopy')
      puts "Copied tab '#{target}' to clipboard"
    end
  }

  add_subcmd(:sw, :switch) { |target = nil|
    target = resolve(:window, target)
    herdr.focus_tab(target) if target
  }

  add_subcmd(:next) { herdr.next_tab }
  add_subcmd(:prev) { herdr.previous_tab }
  add_subcmd(:last) { herdr.last_tab }

  add_subcmd(:info) { |target = nil|
    tab = target ? herdr.find_tab(target) : herdr.current_tab
    puts(tab || 'Tab not found')
  }
end
