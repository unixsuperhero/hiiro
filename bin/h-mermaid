#!/usr/bin/env ruby

require 'hiiro'

Hiiro.run do

  add_cmd :install do
    system('npm i -g @mermaid-js/mermaid-cli')
  end

  # FILE => FILE.png / FILE.svg next to it; arguments that are not files are skipped.
  %w[png svg].each do |ext|
    add_cmd ext.to_sym do
      opts.args.select { |f| File.file?(f) }.map do |f|
        system('mmdc', '-i', f, '-o', format('%s.%s', f, ext))
      end.all?
    end
  end
end
