#!/usr/bin/env ruby
# Review drift between this checkout and the installed assets: offer `nvim -d`
# for each differing file, then offer to apply the safe selection (missing and
# unmodified managed assets). User-modified and unowned files are never written.
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'hiiro'

def ask(prompt)
  print "#{prompt} (y/N): "
  File.open('/dev/tty') { |tty| tty.gets.to_s.strip.match?(/\Ay\z/i) }
end

plan = Hiiro::Install::Plan.build(prefix: 'h')
Hiiro::Install.print_plan(plan, $stdout)
plan.of('updatable', 'user-modified', 'collision').each do |entry|
  next unless entry.current.type == 'file'

  puts
  system('nvim', '-d', entry.destination, entry.path) if ask("#{entry.kind}: open #{Hiiro::Install.display(entry.destination)} in nvim -d?")
end

selected = plan.select(apply: true)
exit 0 if selected.empty?

puts
exit 0 unless ask("Apply #{selected.size} missing/updatable asset(s)?")
exit Hiiro::Install.report(plan.apply(selected), $stdout) ? 0 : 1
