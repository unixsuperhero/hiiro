#!/usr/bin/env ruby
# The drift plan for this checkout, then a diff of every installed asset whose
# bytes differ from it (installed copy first). Writes nothing.
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'hiiro'

plan = Hiiro::Install::Plan.build(prefix: 'h')
Hiiro::Install.print_plan(plan, $stdout)
plan.of('updatable', 'user-modified', 'collision').each do |entry|
  next unless entry.current.type == 'file'

  puts
  system('diff', '-u', entry.destination, entry.path)
end
